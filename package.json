{
  "name": "kvox",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm run build --workspace=cli && node apps/cli/dist/cli.js init",
    "api": "npm -w apps/api",
    "web": "npm -w apps/web",
    "api:dev": "npm -w apps/api run start:dev",
    "web:dev": "npm -w apps/web run dev",
    "api:test": "npm -w apps/api test",
    "web:test": "npm -w apps/web test",
    "openapi:dump": "npm run openapi:dump --workspace=api -- ../../openapi.json",
    "openapi:lint": "spectral lint openapi.json --ruleset .spectral.yaml --fail-severity=error",
    "build:packages": "node scripts/run-kvox-packages.mjs build",
    "typecheck:packages": "node scripts/run-kvox-packages.mjs typecheck",
    "test:packages": "node scripts/run-kvox-packages.mjs test:run",
    "lint:packages": "eslint --max-warnings=0 --no-error-on-unmatched-pattern \"packages/kvox-*/src/**/*.{ts,tsx}\"",
    "docs:packages": "node scripts/run-kvox-packages.mjs docs",
    "check:single-instance": "node scripts/check-single-instance.mjs",
    "check:platform-pin": "node scripts/check-platform-pin.mjs",
    "check:platform-imports": "eslint --max-warnings=0 \"apps/{api,web,cli}/src/**/*.{ts,tsx}\"",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build:packages && changeset publish"
  },
  "overrides": {
    "@marinoscar/platform-contract": "$@marinoscar/platform-contract",
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "deepmerge-ts": "^8.0.1",
    "glob": "^13.0.6",
    "magic-string": "^1.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@marinoscar/platform-contract": "0.1.0-next.5",
    "@stoplight/spectral-cli": "^6.16.3",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "typedoc": "^0.28.20",
    "typescript-eslint": "^8.71.2"
  }
}
