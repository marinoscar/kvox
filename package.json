{
  "name": "kvox",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm run build --workspace=cli && node apps/cli/dist/cli.js init",
    "api": "npm -w apps/api",
    "web": "npm -w apps/web",
    "api:dev": "npm -w apps/api run start:dev",
    "web:dev": "npm -w apps/web run dev",
    "api:test": "npm -w apps/api test",
    "web:test": "npm -w apps/web test",
    "openapi:dump": "npm run openapi:dump --workspace=api -- ../../openapi.json",
    "openapi:lint": "spectral lint openapi.json --ruleset .spectral.yaml --fail-severity=error",
    "build:kvox-packages": "npm run build -w @marinoscar/kvox-contract -w @marinoscar/kvox-db -w @marinoscar/kvox-api -w @marinoscar/kvox-ai -w @marinoscar/kvox-eval -w @marinoscar/kvox-web",
    "typecheck:kvox-packages": "npm run typecheck -w @marinoscar/kvox-contract -w @marinoscar/kvox-db -w @marinoscar/kvox-api -w @marinoscar/kvox-ai -w @marinoscar/kvox-eval -w @marinoscar/kvox-web",
    "test:kvox-packages": "npm run test:run -w @marinoscar/kvox-contract -w @marinoscar/kvox-db -w @marinoscar/kvox-api -w @marinoscar/kvox-ai -w @marinoscar/kvox-eval -w @marinoscar/kvox-web",
    "docs:kvox-packages": "npm run docs -w @marinoscar/kvox-contract -w @marinoscar/kvox-db -w @marinoscar/kvox-api -w @marinoscar/kvox-ai -w @marinoscar/kvox-eval -w @marinoscar/kvox-web",
    "test:kvox-scripts": "node --test \"scripts/kvox-packages/test/*.test.mjs\"",
    "check:kvox-slice-peers": "node scripts/kvox-packages/check-slice-peers.mjs && node scripts/kvox-packages/check-slice-peers.mjs --app apps/api --app apps/web",
    "check:kvox-package-docs": "npm run docs:kvox-packages && node scripts/kvox-packages/check-package-docs.mjs",
    "check:kvox-brand": "npm run brand:check -w @marinoscar/kvox-web && npm run brand:check -w web",
    "check:kvox-pack": "node scripts/kvox-packages/check-package-pack.mjs",
    "check:kvox-lean-install": "node scripts/kvox-packages/check-lean-install.mjs",
    "build:packages": "npm run build:kvox-packages",
    "typecheck:packages": "npm run typecheck:kvox-packages",
    "test:packages": "npm run test:kvox-packages && npm run test:kvox-scripts",
    "docs:packages": "npm run docs:kvox-packages",
    "lint:packages": "eslint --max-warnings=0 --no-error-on-unmatched-pattern \"packages/kvox-*/src/**/*.{ts,tsx}\"",
    "check:single-instance": "node scripts/check-single-instance.mjs",
    "check:platform-pin": "node scripts/check-platform-pin.mjs",
    "platform:infra:sync": "platform-infra sync",
    "check:platform-imports": "eslint --max-warnings=0 \"apps/{api,web,cli}/src/**/*.{ts,tsx}\"",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build:packages && changeset publish"
  },
  "overrides": {
    "@marinoscar/platform-contract": "$@marinoscar/platform-contract",
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "deepmerge-ts": "^8.0.1",
    "glob": "^13.0.6",
    "magic-string": "^1.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@marinoscar/platform-contract": "0.1.0-next.12",
    "@marinoscar/platform-infra": "0.1.0-next.12",
    "@stoplight/spectral-cli": "^6.17.0",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "typedoc": "^0.28.20",
    "typescript-eslint": "^8.72.0"
  }
}
