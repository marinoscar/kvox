# =============================================================================
# Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control
#
# NOTE: do not put a trailing `# comment` after a value. Docker Compose
# reads this file with `env_file:` and does not strip them, so the comment
# becomes part of the value. Put explanatory text on the line above.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3535

# Loopback port the stack binds to when deployed behind a shared host reverse
# proxy (infra/compose/vps.compose.yml). The proxy forwards to
# 127.0.0.1:<APP_BIND_PORT>; nothing outside the server reaches it directly.
# Must be unique per application when several share one VPS.
# Unused by the dev and prod overlays, which publish 3535 directly.
APP_BIND_PORT=3535

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# External database connection (DATABASE_URL is constructed from these at runtime)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb
POSTGRES_SSL=false

# -----------------------------------------------------------------------------
# JWT / Session
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a strong secret for production (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-min-32-characters-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
COOKIE_SECRET=your-cookie-secret-key-min-32-characters-long

# -----------------------------------------------------------------------------
# Credential Encryption
# -----------------------------------------------------------------------------
# Encrypts secrets an administrator configures at runtime through the app
# (e.g. an SMTP password) before they are stored in the database. This is
# separate from the deploy-time secrets above (JWT_SECRET, GOOGLE_CLIENT_SECRET,
# etc.), which are unaffected by this variable and are not encrypted with it.
#
# Optional until a credential is actually stored: if unset, the app boots
# normally with a warning and only fails when something tries to save a
# credential. It becomes mandatory (boot fails) the moment any encrypted
# credential exists in the database and this key is missing or wrong.
# See: docs/runbooks/rotate-secrets-encryption-key.md
#
# IMPORTANT: Generate a strong key for production
# Example: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# OAuth - Google (Required)
# -----------------------------------------------------------------------------
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3535/api/auth/google/callback

# -----------------------------------------------------------------------------
# OAuth - Microsoft (Optional)
# -----------------------------------------------------------------------------
# Get credentials from: https://portal.azure.com
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_CALLBACK_URL=http://localhost:3535/api/auth/microsoft/callback

# -----------------------------------------------------------------------------
# Web Push (Optional)
# -----------------------------------------------------------------------------
# Generate a key pair with `npx web-push generate-vapid-keys` to enable Web
# Push (issue #229). Leave unset and this deployment simply has push
# subscriptions disabled — GET /api/notifications/config reports
# pushEnabled: false and no browser is ever asked to subscribe.
# A full setup runbook lands separately in issue #233.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# -----------------------------------------------------------------------------
# Initial Admin Bootstrap
# -----------------------------------------------------------------------------
# First user to log in with this email will be assigned Admin role
INITIAL_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Test Authentication (Development/Test Only)
# -----------------------------------------------------------------------------
# Test auth is automatically enabled when NODE_ENV !== 'production'
# This provides /api/auth/test/login endpoint and /testing/login page
# for Playwright E2E testing without requiring real OAuth credentials.
#
# Set to 'false' to explicitly disable test auth in development:
# TEST_AUTH_ENABLED=false
#
# WARNING: Setting TEST_AUTH_ENABLED=true in production will cause the app
# to fail at startup as a safety measure.

# -----------------------------------------------------------------------------
# Device Authorization Flow (RFC 8628)
# -----------------------------------------------------------------------------
# Configuration for device authorization (CLI, Swagger UI, mobile apps)
DEVICE_CODE_EXPIRY_MINUTES=15
DEVICE_CODE_POLL_INTERVAL=5
# Lifetime of access and refresh tokens issued by the device flow (default: 7 days)
DEVICE_TOKEN_EXPIRY_DAYS=7
# Lifetime of the personal access token minted when a device requests
# clientInfo.tokenType: "pat" (how the CLI logs in). Longer than the session
# credential above because a PAT is revocable server-side from the Access
# Tokens page, while the JWT above cannot be revoked before it expires.
# Values outside 1-999 are rejected and fall back to the default (default: 90 days)
DEVICE_PAT_EXPIRY_DAYS=90

# -----------------------------------------------------------------------------
# Maintenance mode (break-glass override)
# -----------------------------------------------------------------------------
# Maintenance mode is normally turned on and off through the application
# (PUT /api/admin/maintenance, or the admin UI), and that setting is stored in
# the database so it survives the very restart it was enabled for. This
# variable is the BREAK-GLASS that overrides the stored setting in BOTH
# directions, and it wins over everything else:
#
#   Set to 'true'   Force the window OPEN. Use when the database cannot be
#                   read (so the stored flag is unreachable) or when traffic
#                   must be stopped before the app is even up.
#   Set to 'false'  Force the window SHUT. This is the documented recovery
#                   from a window opened with allowAdmins false, which locks
#                   administrators out of the very endpoint that would turn
#                   it off.
#
# Only the literal strings 'true' and 'false' count. Anything else — including
# unset, '1', 'yes' or 'off' — means "no override, use the stored setting",
# which is why this line stays commented out by default. Changing it requires
# an application restart to take effect.
#
# NOTE ON FORMAT: the two lines above deliberately say "set to 'true'"
# rather than spelling out an assignment. `parseEnvExample` in apps/cli reads
# any commented `KEY=value` line as a declaration of an optional variable, so
# an illustrative assignment inside prose registers as a SECOND declaration
# of this key and fails the CLI's env-spec test. Prose about a variable must
# not look like an assignment to it.
#
# See docs/runbooks/maintenance-mode.md.
# MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=my-app-api
LOG_LEVEL=info
# Uncomment to enable OTEL diagnostic logging (development only)
# OTEL_DEBUG=true

# -----------------------------------------------------------------------------
# Uptrace (when using docker-compose.otel.yml)
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Uptrace credentials
# -----------------------------------------------------------------------------
# These were previously hardcoded in infra/otel/uptrace.yml and
# infra/otel/otel-collector-config.yaml. They are development defaults only —
# CHANGE THEM before exposing the observability stack anywhere non-local.
UPTRACE_PROJECT1_TOKEN=project1_secret_token
UPTRACE_SECRET_KEY=change-me-in-production-1234567890abcdef
UPTRACE_ADMIN_EMAIL=admin@localhost
UPTRACE_ADMIN_PASSWORD=admin
UPTRACE_PGPASSWORD=uptrace
# Where the Uptrace UI is reached. 2.x uses this for dashboard links and CORS.
UPTRACE_SITE_URL=http://localhost:14318
# Optional. Uptrace 2.x requires Redis; the bundled instance needs no auth.
# UPTRACE_REDIS_PASSWORD=
# Optional. The bundled ClickHouse runs with the default user and no password.
# UPTRACE_CH_USER=default
# UPTRACE_CH_PASSWORD=

UPTRACE_DSN=http://project1_secret_token@localhost:14317/1

# -----------------------------------------------------------------------------
# ClickHouse (Uptrace storage - typically no changes needed)
# -----------------------------------------------------------------------------
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# Storage provider (currently only 's3' is supported)
STORAGE_PROVIDER=s3

# S3 Storage Settings
# For AWS S3: Set region and credentials, leave S3_ENDPOINT empty
# For MinIO/LocalStack: Set S3_ENDPOINT to your local service URL
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: for MinIO/LocalStack
# S3_ENDPOINT=http://localhost:9000

# Storage Limits and Configuration
# 10GB in bytes
MAX_FILE_SIZE=10737418240
ALLOWED_MIME_TYPES=image/*,application/pdf,video/*
# Signed URL expiration in seconds (1 hour)
SIGNED_URL_EXPIRY=3600
# Multipart upload part size in bytes (10MB)
STORAGE_PART_SIZE=10485760

# -----------------------------------------------------------------------------
# Background Job Queue
# -----------------------------------------------------------------------------
# Retry and rate-limit behaviour for the background job queue. Two INDEPENDENT
# budgets: the attempts budget bounds bugs (a handler that keeps throwing),
# the rate-limit budget bounds waiting (a provider throttling us). A provider
# rate limit deliberately does NOT consume an attempt, so a long backfill
# cannot fail permanently just because a provider was busy.

# How many attempts a job gets before it is permanently marked failed.
# Counted at CLAIM time, so it also bounds a job that kills its worker.
JOBS_MAX_ATTEMPTS=3
# Ordinary retry backoff, in milliseconds: the delay before attempt 2, then
# doubling per attempt, capped at the max. Equal jitter is applied on top, so
# the real delay lands between half the value and the value itself.
JOBS_RETRY_BASE_MS=2000
JOBS_RETRY_MAX_MS=60000

# How many times a single job may be deferred by a provider rate limit before
# it gives up. Tracked separately from JOBS_MAX_ATTEMPTS above and much
# larger, because waiting out a provider is not the same as failing.
JOBS_RATELIMIT_MAX_HITS=10
# Rate-limit deferral backoff, in milliseconds (same doubling and jitter as
# the retry pair above, on a much longer timescale: 30s up to 15 minutes).
# The max also caps how long a job will hold a worker slot waiting on the
# per-provider cooldown gate.
JOBS_RATELIMIT_BASE_MS=30000
JOBS_RATELIMIT_MAX_MS=900000

# How many jobs this process may run at the same time. Each slot is an
# independent loop that claims one job, runs it, and claims again, so a slow
# job stalls only its own slot. Fixed at startup; the pool is never resized.
# Raise it for lots of waiting-on-the-network work, lower it for work that
# competes with request handling for CPU.
JOBS_WORKER_CONCURRENCY=2
# How long an idle slot waits, in milliseconds, before asking for work again.
# Only an EMPTY queue waits: a slot that just finished a job claims the next
# one immediately, so this is the latency of the first job after a quiet
# period, not a throughput limit.
JOBS_POLL_MS=5000
# Which jobs this process is willing to claim. One of:
#   all     - every registered job type. The default, and the right answer for
#             a single-server deployment: there is nowhere else for the work
#             to run.
#   system  - only the types that can never run on a remote worker node,
#             leaving node-eligible work to the fleet. The recommended setting
#             once worker nodes exist.
#   off     - claim nothing. This process still enqueues jobs and serves the
#             queue API, but executes none of them.
# An unrecognised value logs one warning and behaves as all, so a typo cannot
# silently stop every background job in the deployment.
JOBS_WORKER_MODE=all
# How long one job may run, in milliseconds, before it is treated as failed
# and its slot is freed. The job then retries or fails on its normal budget.
# JavaScript cannot cancel work in progress, so the abandoned run is left to
# finish in the background - keep handlers interruptible where it matters.
# Set to 0 to disable per-job timeouts entirely.
JOBS_JOB_TIMEOUT_MS=600000
# Extra job types the system worker mode should claim anyway, comma-separated
# (for example: report.build,image.render). The escape hatch for a
# node-eligible type this deployment still wants the server to run, because
# its node fleet is small, paused, or does not handle that type. Overlap with
# the fleet is safe - the claim is atomic, so only one side ever gets a given
# job. Types no handler in this process registers are ignored with a warning.
# Leave unset unless the system mode above is in use.
# Not needed to keep any type running: system mode claims everything no node
# may claim HERE, RIGHT NOW - including a node-eligible type whose deployment
# gates are closed (db.backup.run with node offload off, say). This list is for
# deliberately running a type the fleet is allowed to run, on the server too.
# JOBS_SYSTEM_MODE_EXTRA_TYPES=
# Whether this process reclaims jobs abandoned by an executor that died
# holding them - a killed replica, or a worker node that went away mid-job.
# Deliberately independent of the worker mode above: reclaiming is a control
# plane duty, so an API that claims nothing still reaps for its fleet, which
# is the deployment where abandoned jobs are most likely. Turn it off (with
# the value false) only when several API replicas share one database and you
# want exactly one of them sweeping; running it everywhere is safe, just
# duplicated work. Anything other than false leaves it on, so a typo cannot
# silently strand every abandoned job.
JOBS_REAPER_ENABLED=true

# -----------------------------------------------------------------------------
# Worker Node Fleet
# -----------------------------------------------------------------------------
# Whether this process marks a worker node offline once it stops heartbeating.
# A node that crashes, is OOM-killed or loses the network never deregisters
# itself, so without this sweep its row reads online forever - a green chip
# above a three-week-old heartbeat. Runs every ten minutes and compares each
# node's last heartbeat against the nodes.staleHeartbeatSeconds system setting
# multiplied by nodes.offlineStaleMultiplier; nodes an administrator disabled
# are never touched. Turn it off (with the value false) only when several API
# replicas share one database and you want exactly one of them sweeping;
# running it everywhere is safe, just duplicated work. Anything other than
# false leaves it on, so a typo cannot silently strand a dead fleet at online.
NODE_STALE_OFFLINE_ENABLED=true
# Whether this process forgets offline worker nodes once they are past the
# nodes.offlineRetentionDays system setting. Runs daily, and deletes only the
# node record: its jobs are kept, with their claimed-by pointer nulled, and a
# node still holding a running job is skipped until that job settles. This
# depends on the sweep above - it selects offline rows, and a crashed node
# only reaches that status because the sweep put it there - so turning the
# sweep off turns retention off as well, whatever this is set to. Same
# fail-open rule: anything other than false leaves it on.
NODE_OFFLINE_PRUNE_ENABLED=true
# Whether this process revokes per-job credentials a worker node was handed and
# nothing else cleaned up. Runs every ten minutes and destroys any grant whose
# job is no longer held by the node it was minted for. This is NOT duplication
# of the fast path that revokes as soon as a job settles: that path emits
# nothing for a job the lease reaper reclaimed, nothing when an API replica
# dies between settling and revoking, and nothing when the terminal write
# itself failed - all three being cases where a credential is more likely than
# average to still be outstanding. Without this sweep those grants live until
# their own expiry and their roles are never dropped. Note it does not decide
# whether credentials may be issued at all: that is the
# nodes.jobSecretBrokerEnabled system setting, off by default, edited in the
# application. Same fail-open rule as the two above: anything other than false
# leaves it on.
NODE_SECRET_SWEEP_ENABLED=true

# -----------------------------------------------------------------------------
# Database Backup
# -----------------------------------------------------------------------------
# Whether this process runs the database backup scheduler. It ticks every ten
# minutes and does two things: it gives up on a backup whose heartbeat stopped
# for longer than the databaseBackup.runStaleMinutes system setting (freeing
# the single-active-run slot a crashed container would otherwise hold forever),
# and it starts a backup when the schedule an administrator configured has come
# due and nothing has covered that window yet. Everything about the schedule
# itself - whether backups are enabled at all, the frequency, the time of day,
# the timezone, how many to keep - is a system setting edited in the
# application, not an environment variable; this switch only decides whether
# this process is one of the ones checking. Deliberately independent of the job
# worker mode: a backup is not queue work, and an API running as a pure control
# plane in front of a worker fleet is still the only component with a database
# connection. Turn it off (with the value false) only when several API replicas
# share one database and you want exactly one of them scheduling; running it
# everywhere is safe, just duplicated work. Anything other than false leaves it
# on, because a deployment whose backups silently stopped looks exactly like
# one that is being backed up, right up until somebody needs a restore.
DB_BACKUP_SCHEDULE_ENABLED=true
