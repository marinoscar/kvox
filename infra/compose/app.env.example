# -----------------------------------------------------------------------------
# App variables
# -----------------------------------------------------------------------------
# Variables of this application only, appended to infra/compose/.env.example
# after the platform's by `platform-infra sync` (this file is APP-OWNED: it is
# created once and never overwritten; .env.example itself is generated). Add a
# variable here as KEY=value with its explanation on the lines above it, then
# run the sync. Never add a commented-out KEY=value line: the deploy wizard
# reads every such line as a declared variable.

# Container memory limits applied by the production and VPS overlay
# (app.prod.memory-limits.compose.yml), as a Docker size: 512M, 1G. The
# defaults equal prod.compose.yml's fixed limits, so raising them is an
# operator's choice: 1G from 4 GiB of RAM and 2G from 8 GiB suit the API, 256M
# the web container on a busy host. Unused by the dev overlays.
API_MEM_LIMIT=512M
WEB_MEM_LIMIT=128M

# Whether this process runs the hourly knowledge graph migration scheduler. When
# a release reshapes the ontology (a retired type retagged, an attribute
# renamed), the rows already stored under the old shape are reshaped by a queue
# job per user; this tick only finds the users who still have such rows and
# queues their jobs, and it does nothing at all while the release declares no
# migration. Leave it on; set it to the value false only to keep one replica of
# several doing the scheduling. Anything other than false leaves it on. An
# administrator can always re-run one user's migration with Retry in the job
# list. See docs/runbooks/ontology-migration.md.
KG_MIGRATE_SCHEDULE_ENABLED=true
