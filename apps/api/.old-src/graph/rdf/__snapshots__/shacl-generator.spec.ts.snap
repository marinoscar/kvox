// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`generateShacl parses with n3 and matches the snapshot 1`] = `
"@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix kv: <https://fixture.app/ns#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kv:AssertionShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label kv:reviewStatus kv:confidence kv:ontologyVersion ) ;
    sh:or ( [ sh:not [ sh:hasValue kv:HAS_ROLE ; sh:path rdf:predicate ] ] [ sh:minCount 1 ; sh:path kv:HAS_ROLE.title ] ) ;
    sh:property [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:path prov:endedAtTime
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:path prov:startedAtTime
    ], [
        sh:datatype xsd:string ;
        sh:in ( "day" "month" "year" "unknown" ) ;
        sh:maxCount 1 ;
        sh:path kv:validPrecision
    ], [
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Business unit" ;
        sh:path kv:HAS_ROLE.businessUnit
    ], [
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Role" ;
        sh:path kv:HAS_ROLE.title
    ], [
        sh:in ( kv:ATTENDED kv:DISCUSSED kv:FRIEND_OF kv:HAS_MILESTONE kv:HAS_ROLE kv:INTERESTED_IN kv:PARENT_OF kv:PART_OF kv:REPORTS_TO kv:SPOUSE_OF kv:TRAVELED_ON kv:WORKS_FOR ) ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:path rdf:predicate
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path rdf:object
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path rdf:subject
    ], [
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path prov:wasDerivedFrom
    ] ;
    sh:targetClass kv:Assertion .

kv:ClaimShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label kv:reviewStatus kv:confidence kv:ontologyVersion prov:wasDerivedFrom prov:wasRevisionOf ) ;
    sh:property [
        sh:class kv:Claim ;
        sh:name "Supersedes" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:SUPERSEDES
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Due at" ;
        sh:path kv:dueAt
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Occurred at" ;
        sh:path kv:occurredAt
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Valid from" ;
        sh:path prov:startedAtTime
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Valid until" ;
        sh:path prov:endedAtTime
    ], [
        sh:datatype xsd:string ;
        sh:in ( "active" "superseded" ) ;
        sh:maxCount 1 ;
        sh:name "Status" ;
        sh:path kv:status
    ], [
        sh:datatype xsd:string ;
        sh:in ( "day" "month" "year" "unknown" ) ;
        sh:maxCount 1 ;
        sh:path kv:validPrecision
    ], [
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "Statement" ;
        sh:path kv:Claim.statement
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "About" ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class kv:Interest ] [ sh:class kv:Meeting ] [ sh:class kv:Milestone ] [ sh:class kv:Organization ] [ sh:class kv:Person ] [ sh:class kv:Project ] [ sh:class kv:Trip ] ) ;
        sh:path kv:ABOUT
    ], [
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path prov:wasDerivedFrom
    ] ;
    sh:targetClass kv:Claim .

kv:CommitmentShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label kv:reviewStatus kv:confidence kv:ontologyVersion prov:wasDerivedFrom prov:wasRevisionOf ) ;
    sh:property [
        sh:class kv:Commitment ;
        sh:name "Supersedes" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:SUPERSEDES
    ], [
        sh:class kv:Meeting ;
        sh:maxCount 1 ;
        sh:name "Created in" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:CREATED_IN
    ], [
        sh:class kv:Person ;
        sh:maxCount 1 ;
        sh:name "Assigned to" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:ASSIGNED_TO
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Due at" ;
        sh:path kv:dueAt
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Occurred at" ;
        sh:path kv:occurredAt
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Valid from" ;
        sh:path prov:startedAtTime
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Valid until" ;
        sh:path prov:endedAtTime
    ], [
        sh:datatype xsd:string ;
        sh:in ( "day" "month" "year" "unknown" ) ;
        sh:maxCount 1 ;
        sh:path kv:validPrecision
    ], [
        sh:datatype xsd:string ;
        sh:in ( "open" "done" "dropped" "superseded" ) ;
        sh:maxCount 1 ;
        sh:name "Status" ;
        sh:path kv:status
    ], [
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "Statement" ;
        sh:path kv:Commitment.statement
    ], [
        sh:maxCount 1 ;
        sh:name "About" ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class kv:Organization ] [ sh:class kv:Person ] [ sh:class kv:Project ] ) ;
        sh:path kv:ABOUT
    ], [
        sh:maxCount 1 ;
        sh:name "Owed to" ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class kv:Organization ] [ sh:class kv:Person ] ) ;
        sh:path kv:OWED_TO
    ], [
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path prov:wasDerivedFrom
    ] ;
    sh:targetClass kv:Commitment .

kv:DecisionShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label kv:reviewStatus kv:confidence kv:ontologyVersion prov:wasDerivedFrom prov:wasRevisionOf ) ;
    sh:property [
        sh:class kv:Decision ;
        sh:name "Supersedes" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:SUPERSEDES
    ], [
        sh:class kv:Meeting ;
        sh:maxCount 1 ;
        sh:name "Decided in" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:DECIDED_IN
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Due at" ;
        sh:path kv:dueAt
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Occurred at" ;
        sh:path kv:occurredAt
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Valid from" ;
        sh:path prov:startedAtTime
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Valid until" ;
        sh:path prov:endedAtTime
    ], [
        sh:datatype xsd:string ;
        sh:in ( "active" "superseded" ) ;
        sh:maxCount 1 ;
        sh:name "Status" ;
        sh:path kv:status
    ], [
        sh:datatype xsd:string ;
        sh:in ( "day" "month" "year" "unknown" ) ;
        sh:maxCount 1 ;
        sh:path kv:validPrecision
    ], [
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "Statement" ;
        sh:path kv:Decision.statement
    ], [
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Rejected option" ;
        sh:path kv:Decision.rejectedOption
    ], [
        sh:maxCount 1 ;
        sh:name "About" ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class kv:Organization ] [ sh:class kv:Person ] [ sh:class kv:Project ] ) ;
        sh:path kv:ABOUT
    ], [
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path prov:wasDerivedFrom
    ] ;
    sh:targetClass kv:Decision .

kv:InterestShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label kv:reviewStatus kv:confidence kv:ontologyVersion prov:wasDerivedFrom ) ;
    sh:property [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Occurred at" ;
        sh:path kv:occurredAt
    ], [
        sh:datatype xsd:string ;
        sh:in ( "hobby" "sport" "music" "food" "travel" "cause" "other" ) ;
        sh:maxCount 1 ;
        sh:name "Category" ;
        sh:path kv:Interest.category
    ], [
        sh:datatype xsd:string ;
        sh:name "Alias" ;
        sh:path skos:altLabel
    ], [
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path prov:wasDerivedFrom
    ] ;
    sh:targetClass kv:Interest .

kv:MeetingShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label kv:reviewStatus kv:confidence kv:ontologyVersion prov:wasDerivedFrom ) ;
    sh:property [
        sh:class kv:Project ;
        sh:name "Discussed" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:DISCUSSED
    ], [
        sh:class kv:Project ;
        sh:name "Part of" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:PART_OF
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Occurred at" ;
        sh:path kv:occurredAt
    ], [
        sh:datatype xsd:string ;
        sh:in ( "stated" "note_created_at" ) ;
        sh:maxCount 1 ;
        sh:name "Date source" ;
        sh:path kv:Meeting.dateSource
    ], [
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Note" ;
        sh:path kv:Meeting.noteId
    ], [
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Transcript" ;
        sh:path kv:Meeting.transcriptId
    ], [
        sh:datatype xsd:string ;
        sh:name "Alias" ;
        sh:path skos:altLabel
    ], [
        sh:datatype xsd:string ;
        sh:name "Topics" ;
        sh:path kv:Meeting.topics
    ], [
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path prov:wasDerivedFrom
    ] ;
    sh:targetClass kv:Meeting .

kv:MilestoneShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label kv:reviewStatus kv:confidence kv:ontologyVersion prov:wasDerivedFrom ) ;
    sh:property [
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:name "Date" ;
        sh:path kv:Milestone.date
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Occurred at" ;
        sh:path kv:occurredAt
    ], [
        sh:datatype xsd:string ;
        sh:in ( "birthday" "anniversary" "wedding" "birth" "graduation" "move" "retirement" "other" ) ;
        sh:maxCount 1 ;
        sh:name "Kind" ;
        sh:path kv:Milestone.kind
    ], [
        sh:datatype xsd:string ;
        sh:name "Alias" ;
        sh:path skos:altLabel
    ], [
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path prov:wasDerivedFrom
    ] ;
    sh:targetClass kv:Milestone .

kv:OrganizationShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label kv:reviewStatus kv:confidence kv:ontologyVersion prov:wasDerivedFrom ) ;
    sh:property [
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
        sh:name "Website" ;
        sh:path schema:url ;
        sh:pattern "^https?://"
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Occurred at" ;
        sh:path kv:occurredAt
    ], [
        sh:datatype xsd:string ;
        sh:in ( "gold" "silver" ) ;
        sh:maxCount 1 ;
        sh:name "Tier" ;
        sh:path <https://fixture.app/ns#attr/11111111-1111-4111-8111-111111111111>
    ], [
        sh:datatype xsd:string ;
        sh:name "Alias" ;
        sh:path skos:altLabel
    ], [
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path prov:wasDerivedFrom
    ] ;
    sh:targetClass kv:Organization .

kv:PersonFactShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label kv:reviewStatus kv:confidence kv:ontologyVersion prov:wasDerivedFrom ) ;
    sh:property [
        sh:class kv:Person ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "About" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:ABOUT
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Due at" ;
        sh:path kv:dueAt
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Occurred at" ;
        sh:path kv:occurredAt
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Valid from" ;
        sh:path prov:startedAtTime
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Valid until" ;
        sh:path prov:endedAtTime
    ], [
        sh:datatype xsd:string ;
        sh:in ( "active" "superseded" ) ;
        sh:maxCount 1 ;
        sh:name "Status" ;
        sh:path kv:status
    ], [
        sh:datatype xsd:string ;
        sh:in ( "day" "month" "year" "unknown" ) ;
        sh:maxCount 1 ;
        sh:path kv:validPrecision
    ], [
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "Statement" ;
        sh:path kv:PersonFact.statement
    ], [
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path prov:wasDerivedFrom
    ] ;
    sh:targetClass kv:PersonFact .

kv:PersonShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label kv:reviewStatus kv:confidence kv:ontologyVersion prov:wasDerivedFrom foaf:knows foaf:topic_interest schema:attendee schema:children schema:hasOccupation schema:spouse schema:worksFor ) ;
    sh:property [
        sh:class kv:Interest ;
        sh:name "Interested in" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:INTERESTED_IN
    ], [
        sh:class kv:Meeting ;
        sh:name "Attended" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:ATTENDED
    ], [
        sh:class kv:Milestone ;
        sh:name "Has milestone" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:HAS_MILESTONE
    ], [
        sh:class kv:Organization ;
        sh:name "Has role" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:HAS_ROLE
    ], [
        sh:class kv:Organization ;
        sh:name "Works for" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:WORKS_FOR
    ], [
        sh:class kv:Person ;
        sh:name "Friend of" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:FRIEND_OF
    ], [
        sh:class kv:Person ;
        sh:name "Parent of" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:PARENT_OF
    ], [
        sh:class kv:Person ;
        sh:name "Reports to" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:REPORTS_TO
    ], [
        sh:class kv:Person ;
        sh:name "Spouse of" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:SPOUSE_OF
    ], [
        sh:class kv:Trip ;
        sh:name "Traveled on" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:TRAVELED_ON
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Occurred at" ;
        sh:path kv:occurredAt
    ], [
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Job title" ;
        sh:path schema:jobTitle
    ], [
        sh:datatype xsd:string ;
        sh:name "Alias" ;
        sh:path skos:altLabel
    ], [
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path prov:wasDerivedFrom
    ] ;
    sh:targetClass kv:Person .

kv:ProjectShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label kv:reviewStatus kv:confidence kv:ontologyVersion prov:wasDerivedFrom ) ;
    sh:property [
        sh:class kv:Organization ;
        sh:name "Part of" ;
        sh:nodeKind sh:IRI ;
        sh:path kv:PART_OF
    ], [
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:name "End date" ;
        sh:path kv:Project.endDate
    ], [
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:name "Start date" ;
        sh:path kv:Project.startDate
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Occurred at" ;
        sh:path kv:occurredAt
    ], [
        sh:datatype xsd:string ;
        sh:in ( "planned" "active" "done" "cancelled" ) ;
        sh:maxCount 1 ;
        sh:name "Status" ;
        sh:path kv:Project.status
    ], [
        sh:datatype xsd:string ;
        sh:name "Alias" ;
        sh:path skos:altLabel
    ], [
        sh:maxCount 1 ;
        sh:name "Sponsor" ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class kv:Organization ] [ sh:class kv:Person ] ) ;
        sh:path <https://fixture.app/ns#attr/55555555-5555-4555-8555-555555555555>
    ], [
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path prov:wasDerivedFrom
    ] ;
    sh:targetClass kv:Project .

kv:TripShape
    a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label kv:reviewStatus kv:confidence kv:ontologyVersion prov:wasDerivedFrom ) ;
    sh:property [
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:name "End date" ;
        sh:path kv:Trip.endDate
    ], [
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:name "Start date" ;
        sh:path kv:Trip.startDate
    ], [
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:name "Occurred at" ;
        sh:path kv:occurredAt
    ], [
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Destination" ;
        sh:path kv:Trip.destination
    ], [
        sh:datatype xsd:string ;
        sh:name "Alias" ;
        sh:path skos:altLabel
    ], [
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path prov:wasDerivedFrom
    ] ;
    sh:targetClass kv:Trip .
"
`;
