  "contextText": "Sarah wants to walk us through changes in the Northwind engineering org.",
  "hasTranscript": true,
  "speakers": [
    {
      "id": "m09-spk-a",
      "label": "A",
      "displayName": "Alex Rivera"
    },
    {
      "id": "m09-spk-b",
      "label": "B",
      "displayName": "Sarah Chen"
    },
    {
      "id": "m09-spk-c",
      "label": "C",
      "displayName": "Tomás Aguilar"
    },
    {
      "id": "m09-spk-d",
