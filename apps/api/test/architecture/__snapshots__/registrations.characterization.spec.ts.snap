      ],
      "defaultEnabled": true,
      "mandatory": true
    },
    {
      "key": "jobs.job_failed",
      "label": "Background job failed",
      "description": "Sent when a background job exhausts its retry budget and is given up on. Retries and deferrals are silent; only the final give-up raises this.",
