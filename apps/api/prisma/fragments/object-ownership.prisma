// =============================================================================
// Storage object ownership (issue #469, epic #467)
// =============================================================================
//
// The platform's `storage_objects` table has no notion of which app module
// owns an object. Until #469 the app added two columns to it (`managed_by`,
// `part_size`), declared as the temporary deviation
// `kvox:storage-managed-by-part-size`. This side table replaces `managed_by`;
// `part_size` is dropped (the part size is now the platform's deployment-wide
// `storage.partSize` setting).
//
// A row means "this object belongs to an app module (transcripts, notes or
// graph)": the generic object list hides it (`GET /api/kvox/files`) and the
// generic `DELETE` answers 409. An object with no row is a plain upload.
//
// COMPOSITE FOREIGN KEY (object_id, org_id) -> storage_objects (id, org_id).
// `storage_objects` is an org table with forced row-level security, and a
// foreign-key check bypasses RLS, so the platform requires a link into an org
// table to carry the org id and to reference the table's (id, org_id) unique
// key. `org_id` is therefore a reference here, not an isolation column: this
// table has no RLS policy of its own.
//
// Model ownership: `system` with `orgReference: 'orgId'` ("ownership marker for
// a storage object; org id is a reference for the composite key").
model KvoxObjectOwnership {
  objectId  String   @id @map("object_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  // 'transcripts' | 'notes' | 'graph'
  managedBy String   @map("managed_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  object StorageObject @relation(fields: [objectId, orgId], references: [id, orgId], onDelete: Cascade)

  // Redundant with the primary key on object_id (an object has at most one
  // owner), but Prisma requires a unique on the relation's fields to accept the
  // one-to-one back-relation `StorageObject.kvoxOwnership`.
  @@unique([objectId, orgId])
  @@index([managedBy])
  @@map("kvox_object_ownership")
}

// Back-relation onto the platform's StorageObject (an `extend model` block holds back-relation fields only).
extend model StorageObject {
  kvoxOwnership KvoxObjectOwnership?
}
