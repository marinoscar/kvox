  // Picks the default active organization at login (PP-6.4).
  lastActiveAt DateTime?        @map("last_active_at") @db.Timestamptz
  // The member's org-scoped role (PP-6.3). `Restrict`: a role in use cannot be
  // deleted out from under its members.
  roleId       String           @map("role_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([orgId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

model Invite {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  // Stored lower-cased.
  email        String
  status       InviteStatus @default(pending)
  // sha256 of an emailed accept token, if one is used.
  tokenHash    String?      @unique @map("token_hash")
  expiresAt    DateTime?    @map("expires_at") @db.Timestamptz
  invitedById  String?      @map("invited_by_id") @db.Uuid
  acceptedById String?      @map("accepted_by_id") @db.Uuid
  acceptedAt   DateTime?    @map("accepted_at") @db.Timestamptz
  notes        String?
  // The org role the invitee gets on acceptance (PP-6.3). NULL means the
  // default org role (`viewer`). `Restrict`, as on `Membership.roleId`.
  roleId       String?      @map("role_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role       Role?        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy  User?        @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?        @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  // Re-inviting updates the row.
  @@unique([orgId, email])
  @@index([email])
  @@index([roleId])
  @@map("org_invites")
}
