  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // One row per (provider, model) pair, ever — a discovery sync upserts on
  // this rather than inserting duplicates on every re-run.
  @@unique([provider, modelId])
  // "Which models may this deployment currently offer" — the catalog read
  // every AI-calling path needs, filtered to the provider in play.
  @@index([provider, enabled])
  @@map("ai_models")
}

// BYOK ("bring your own key"): one encrypted provider key per (user,
// provider), never per deployment. See the block comment above this section
// for why `user` is `Cascade` here and NOT `SetNull` like `Credential
// .updatedByUser` or `AiModel.updatedByUser` above — this key has exactly one
// owner and no meaning to anyone else once that owner's account is gone.
model UserAiKey {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Which provider this key authenticates against, e.g. `'openai'`. Plain
  // string for the same forward-compatibility reason `AiModel.provider` is.
  provider String

  // Ciphertext ONLY — `encryptSecret(plaintext, 'ai_user_key')`. See the
  // block comment above this section (and `Credential.secret`'s own comment)
  // for the full argument; @db.Text for the identical reason
  // `Credential.secret` is: an AES-GCM payload has no meaningful length
  // bound, so it must never be truncated.
  secret String @db.Text

  // Non-secret display aid (`'••••' + last 4`), mirroring `Credential.hint`.
  // Nullable: a key can exist before anyone has decided how to hint it.
  hint String?

  // The last time this key was proven to work against its provider (a live
  // probe call, not merely "was saved"). Nullable: never verified yet.
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz
  // The provider's own error code from the most recent failed verification or
  // use, so a user who cannot see why a key stopped working has somewhere to
  // look. Nullable: no failure recorded (yet, or ever).
  lastErrorCode String?   @map("last_error_code")

  // Which of this provider's models this specific key was actually able to
  // reach on its last verification, as opposed to `AiModel.enabled`, which is
  // a DEPLOYMENT-WIDE policy decision independent of any one key. A key with
  // a narrower API scope, or one hitting a provider-side allowlist, can
  // legitimately reach fewer models than the deployment otherwise offers.
  reachableModelIds  String[]  @default([]) @map("reachable_model_ids")
  reachableCheckedAt DateTime? @map("reachable_checked_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  //
  // Cascade — see the block comment above this section for why this
  // deliberately reverses `Credential.updatedByUser`'s `SetNull`.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One key per (user, provider) — saving a new key for a provider replaces
  // the old one rather than accumulating a history of them.
  @@unique([userId, provider])
  @@map("user_ai_keys")
}

// One row per AI call this platform ever ran through the background queue —
// the record `#432`'s job handler(s) read from and write progress/output to.
// This issue is schema only, matching every other table in this section: no
// enqueue path, no job handler and no controller exists yet.
// @extensible — back-relations only, added with "extend model AiRun { ... }" in a fragment
// (an app's own annotation of a run, for example a review verdict). The table is org-owned
// with row-level security forced, so a table of the app's that holds `org_id` links to a run
// with a composite foreign key `(ai_run_id, org_id)` -> `ai_runs (id, org_id)`; the
// `@@unique([id, orgId])` below exists for it.
model AiRun {
  id String @id @default(uuid()) @db.Uuid

  // Nullable, deliberately — see the block comment above this section for why
  // this is `SetNull` rather than `Cascade`, and why a run may have no
  // requesting user at all (a system-initiated run, mirroring `Job.subjectType`
  // /`subjectId` both being null together for a global job).
  userId String? @map("user_id") @db.Uuid

  // The `jobs` row this run executes under, when it runs through the queue at
  // all. Nullable, and deliberately NOT a foreign key — mirrors
  // `DatabaseBackupRun`'s OWN relation to `Job` in spirit (a dedicated table
  // outliving the generic queue's retention) but stays a plain column rather
  // than a `@relation`+`@unique` pair: unlike a backup run, an `AiRun` is not
  // one-to-one with its job in every future shape this platform may take
  // (a retried run may reuse the id, or a future synchronous path may have no
  // job at all), so this issue commits only to recording the id, not to the
  // stronger one-to-one relation `DatabaseBackupRun.jobId` commits to.
  jobId String? @map("job_id") @db.Uuid

  // pending|running|succeeded|failed|cancelled — this run's own state
  // machine, kept as a plain string rather than a Prisma enum for the
  // forward-compatibility reason given in the block comment above this
  // section.
  status String @default("pending")

  provider String
  modelId  String @map("model_id")

  // The NORMALIZED request — model id, parameters, and the FULL prompt shape
  // (instructions, input, tools, structured-output schema) `toStoredRunRequest`
  // (`runtime/ai-run-request.ts`) built from it — and NEVER the caller's key
  // material, which this run's executor holds separately and only for the
  // duration of the call. Deliberately not redacted or truncated: the
  // worker that claims this job re-issues the user's exact request, and a
  // truncated prompt would make the replayed call diverge from the one the
  // user actually asked for. See the ⚠ block comment above this section.
  request Json

  output       Json?
  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  // The organization the run belongs to (#725). NOT NULL, row-level security
  // forced (policy `ai_runs_org_isolation`). `Restrict`, not `SetNull`: the
  // column is NOT NULL, so history cannot survive an organization's deletion
  // by nulling it; deleting an organization first purges its runs.
  orgId String @map("org_id") @db.Uuid

  // The registered AI feature the run was started for (`registerAiFeature`,
  // PP-14.17, #935): a bounded id the feature registry validated, NEVER free
  // text. Nullable (a run started without a feature, and every row written
  // before this column existed), and a plain string rather than a reference:
  // a feature is code, not data, and a row must outlive the feature that
  // wrote it. Carried onto the run's usage rows, so per-feature usage is
  // answerable from the database.
  feature String?

  // Relations
  //
  // SetNull — see the block comment above this section.
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  org  Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)

  // "This user's run history, most recent first" — the one query this table
  // is known to need today (a user's own run list).
  @@index([userId, createdAt])
  // The same query behind the policy filter `org_id = X`.
  @@index([orgId, userId, createdAt])
  // The retention sweep (`ai.runs.purge`, #681): "oldest first, older than
  // the cutoff" across every user, which `[userId, createdAt]` cannot serve.
  @@index([createdAt])
  // The target of an app table's composite foreign key (id, org_id), like
  // `Group` and `StorageObject`: a plain FK on `id` would let a row of one
  // organization point at another's (an FK check bypasses row-level security).
  @@unique([id, orgId])
  @@map("ai_runs")
}

// One row per AI operation attempted, successful or not — the usage/billing
// accounting ledger, deliberately separate from `AiRun` above. `AiRun` is
// "what did this background call do" (one row per queued call, with its own
// request/output); `AiUsageEvent` is "what did this cost", covering every
// operation kind (`responses|images|audio.transcribe|audio.speech|
// embeddings|catalog`) whether or not it went through the queue at all — a
// synchronous catalog-listing call has no `AiRun` but still consumes a
// provider call worth recording.
model AiUsageEvent {
  id String @id @default(uuid()) @db.Uuid

  // Nullable, `SetNull` — see the block comment above this section. A
  // catalog-discovery sync run by the deployment itself, not by any one
  // user, is the concrete case that leaves this null.
  userId String? @map("user_id") @db.Uuid

  provider String
  modelId  String @map("model_id")

  // responses|images|audio.transcribe|audio.speech|embeddings|catalog — the
  // kind of provider call this event records. Plain string for the
  // forward-compatibility reason given above: a new operation kind (a future
  // provider capability) must cost zero migrations here.
  operation String

  // user|org|admin_discovery — WHOSE key paid for this call. Distinct from
  // `provider`/`modelId` (which model answered) and from `userId` (who asked):
  // an admin-triggered catalog discovery sync can be `keySource:
  // 'admin_discovery'` with no requesting `userId` at all, and a BYOK-only
  // deployment's every real usage event is `keySource: 'user'`. `'org'` is
  // reserved for a future org-wide fallback key, matching `AI_KEY_POLICIES`'
  // `'byok_with_org_fallback'` in `common/schemas/settings.schema.ts`.
  keySource String @map("key_source")

  // Token accounting. All nullable: an `images`/`audio.*` operation has no
  // token counts at all, and `reasoningTokens`/`cachedInputTokens` are
  // provider-specific breakdowns that not every provider or model reports.
  inputTokens       Int? @map("input_tokens")
  outputTokens      Int? @map("output_tokens")
  reasoningTokens   Int? @map("reasoning_tokens")
  cachedInputTokens Int? @map("cached_input_tokens")

  // Non-token unit accounting for operations tokens don't measure — e.g.
  // `{ images: 2 }` for an image generation call, `{ audioSeconds: 31.4 }` for
  // transcription/speech. JSONB for the reason given in the block comment
  // above this section: the shape varies by `operation` and no query here
  // filters or indexes on it.
  units Json?

  latencyMs Int @map("latency_ms")

  // succeeded|failed|cancelled — this event's own closed outcome, kept as a
  // plain string for the identical forward-compatibility reason `AiRun
  // .status` is.
  status    String
  errorCode String? @map("error_code")

  // The provider's own request/trace id, for reconciling a usage row against
  // that provider's dashboard or support ticket. Nullable: not every provider
  // call surfaces one.
  providerRequestId String? @map("provider_request_id")

  // The `jobs` row this usage event was incurred under, when it was. Plain
  // column, no relation — same reasoning as `AiRun.jobId` above.
  jobId String? @map("job_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // The organization that incurred the call (#725). Nullable on purpose: a
  // deployment-wide event (a catalogue sync) has none, and `SetNull` keeps the
  // history of a deleted organization. Row-level security forced (policy
  // `ai_usage_events_org_isolation`): a NULL row is visible to the system
  // client only.
  orgId String? @map("org_id") @db.Uuid

  // The registered AI feature the call was made for (`registerAiFeature`,
  // PP-14.17, #935), so usage can be filtered and grouped per feature from
  // the database. Nullable: a call made without a feature, a catalogue sync,
  // and every row written before this column existed have none. A plain
  // string, never a reference, and never free text: only an id the feature
  // registry validated is written.
  feature String?

  // Relations
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  org  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  // "This user's usage history, most recent first" — mirrors `AiRun`'s own
  // index for the identical reason.
  @@index([userId, createdAt])
  // The same query behind the policy filter `org_id = X`, and the per-org
  // usage window.
  @@index([orgId, userId, createdAt])
  @@index([orgId, createdAt])
  // "This organization's usage of one feature in a window" (PP-14.17, #935):
  // the per-feature filter and group-by of the usage report.
  @@index([orgId, feature, createdAt])
  // "Usage across all users in a time window" — the deployment-wide
  // accounting/billing query, independent of any one user.
  @@index([createdAt])
  @@map("ai_usage_events")
}
