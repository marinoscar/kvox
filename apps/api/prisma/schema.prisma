// =============================================================================
// Prisma Schema - Web Application Foundation
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// User & Identity
// =============================================================================

model User {
  id                      String   @id @default(uuid()) @db.Uuid
  email                   String   @unique
  displayName             String?  @map("display_name")
  providerDisplayName     String?  @map("provider_display_name")
  profileImageUrl         String?  @map("profile_image_url")
  providerProfileImageUrl String?  @map("provider_profile_image_url")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  identities                       UserIdentity[]
  userRoles                        UserRole[]
  userSettings                     UserSettings?
  auditEvents                      AuditEvent[]               @relation("ActorEvents")
  settingsUpdates                  SystemSettings[]           @relation("SettingsUpdater")
  refreshTokens                    RefreshToken[]             @relation("UserRefreshTokens")
  allowlistEntriesAdded            AllowedEmail[]             @relation("AllowlistAddedBy")
  allowlistEntry                   AllowedEmail?              @relation("AllowlistClaimedBy")
  deviceCodes                      DeviceCode[]               @relation("UserDeviceCodes")
  storageObjects                   StorageObject[]            @relation("UserStorageObjects")
  personalAccessTokens             PersonalAccessToken[]      @relation("UserPersonalAccessTokens")
  credentialUpdates                Credential[]               @relation("CredentialUpdatedBy")
  notificationDeliveries           NotificationDelivery[]     @relation("UserNotificationDeliveries")
  notifications                    Notification[]             @relation("UserNotifications")
  pushSubscriptions                PushSubscription[]         @relation("UserPushSubscriptions")
  workerNodes                      WorkerNode[]               @relation("UserWorkerNodes")
  nodeCredentials                  NodeCredential[]           @relation("UserNodeCredentials")
  // Two relations to ONE table, deliberately (#281, epic #254): a
  // `database_backup_runs` row records both "who asked for this backup" and,
  // once Phase 7 restores from it, "who restored it". They are different acts
  // by (usually) different people at different times, so they are different
  // columns and therefore different relation names. See the block comment
  // above `DatabaseBackupRun` for why the restore audit lives on the backup's
  // own row rather than in a second table.
  databaseBackupRuns               DatabaseBackupRun[]        @relation("UserDatabaseBackupRuns")
  databaseRestores                 DatabaseBackupRun[]        @relation("UserDatabaseRestores")
  broadcastsCreated                NotificationBroadcast[]    @relation("BroadcastAuthor")
  // Transcripts (issue #24, epic #19). Six relations to the transcript
  // tables, split by role for the same reason `databaseBackupRuns` /
  // `databaseRestores` are two relations to one table above: "owns this
  // transcript", "wrote this version", "last edited this segment", "was
  // granted a share", "granted a share", and "asked for this export" are six
  // different acts, not one. See the block comment above the `Transcript`
  // model for the full reasoning behind every one of these relations'
  // `onDelete` behaviour.
  transcripts                      Transcript[]               @relation("TranscriptOwner")
  transcriptVersionsAuthored       TranscriptVersion[]        @relation("TranscriptVersionAuthor")
  transcriptSegmentEdits           TranscriptSegment[]        @relation("TranscriptSegmentEditor")
  transcriptSharesReceived         TranscriptShare[]          @relation("TranscriptShareUser")
  transcriptSharesGranted          TranscriptShare[]          @relation("TranscriptShareGrantedBy")
  transcriptExportsRequested       TranscriptExport[]         @relation("TranscriptExportRequestedBy")
  // AI name checks (issue #328, epic #326). Two relations, split by role for
  // the same reason the six transcript relations above are: "asked for this
  // run" and "accepted/rejected this suggestion" are different acts. See the
  // block comment above the `TranscriptNameCheck` model for the full
  // reasoning behind each `onDelete`.
  transcriptNameChecksRequested    TranscriptNameCheck[]      @relation("TranscriptNameCheckRequestedBy")
  transcriptNameSuggestionsDecided TranscriptNameSuggestion[] @relation("TranscriptNameSuggestionDecidedBy")
  // Notes (issue #48, epic #45). Four relations to the note tables, split by
  // role for the identical reason the six transcript relations above are:
  // "owns this note", "owns this custom template", "wrote this version" and
  // "asked for this export" are four different acts. See the block comment
  // above the `Note` model for the full reasoning behind each `onDelete`.
  notes                            Note[]                     @relation("NoteOwner")
  noteTemplatesOwned               NoteTemplate[]             @relation("NoteTemplateOwner")
  noteVersionsAuthored             NoteVersion[]              @relation("NoteVersionAuthor")
  noteExportsRequested             NoteExport[]               @relation("NoteExportRequestedBy")
  // Per-user AI credentials (issue #47, epic #45). ONE relation, and it
  // CASCADES — unlike `credentialUpdates` above, which is `SetNull` because a
  // `credentials` row belongs to the deployment rather than to the person who
  // last typed it in. This one belongs to the user outright: it is their own
  // provider account's key, their own quota and their own bill, so deleting
  // the account must take the encrypted key with it. See the block comment
  // above `UserAiCredential` for why that FK could not be added to
  // `credentials` instead.
  aiCredentials                    UserAiCredential[]         @relation("UserAiCredentials")

  // Semantic search index state (issue #181, epic #165). ONE relation, and
  // it CASCADES — an index-state row for a document owned by nobody means
  // nothing, the identical reasoning `transcripts`/`notes` already apply to
  // their own `ownerId`. See the block comment above `SearchIndexState`.
  searchIndexStates SearchIndexState[] @relation("SearchIndexStateOwner")

  // Per-user "hide this template from my picker" preference (#310, epic
  // #306). CASCADES — the preference is meaningless once its owner is gone.
  // See the block comment above `UserHiddenNoteTemplate` for why this is a
  // join table rather than a `user_settings` namespace.
  hiddenNoteTemplates UserHiddenNoteTemplate[]

  // Connected Knowledge (epic #344, issue #351). Every `kg_*` table carries
  // its own `owner_id` and CASCADES — an entity, relation, item, piece of
  // evidence, mention, proposal, merge, distinct-pair or attribute
  // definition has no meaning and no permission path to read it once its
  // owner is gone, the identical reasoning `notes.owner_id`/
  // `transcripts.owner_id` already establish (§10, and there is no
  // `graph:read_any` for the same reason there is no `notes:read_any`).
  // `kgEntityViews` is the one exception: it is keyed on `user_id`, not
  // `owner_id`, because "which entities has THIS user looked at" is a
  // per-viewer fact, not an ownership fact — see the block comment above
  // `KgEntityView`.
  kgEntities      KgEntity[]
  kgEntityAliases KgEntityAlias[]
  kgRelations     KgRelation[]
  kgItems         KgItem[]
  kgEvidence      KgEvidence[]
  kgMentions      KgMention[]
  kgProposals     KgProposal[]
  kgMerges        KgMerge[]
  kgDistinctPairs KgDistinctPair[]
  kgAttributeDefs KgAttributeDef[]
  kgEntityDigests KgEntityDigest[]
  kgEntityViews   KgEntityView[]

  @@map("users")
}

model UserIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  providerEmail   String?  @map("provider_email")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@map("user_identities")
}

// =============================================================================
// RBAC - Roles & Permissions
// =============================================================================

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  // Relations
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// =============================================================================
// Settings
// =============================================================================

model SystemSettings {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  value           Json
  version         Int      @default(1)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  updatedByUser User? @relation("SettingsUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model UserSettings {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  value     Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// =============================================================================
// Audit
// =============================================================================

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  actorUser User? @relation("ActorEvents", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_events")
}

// =============================================================================
// Refresh Tokens (for token rotation)
// =============================================================================

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  // Relations
  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// =============================================================================
// Personal Access Tokens (PAT)
// =============================================================================

enum PatDurationUnit {
  minutes
  days
  months
}

model PersonalAccessToken {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  name          String
  tokenHash     String          @unique @map("token_hash")
  tokenPrefix   String          @map("token_prefix")
  durationValue Int             @map("duration_value")
  durationUnit  PatDurationUnit @map("duration_unit")
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz
  lastUsedAt    DateTime?       @map("last_used_at") @db.Timestamptz
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  revokedAt     DateTime?       @map("revoked_at") @db.Timestamptz

  // Relations
  user User @relation("UserPersonalAccessTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("personal_access_tokens")
}

// =============================================================================
// Allowlist (Email Access Control)
// =============================================================================

model AllowedEmail {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique
  addedById   String?   @map("added_by_id") @db.Uuid
  addedAt     DateTime  @default(now()) @map("added_at") @db.Timestamptz
  claimedById String?   @unique @map("claimed_by_id") @db.Uuid
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz
  notes       String?

  // Reminder tracking (issue #301, epic #271). A manual, admin-pressed action
  // — "remind this invitee" — not a scheduler: there is no cron and no job
  // type behind this pair, on the repository owner's explicit instruction.
  // A reminder is a fact about THIS invitation, not a separate event stream,
  // so it lives on the row rather than in a new table.
  //
  // `reminderCount` is `@default(0)` and NOT NULL on purpose: zero reminders
  // sent is the true, representable state of every row today, unlike
  // `lastReminderAt` where absence means "never" rather than "zero". Making
  // it nullable would give every existing row NULL and force every read site
  // to write `?? 0`.
  reminderCount  Int       @default(0) @map("reminder_count")
  // Nullable: absent means no reminder has ever been sent. Set to the send
  // time each time an admin presses the button, alongside incrementing
  // `reminderCount`.
  lastReminderAt DateTime? @map("last_reminder_at") @db.Timestamptz

  // Relations
  addedBy   User? @relation("AllowlistAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  claimedBy User? @relation("AllowlistClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)

  @@map("allowed_emails")
}

// =============================================================================
// Device Authorization Flow (RFC 8628)
// =============================================================================

enum DeviceCodeStatus {
  pending
  approved
  denied
  expired
}

model DeviceCode {
  id         String           @id @default(uuid()) @db.Uuid
  deviceCode String           @unique @map("device_code")
  userCode   String           @unique @map("user_code")
  userId     String?          @map("user_id") @db.Uuid
  status     DeviceCodeStatus @default(pending)
  clientInfo Json?            @map("client_info")
  scopes     String[]
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User? @relation("UserDeviceCodes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceCode])
  @@index([userCode])
  @@index([status, expiresAt])
  @@index([userId])
  @@map("device_codes")
}

// =============================================================================
// Storage Objects
// =============================================================================

enum StorageObjectStatus {
  pending // Upload initiated, awaiting chunks
  uploading // Chunks being uploaded
  processing // Post-upload processing in progress
  ready // Available for use
  failed // Upload or processing failed
}

model StorageObject {
  id              String              @id @default(uuid()) @db.Uuid
  name            String // Original filename
  size            BigInt // Total size in bytes (BigInt for GB-scale)
  mimeType        String              @map("mime_type")
  storageKey      String              @unique @map("storage_key") // S3 object key
  storageProvider String              @default("s3") @map("storage_provider")
  bucket          String?
  status          StorageObjectStatus @default(pending)
  s3UploadId      String?             @map("s3_upload_id") // S3 multipart upload ID

  // The part size THIS upload was initialised with (issue #21). Nullable: it
  // is meaningless for a simple upload and unknown for every row written
  // before this column existed.
  //
  // ⚠ PERSISTED RATHER THAN RECOMPUTED, and that is the whole point. It used
  // to be re-derived from `storage.partSize` on every status call, so an
  // operator raising STORAGE_PART_SIZE silently renumbered the parts of every
  // upload already in flight: a client resuming one would skip the wrong
  // offsets and complete a corrupt object. A part size is a property of an
  // upload, fixed the moment the first part is signed.
  //
  // `Int`, not `BigInt`: S3 caps a part at 5 GiB, comfortably inside int4.
  partSize Int? @map("part_size")

  // The module that owns this object, e.g. 'transcripts' (issue #21). NULL
  // means the object is a plain user upload owned by nobody but its uploader.
  //
  // A managed object is excluded from `GET /api/storage/objects` and answers
  // 409 on `DELETE /api/storage/objects/:id` — deleting a transcript's source
  // audio out from under the transcript is a data-loss bug wearing a REST
  // endpoint. The owning module deletes through its own surface.
  //
  // Plain `text`, no enum and no FK, for the same reason `jobs.subject_type`
  // is plain text: the set of owning modules is open, and a fork's modules
  // cannot be enumerated here.
  managedBy String? @map("managed_by")

  metadata     Json? // JSONB for flexible metadata
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  uploadedBy                 User?                @relation("UserStorageObjects", fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks                     StorageObjectChunk[]
  // Five back-relations from transcripts (issue #24, epic #19), one per
  // `storage_objects` FK the transcript tables hold. Every one of those FKs
  // is `onDelete: Restrict` — see the block comment above the `Transcript`
  // model for why a managed object like these may only ever be removed by
  // `transcript.purge` deleting the referencing row first, never by an
  // unrelated storage cleanup deleting the object out from under it. List
  // types, not optional singulars, because nothing here declares these FKs
  // `@unique` — a future column reusing an existing object (unlikely, but
  // not schema-prevented) would still be representable.
  transcriptsAsSource        Transcript[]         @relation("TranscriptSourceObject")
  transcriptsAsPlayback      Transcript[]         @relation("TranscriptPlaybackObject")
  transcriptsAsRawResult     Transcript[]         @relation("TranscriptRawResultObject")
  transcriptVersionSnapshots TranscriptVersion[]  @relation("TranscriptVersionSnapshotObject")
  transcriptExportFiles      TranscriptExport[]   @relation("TranscriptExportObject")
  // Two back-relations from notes (issue #48, epic #45), the identical
  // Restrict-FK reasoning as the five transcript ones above: only
  // `note.purge`/`notes.housekeeping` deleting the referencing row first may
  // ever remove one of these objects.
  notesAsSourceObject        Note[]               @relation("NoteSourceObject")
  noteExportFiles            NoteExport[]         @relation("NoteExportObject")
  // Connected Knowledge (epic #344, issue #351). SetNull — an import's
  // evidence row is a citation into the imported file, and survives losing
  // the object the same way a transcript/note evidence pointer does. See
  // the block comment above `KgEvidence`.
  kgEvidenceImports          KgEvidence[]

  @@index([uploadedById])
  @@index([status])
  @@index([createdAt])
  @@map("storage_objects")
}

model StorageObjectChunk {
  id         String   @id @default(uuid()) @db.Uuid
  objectId   String   @map("object_id") @db.Uuid
  partNumber Int      @map("part_number") // S3 part number (1-10000)
  eTag       String   @map("e_tag") // S3 ETag for verification
  size       BigInt // Chunk size in bytes
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  // Relations
  object StorageObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, partNumber])
  @@index([objectId])
  @@map("storage_object_chunks")
}

// =============================================================================
// Encrypted Credential Store  (issue #115, epic #108)
// =============================================================================
//
// Runtime-configured secrets (an SMTP password, an OAuth client secret, a
// second bucket's S3 key, ...) addressed by (purpose, name) rather than one
// column per consumer, so every future secret reuses this table instead of
// inventing its own column, its own encrypt call, and its own chance to leak.
//
// `secret` holds ONLY the opaque base64 ciphertext produced by
// `encryptSecret()` in `common/crypto/secret-cipher.ts`, encrypted under
// `purpose` as the sub-key derivation label — a ciphertext lifted from one
// row cannot be decrypted under a different purpose. This model stores
// ciphertext and non-secret metadata only; it never sees plaintext, and
// Prisma performs no encryption of its own.
//
// NEVER select `secret` into anything that reaches an API response or a log
// line. `CredentialsService` is the sole reader/writer and is what actually
// enforces that split (a plaintext-returning method for server-side
// consumers, a metadata-only method for presentation) — this comment is the
// signpost, not the guarantee.
model Credential {
  id              String   @id @default(uuid()) @db.Uuid
  purpose         String
  name            String
  // Opaque [iv][authTag][ciphertext] payload, base64-encoded by
  // encryptSecret(). @db.Text (not the default `varchar`) because a base64
  // AES-GCM payload has no meaningful bound: encrypted key material,
  // passwords, or tokens of arbitrary length must never be truncated.
  secret          String   @db.Text
  // Non-secret display aid for the admin UI (e.g. last 4 chars, or a fixed
  // mask like '••••'). Nullable: a credential can exist before anyone has
  // decided how to hint it, and some secrets have no meaningful suffix to show.
  hint            String?
  // Human-readable description for the admin UI. Nullable for the same reason.
  label           String?
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  //
  // onDelete: SetNull — deliberately NOT Cascade. A credential is
  // infrastructure shared by whatever consumer looks it up by (purpose,
  // name); the admin who last set it is provenance, not an owner the
  // credential's lifetime should depend on. Offboarding the user who last
  // typed in the SMTP password must not silently delete a working SMTP
  // configuration — that failure mode (email breaks because someone left
  // the company) is exactly what this FK behaviour avoids. The credential
  // outliving its last editor is correct; losing it is not.
  updatedByUser User? @relation("CredentialUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([purpose, name])
  @@map("credentials")
}

// =============================================================================
// Notification Deliveries (issue #125, epic #109)
// =============================================================================
//
// One row per delivery ATTEMPT of an event (#121, `notification-events.ts`)
// over a channel, to a recipient. This is the answer to "did the user
// actually get it?" — the first question asked when something goes wrong,
// and epic #109's own success criterion 7: a delivery record exists for
// every attempt, with the provider's message id or error.
//
// -----------------------------------------------------------------------------
// eventKey — plain string, NOT a foreign key
// -----------------------------------------------------------------------------
// Events are declared in code (`notification-events.ts`, #121), not in a
// database table — `findEvent()` there returns `undefined` rather than
// throwing for a key it doesn't recognize, precisely because callers may be
// holding a key that came from persisted data written before the event was
// renamed or removed. An FK into an "events" table would force a migration
// (and a backfill, or a placeholder row) every time the registry changes,
// which is exactly the coupling #121 built the registry to avoid. A delivery
// record must outlive the event definition that produced it.
//
// -----------------------------------------------------------------------------
// channel — ALSO a plain string, not a Prisma enum (deliberately asymmetric
// with `status` below)
// -----------------------------------------------------------------------------
// `NotificationChannel` in `notification-events.ts` is explicitly derived
// from a plain array (`NOTIFICATION_CHANNELS`) so that adding `'push'` later
// (epic #109 reserves it) costs one edit to that array, not a migration. A
// Postgres enum on this column would quietly reintroduce that migration: the
// set of valid channels would live in two places — the code registry and
// this column's type — and adding one would require updating both. The
// registry is the single source of truth for what channels exist; this
// column just records which one a given attempt used.
//
// -----------------------------------------------------------------------------
// status — IS a Prisma enum
// -----------------------------------------------------------------------------
// Unlike eventKey/channel, `status` is not registry data — it is this
// table's own delivery state machine, owned entirely by the dispatcher, and
// nothing outside this table grows it. It follows the convention this schema
// already uses for exactly this shape of field (`DeviceCodeStatus`,
// `StorageObjectStatus`): a small, closed, code-owned set of states is a
// Postgres enum here, so the database itself rejects a delivery row written
// with anything other than queued/sent/failed.
//
// -----------------------------------------------------------------------------
// userId — nullable; recipient — the actual destination used
// -----------------------------------------------------------------------------
// `allowlist.invitation` (#121) is sent to an email address with no user
// account yet (#128) — there is no user row to point to, so `userId` must be
// nullable. `recipient` is what makes that case complete: it is the actual
// destination address used for THIS delivery, captured independently of the
// user relation, so the record stands on its own with `userId` null, and
// stays historically accurate even if the user's email later changes.
//
// -----------------------------------------------------------------------------
// onDelete: SetNull on the user relation
// -----------------------------------------------------------------------------
// Matches the audit-trail precedent this schema already sets for
// `AuditEvent.actorUserId` and `Credential.updatedByUser`: a delivery record
// is a history of what the application sent, and deleting a user account
// should not retroactively erase the evidence of what was sent to them —
// particularly for `security.*` events (#121), which are exactly the ones an
// incident review is most likely to need after the account in question no
// longer exists. Nothing is lost by nulling the FK: `recipient` already
// carries the actual destination independently of it. A GDPR-style request
// to purge one user's PII is a deliberate, targeted scrub of these rows (and
// `recipient` specifically) — not something an ON DELETE clause should do
// silently and irreversibly as a side effect of an unrelated user-deletion
// path elsewhere in the app.
//
// -----------------------------------------------------------------------------
// Indexes — exactly the two queries this table is known to serve
// -----------------------------------------------------------------------------
// Every index is a write cost on a table that grows with every notification
// sent, so nothing speculative is added beyond what #125 itself names:
//   - [userId, eventKey]: "did this user get this event?" — an equality
//     filter on both columns, from an account's delivery history view.
//   - [status, createdAt]: "what failed recently?" — status = 'failed'
//     filtered and ordered by recency, for on-call triage.
model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  eventKey          String                     @map("event_key")
  userId            String?                    @map("user_id") @db.Uuid
  recipient         String
  channel           String
  status            NotificationDeliveryStatus @default(queued)
  providerMessageId String?                    @map("provider_message_id")
  // Provider errors (SMTP rejections, SES API errors, ...) have no useful
  // length bound — @db.Text, same reasoning as Credential.secret above.
  error             String?                    @db.Text
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User? @relation("UserNotificationDeliveries", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, eventKey])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

enum NotificationDeliveryStatus {
  queued
  sent
  failed
}

// =============================================================================
// Notifications — the in-app notification centre store (issue #127, epic #109)
// =============================================================================
//
// THE PRIMARY SURFACE OF THE BROWSER CHANNEL, NOT A CACHE OF WHAT SSE SENT.
//
// That ordering is the whole reason this table exists. `Notification`
// permission is denied by a large share of users, and once denied it is
// effectively permanent — the page cannot re-prompt. A browser channel that
// existed only as an OS toast would therefore not exist at all for those
// accounts. So the durable, per-user list is the feature; the SSE stream
// (`notification-stream.service.ts`) makes it live, and the native toast is a
// decoration on top that degrades to nothing.
//
// Read the second consequence too: SSE IS NOT A DELIVERY GUARANTEE. Events
// published while a tab is disconnected are lost — `EventSource` reconnects
// but replays nothing, and the per-process subscriber registry does not fan
// out across replicas. Because rows land here first and the stream is
// published second, a client that refetches this table on (re)connect sees
// everything regardless. That is the designed recovery path, and it is why
// there is no event-replay machinery anywhere in #127.
//
// -----------------------------------------------------------------------------
// HOW THIS DIFFERS FROM `notification_deliveries` (#125), WHICH IS NOT THE SAME
// TABLE WITH A DIFFERENT NAME
// -----------------------------------------------------------------------------
//
// `notification_deliveries` is the OPERATOR's record: one row per ATTEMPT, per
// channel, answering "did we try, and what did the provider say?". It records
// email attempts too, it keeps rows for recipients with no account, and it is
// never shown to the user it is about.
//
// `notifications` is the USER's inbox: one row per thing they should see, only
// for the browser channel, only for real accounts, with read state they own.
// An email send writes a delivery row and no row here — there is nothing for
// the bell to show about a message that went to their mailbox.
//
// Merging the two would mean either showing users provider error strings, or
// filtering an operator table by channel on every bell render. They answer
// different questions for different audiences and are kept apart.
// =============================================================================

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  // NOT NULL, unlike NotificationDelivery.userId. An inbox belongs to an
  // account by definition; there is no "notification centre" for a recipient
  // with no login (#128's `allowlist.invitation` case), which is exactly why
  // the browser channel's resolveTo returns null for them.
  userId String @map("user_id") @db.Uuid

  // Plain string, NOT a foreign key — the same reasoning written out at length
  // on NotificationDelivery.eventKey. Events are declared in code
  // (`notification-events.ts`, #121) and `findEvent` returns undefined rather
  // than throwing precisely because persisted rows outlive their definitions.
  // An FK would force a migration every time the registry changed.
  eventKey String @map("event_key")

  // RENDERED AT WRITE TIME, not at read time. The alternative — store the
  // event payload as JSONB and render in the bell — means an old row renders
  // through today's template, so editing copy silently rewrites history and a
  // removed event's rows become unrenderable. What the user was told is a
  // fact; it is frozen here.
  title String
  // @db.Text for the same reason as Credential.secret and
  // NotificationDelivery.error: a rendered body has no meaningful length
  // bound, and silently truncating what a user was told is worse than storing
  // a long string. (Postgres `text` has no performance penalty over `varchar`.)
  body  String @db.Text

  // Where the bell should send the user, as a ROOT-RELATIVE PATH ("/settings",
  // "/admin/users?id=…"), never an absolute URL.
  //
  // THIS IS A SECURITY BOUNDARY, ENFORCED IN CODE AT WRITE TIME
  // (`browser-notification.channel.ts`). The web client will put this value in
  // an href or a router navigation; an absolute URL makes every notification a
  // potential open redirect, and a `javascript:` scheme makes it script
  // execution in the app's own origin. The column cannot express that
  // constraint, so the writer enforces it and drops a link it cannot vouch
  // for rather than storing it and hoping the client is careful.
  //
  // Nullable: most notifications have nowhere specific to go.
  link String?

  // A TIMESTAMP, NOT A BOOLEAN. `readAt IS NULL` answers "is it unread?" just
  // as well as `read = false` does, and additionally answers "when did they
  // see it?" — which is the question asked when someone reports acting late on
  // a security alert. A boolean would have to grow this column later anyway.
  readAt DateTime? @map("read_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // NO `updatedAt`. The only mutation this row ever undergoes is being marked
  // read, and `readAt` already timestamps that with more precision than an
  // `updatedAt` would carry. A second, redundant answer to "when did this
  // change?" is a second thing to keep consistent for no reader.

  // Relations
  //
  // onDelete: Cascade — deliberately the OPPOSITE of
  // NotificationDelivery.user's SetNull, and the contrast is the point. A
  // delivery record is an audit trail that must outlive the account it
  // describes ("did we email this person before they were offboarded?"). An
  // inbox is personal data with no reader once the account is gone: keeping
  // orphaned rows would retain rendered titles and bodies about a deleted user
  // forever, and `userId` is NOT NULL here so SetNull is not even expressible.
  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // The two queries this table actually serves, and nothing speculative.
  //
  // 1. THE UNREAD BADGE: `where { userId, readAt: null }`, run on every bell
  //    render and on every SSE (re)connect — by far the hottest query here.
  //    (Ideally a partial index `WHERE read_at IS NULL`, which Prisma cannot
  //    express declaratively; the composite covers the same predicate and
  //    stays in one place the schema owns.)
  @@index([userId, readAt])
  // 2. THE RECENT LIST: `where { userId } orderBy { createdAt: desc }`.
  //    `sort: Desc` matters — a plain ascending index makes Postgres walk it
  //    backwards for the newest page, which is the only page anyone loads.
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// =============================================================================
// Push Subscriptions (issue #229, epic #215)
// =============================================================================
//
// Storage for the browser's `PushSubscription` object — the endpoint URL plus
// the two keys (`p256dh`, `auth`) needed to encrypt a Web Push payload to that
// specific device — so the server has something to sign and send to when a
// notification's `browser` channel wants to reach a tab that isn't open.
//
// THIS SHIPS DISABLED BY DEFAULT (per #215). This table, and the endpoints the
// next pass builds on top of it, exist regardless; what makes push actually
// fire is a downstream deployment setting `VAPID_PUBLIC_KEY` /
// `VAPID_PRIVATE_KEY` in its own environment. A repo that never sets those
// vars has this table sitting empty and unused — generating keys, not writing
// code, is the enable step. Nothing here should ever require a schema change
// to turn push on.
//
// -----------------------------------------------------------------------------
// endpoint — @unique, not part of a composite key with userId
// -----------------------------------------------------------------------------
// The endpoint URL (assigned by the browser's push service — FCM, Mozilla's
// autopush, ...) already uniquely identifies one subscribed device/browser
// instance; it cannot simultaneously be valid for two different users. Making
// it @unique on its own, rather than @@unique([userId, endpoint]), is what
// lets the service layer `upsert` on `endpoint` alone (#229's acceptance
// criterion: "Re-subscribing the same endpoint upserts instead of creating a
// duplicate row") — including the case where the same browser subscription
// re-registers under a different signed-in user, which should move the row,
// not fork it.
//
// -----------------------------------------------------------------------------
// userId — onDelete: Cascade, the OPPOSITE of NotificationDelivery.user's
// SetNull right above, and deliberately so
// -----------------------------------------------------------------------------
// NotificationDelivery keeps its user relation nullable-with-SetNull because a
// delivery row is an audit trail with standalone value ("did we send this
// before the account was offboarded?") even once the account is gone — it
// carries its own `recipient` and stands on its own. A push subscription has
// no such standalone meaning: it is nothing but a live credential for pushing
// to one specific person's device. Once that person's account is deleted
// there is no one left to authorize a push, no one left to act on it, and no
// audit value in keeping an endpoint + key material around — it is simply
// dead. Cascade is correct here for the same reason `Notification.user` above
// is Cascade rather than SetNull: this is live, personal state with no reader
// once the account is gone, not history.
//
// -----------------------------------------------------------------------------
// failureCount / lastSuccessAt — written by #230, columns exist now
// -----------------------------------------------------------------------------
// Web Push endpoints go stale silently (uninstalled browser, revoked
// permission, expired subscription) and the push service reports this as a
// 404/410 (gone) or persistent 429/5xx on send, never as an explicit
// unsubscribe call. `failureCount` is incremented by the not-yet-built sender
// (#230) on each such failure so a pruning job can drop subscriptions that
// have stopped working, and `lastSuccessAt` is its complement — updated on
// every successful send — so "why did this stop working" has an answer
// (compare `failureCount`'s growth against how long ago `lastSuccessAt` was)
// without needing delivery-log archaeology. Neither column is written by
// anything in this migration; they exist now so #230 needs no schema change.
model PushSubscription {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  // The push service URL the browser gave us (e.g.
  // `https://fcm.googleapis.com/fcm/send/...`). @unique — see block comment
  // above for why this, not a composite key, is what the upsert relies on.
  endpoint String @unique

  // The two halves of the browser's subscription keys
  // (`PushSubscription.getKey('p256dh'|'auth')`, base64url-encoded), together
  // sufficient to encrypt a payload to this device per the Web Push
  // encryption spec (RFC 8291). Neither is secret in the same sense as
  // `Credential.secret` — they are meaningless without also knowing the
  // corresponding endpoint and the server's VAPID private key — so they are
  // stored plain, matching how every Web Push library (including `web-push`,
  // which the next pass will use) expects to read them back out.
  p256dh String
  auth   String

  // From the browser's `PushSubscription.expirationTime`, when the push
  // service supplies one (most don't). Nullable because absence is the
  // common case, not an error.
  expirationTime DateTime? @map("expiration_time") @db.Timestamptz

  // For diagnosing "why did this stop working" alongside failureCount/
  // lastSuccessAt below. Nullable: not always available, and never required.
  userAgent String? @map("user_agent")

  // Incremented by #230's sender on delivery failure (429/5xx from the push
  // service); read by its not-yet-built pruning logic to drop dead
  // subscriptions. Starts at 0 and is reset to 0 on the next successful send.
  failureCount Int @default(0) @map("failure_count")

  // Updated on every successful send by #230. Nullable: a freshly created
  // subscription has never had one.
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  //
  // onDelete: Cascade — see block comment above for why this reverses the
  // SetNull precedent set by NotificationDelivery.user just above.
  user User @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  // The one query this table is known to serve: "give me this user's
  // subscriptions to push to" (#229's subscribe/unsubscribe endpoints and
  // #230's send fan-out both key off userId; endpoint's own @unique index
  // already covers lookup/upsert by endpoint).
  @@index([userId])
  @@map("push_subscriptions")
}

// =============================================================================
// Notification Broadcasts (issue #320, epic #319)
// =============================================================================
//
// One row per admin-composed message announced to every user in the
// deployment — "we're doing maintenance Saturday", "new feature shipped" —
// scheduled, sent (or canceled), and never re-editable once it has started.
// This issue is schema only: the compose/schedule/cancel endpoints, the job
// handler that actually fans a broadcast out over `notify()`, and the admin
// UI all arrive in later issues of #319. What is here is the row a later
// issue's job reads from and writes progress back to.
//
// -----------------------------------------------------------------------------
// WHY A TABLE AT ALL — REJECTED: living entirely inside `Job.payload`
// -----------------------------------------------------------------------------
// The obvious shortcut is to skip this table and let a broadcast be nothing
// but the `payload` JSON of a `'broadcast.send'` job (#255 already gives
// every job a JSONB payload for free). Two things rule that out:
//
//   - Job history is pruned INDEPENDENTLY of this table's business value.
//     `job-history-purge` (#263) deletes old `jobs` rows on a retention
//     schedule that exists to keep the QUEUE small, not to preserve what an
//     admin once announced. A broadcast composed ninety days ago is still
//     something "what did we tell our users, and when" needs to answer long
//     after the job that sent it has aged out — living only in `payload`
//     means that answer silently disappears on a retention sweep nobody
//     doing the asking even knows runs.
//   - The admin broadcast list page (a later issue in #319) would be
//     QUERYING THE QUEUE FOR BUSINESS DATA — filtering and paging `jobs` by a
//     `type` string and reading business fields back out of an opaque JSONB
//     blob never meant to be a list-page's row shape. `jobs` is
//     infrastructure for background work in general; a broadcast is a
//     first-class thing the product has, with its own status, its own
//     progress counters, and its own list page. It gets its own table for the
//     same reason `notifications` (#127) is not "SSE events kept in a JSONB
//     column somewhere" — the durable record IS the feature, not a
//     side-effect of how the delivery mechanism happens to be implemented.
//
// A `'broadcast.send'` job still exists and still references one of these
// rows (by id, in its `payload`) to actually run the fan-out — this table is
// not a replacement for the queue, only for using the queue's own history as
// the system of record.
//
// -----------------------------------------------------------------------------
// channels — String[], not a Prisma enum
// -----------------------------------------------------------------------------
// Mirrors `NotificationDelivery.channel`'s deliberate plain-string choice
// (see that column's own block comment above), one level up: a broadcast can
// target more than one channel at once, so this is `channels String[]`
// rather than a single string, but the "why not an enum" reasoning is
// identical. `NOTIFICATION_CHANNELS` (`notification-events.ts`) is a
// code-owned, growing array specifically so adding `'push'`-style channels
// later costs one edit to that array. A Postgres enum on this column would
// reintroduce exactly the migration that array exists to avoid, and would
// leave the set of valid channels living in two places that could disagree.
//
// -----------------------------------------------------------------------------
// title / body — composed and frozen at write time, not templated at read
// time
// -----------------------------------------------------------------------------
// Same contract as `Notification.title`/`.body` (#127): what an admin typed
// (or the compose form rendered from it) is a fact about what was announced,
// stored as that fact, not as a template reference re-rendered later. The
// alternative — store a template key plus a data blob and render in the
// list page — means editing copy elsewhere in the app silently rewrites what
// this broadcast is remembered as having said, and a broadcast survives any
// future rename or removal of whatever generated its text.
//
// -----------------------------------------------------------------------------
// status — `NotificationBroadcastStatus`, matching `NotificationDeliveryStatus`'s
// naming, and carrying one member NOTHING IN THIS EPIC CAN REACH YET
// -----------------------------------------------------------------------------
// The enum is prefixed `NotificationBroadcast…` rather than plain
// `BroadcastStatus` to match the existing `NotificationDeliveryStatus`
// naming convention on the sibling tables in this section, rather than
// inventing a shorter name unique to this model.
//
// `draft` IS NOT REACHABLE BY ANY ROUTE #319 BUILDS. No compose endpoint in
// this epic writes a row with that status, and no later issue's handler
// reads one. It is here anyway, on purpose, because adding a value to a
// Postgres enum type is a migration, and `ALTER TYPE ... ADD VALUE` cannot
// run inside the same transaction Prisma wraps a migration in (Postgres
// forbids using a freshly added enum value in the transaction that added
// it). A future "save and finish composing later" feature is a one-line
// product ask that would otherwise cost a migration on a table with live
// data; paying for the enum slot now, while it is free, buys that escape
// hatch later for nothing. DO NOT DELETE `draft` AS "unused" — it is
// deliberately dead code, not leftover code.
//
// -----------------------------------------------------------------------------
// cursorUserId / audienceCutoff — the resume point AND the frozen audience
// for a chunked, cursor-resumable fan-out
// -----------------------------------------------------------------------------
// A broadcast fans out to every user in the deployment, which can be far
// more than one job execution should hold open in a single transaction or a
// single lease window. #323's handler processes users in chunks and, after
// each chunk commits, writes that chunk's last id to `cursorUserId` so a
// retried or resumed run picks up exactly where the previous attempt left
// off instead of restarting from user zero (or, worse, re-sending to
// everyone already done).
//
// `audienceCutoff` IS THE MOST IMPORTANT FIELD ON THIS MODEL, because a
// cursor alone does not define a stable audience to page through — it only
// defines a position. Stamped ONCE, when the fan-out starts (`status` moves
// to `sending`), it is the timestamp every chunk's query filters
// `users.createdAt` against (`createdAt <= audienceCutoff`), combined with
// `WHERE id > cursorUserId ORDER BY id ASC` for the page itself. That
// combination buys two things at once, with no new index on `users`:
//
//   - A FROZEN AUDIENCE. Without a cutoff, a fan-out that takes long enough
//     for new signups to land mid-run would keep discovering new rows to
//     page through — the query keeps changing under it. A broadcast could
//     then fail to terminate under sustained signups, or (worse) a user who
//     signed up during the run could receive it depending on exactly when
//     their row was inserted relative to the currently-processing chunk.
//     Freezing the boundary at start time makes the set of eligible users
//     fixed the moment sending begins.
//   - A REPLAYABLE "WHO GOT THIS" QUERY. `users.id ASC` is the only
//     ordering that is both STABLE and TOTAL — the primary key never
//     changes for a row and no two rows share a value — so re-running
//     `WHERE createdAt <= audienceCutoff ORDER BY id ASC` after the fact
//     reproduces the exact same page sequence the fan-out actually walked,
//     which `cursorUserId` alone (paging on a column with no recorded
//     boundary) cannot promise once the run has finished. `createdAt` is
//     deliberately NOT used as the paging column for this same reason in
//     reverse: two users can share a timestamp (a bulk import, an unlucky
//     race), and a page boundary drawn on a non-unique column can silently
//     skip or repeat a user at that boundary.
//
// This defines two windows precisely, and both are intentional, not edge
// cases to patch later:
//   - A user created between the broadcast's `createdAt` (composed/
//     scheduled) and `startedAt` (fan-out begins) IS INCLUDED — the rule
//     this model implements is "everyone who exists once sending starts",
//     not "everyone who existed when an admin clicked compose".
//   - A user created between `startedAt` and the run's last chunk is
//     EXCLUDED — they signed up after the audience was frozen, and by
//     definition are not behind the cursor a resumed run would recheck.
//
// -----------------------------------------------------------------------------
// createdById — onDelete: SetNull (and the one-line cost of adding this FK)
// -----------------------------------------------------------------------------
// Same reasoning as `AuditEvent.actorUserId` (and `NotificationDelivery
// .user`, and `Credential.updatedByUser`): this column is an audit trail,
// not a live reference. Deleting the admin who composed a broadcast must not
// delete the record of what they announced to every user in the deployment
// — if anything, that is exactly the record an incident review is most
// likely to need after the admin account in question no longer exists.
// Nothing about the broadcast's own meaning depends on the admin row still
// existing, so the FK is nulled, never cascaded. Worth naming plainly: adding
// a foreign key to `users` takes a brief `ACCESS SHARE`-class lock on that
// table while the constraint is validated. At this schema's scale that is
// not something an operator needs to plan a maintenance window around, but
// it is a real, if trivial, cost of this migration and not a free action.
//
// -----------------------------------------------------------------------------
// Indexes — exactly the two queries this table is known to serve
// -----------------------------------------------------------------------------
//   - [status, scheduledFor]: "WHAT IS PENDING" — the scheduler's own query,
//     equality on `status = 'scheduled'` ordered/filtered by `scheduledFor`,
//     for finding due broadcasts to start and upcoming ones to display.
//   - [createdAt desc]: the admin list page's default order, "most recently
//     composed first" — same reasoning as `Job`'s and `Notification`'s own
//     `createdAt(sort: Desc)` indexes, for the same reason: a plain ascending
//     index makes Postgres walk it backwards for the only page anyone loads.
//
// -----------------------------------------------------------------------------
// REJECTED: a `notification_broadcast_recipients` join table
// -----------------------------------------------------------------------------
// The exact-tracking alternative — one row per (broadcast, user) pair,
// recording per-recipient delivery outcome the way `notification_deliveries`
// does per (event, user) — was considered and rejected for this issue.  It is
// UNBOUNDED GROWTH keyed to the size of the user base on every single
// broadcast sent (a deployment with 50,000 users sending one broadcast a
// week is 2.6 million new rows a year for that feature alone), for a
// marginal gain over what `cursorUserId`/`audienceCutoff` plus the two
// counters below already give: the queue's own at-least-once contract (see
// `JobHandler`'s own block comment) already bounds a replay to AT MOST ONE
// CHUNK — the fan-out resumes from the last committed cursor, so
// re-processing is inherently limited to users near the boundary, not the
// whole broadcast. `recipientsTargeted`/`recipientsDispatched` answer "how
// many were meant to get this, how many did we attempt" at the aggregate
// level a broadcast's own admin view actually needs; per-recipient
// per-channel success/failure already lives in `notification_deliveries` —
// this table must not become a second, weaker copy of that record — and
// per-recipient READ-RECEIPT tracking is a different, much heavier feature
// that nothing in #319 asks for.
// =============================================================================

model NotificationBroadcast {
  id       String   @id @default(uuid()) @db.Uuid
  title    String
  body     String   @db.Text
  link     String?
  ctaLabel String?  @map("cta_label")
  eventKey String   @map("event_key")
  channels String[]

  status NotificationBroadcastStatus @default(scheduled)

  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz
  startedAt    DateTime? @map("started_at") @db.Timestamptz
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz
  canceledAt   DateTime? @map("canceled_at") @db.Timestamptz

  // The frozen audience boundary and the paging cursor into it — see the
  // block comment above for the full mechanism; the two are read together.
  audienceCutoff DateTime? @map("audience_cutoff") @db.Timestamptz
  cursorUserId   String?   @map("cursor_user_id") @db.Uuid

  // A snapshot, not a live count: how many users matched `audienceCutoff`
  // the moment the fan-out started. Nullable because it does not exist
  // until sending begins (a `scheduled`/`draft` broadcast has no audience
  // yet). It can legitimately end up HIGHER than `recipientsDispatched` if
  // users are deactivated mid-flight and the handler skips them — this
  // column means "targeted at send time", never "should have received it".
  recipientsTargeted Int? @map("recipients_targeted")

  // How many recipients the fan-out has ATTEMPTED so far — incremented per
  // dispatch attempt, not per success. Per-channel success/failure is
  // already recorded, per attempt, in `notification_deliveries`; this
  // column exists only so the admin list/detail view has a cheap aggregate
  // progress number without joining or scanning that table, not as a
  // second, weaker copy of what it already tracks.
  recipientsDispatched Int @default(0) @map("recipients_dispatched")

  lastError String? @map("last_error") @db.Text

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  createdBy User? @relation("BroadcastAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([createdAt(sort: Desc)])
  @@map("notification_broadcasts")
}

enum NotificationBroadcastStatus {
  // Not reachable by any route in #319 — see the block comment above for why
  // this dead value exists on purpose. Do not remove it as unused.
  draft
  scheduled
  sending
  sent
  canceled
  failed
}

// =============================================================================
// Jobs (issue #255, epic #254)
// =============================================================================
//
// A generic background-job queue table: one row per unit of work a worker
// node claims, runs, and reports the outcome of. This issue adds only the
// schema — the enqueue path, the claim query, and the node plane that
// actually pulls jobs off this table all arrive in later issues of #254
// (the claim query's `RETURNING` aliases land in #260, the `WorkerNode` model
// that `claimedByNodeId` will finally point at lands with the node plane).
// What is here is deliberately complete on its own: every column and index a
// worker needs to claim, execute, retry, and rate-limit a job, so nothing
// downstream requires a follow-up migration to `jobs` itself.
//
// -----------------------------------------------------------------------------
// subjectType / subjectId — plain nullable TEXT, not typed or FK'd columns
// -----------------------------------------------------------------------------
// REJECTED: a column per subject shape (`mediaItemId`, `circleId`, ...). This
// table is generic across every handler `type` this app will ever register,
// present and future. A typed column per subject means every new job kind
// that targets a new kind of thing is a migration to this table, which is
// exactly the coupling a job queue must not have to its callers — the whole
// point of `type` being a free-form handler key is that new handlers cost
// zero schema changes. `subjectType` (a short discriminator string the
// handler itself defines, e.g. `'media_item'`) plus `subjectId` (that
// subject's id, stored as text specifically so it is not assumed to be a
// UUID — some future subject might key by something else) covers every shape
// with two columns, forever.
//
// REJECTED: payload-only, with no subject columns at all (dig the subject id
// out of the JSONB `payload` when you need it). This is what `[subjectType,
// subjectId]` below exists to make wrong: "cancel every pending job for this
// media item" and "is there already an active job for this exact subject"
// (the dedup index just below) are both real, known queries (not
// speculative), and neither is expressible as an index over JSONB without a
// GIN index and a much more awkward query. Two plain columns, indexed
// normally, are simpler and cheaper than making Postgres reach into JSON for
// a value that is known and named at enqueue time regardless.
//
// Both nullable, and BOTH null together is the documented spelling of "this
// is a global/system job" (a nightly sweep, a cache warm) that is not about
// any one row elsewhere in the database — there is no sentinel subjectType
// like `'system'` to keep in sync with anything.
//
// -----------------------------------------------------------------------------
// dedupKey / the active-dedup unique index — enforced by a hand-written
// partial index, NOT `findFirst` then `create` in the enqueue service
// -----------------------------------------------------------------------------
// REJECTED: "check whether an active job with this key already exists, and
// only insert if not" as application logic. That is a check-then-act race:
// two concurrent enqueue calls can both see "no active duplicate" and both
// insert, which is precisely the failure a dedup key exists to prevent, and
// under real concurrent load (a webhook retried while the first delivery is
// still being handled, two nodes reacting to the same event) it is not a
// rare edge case. Only the database can make "is there already an active job
// with this key" atomic with the insert that would violate it, which is what
// `jobs_active_dedup_uniq_idx` below is for: a partial UNIQUE index on
// `dedup_key` filtered to `status IN ('pending','running')`. The enqueue path
// (arriving with #260) inserts optimistically and treats the resulting
// unique-violation as "a duplicate is already in flight", not as an error —
// no pre-check query, no race window.
//
// The partial filter is exactly what makes the key reusable: once a job
// reaches `succeeded` (or `failed`) it drops out of the index's predicate, so
// the same `dedup_key` is free again for a new active job — retrying or
// re-triggering the same logical work later is not permanently blocked by
// its own history. `dedup_key IS NOT NULL` in the predicate is what lets
// jobs that opt out of dedup (most ad-hoc jobs) insert freely with a NULL key
// — Postgres does not consider NULLs equal for uniqueness, but the explicit
// clause documents that this is relied upon, not incidental.
//
// The key's actual format (`type:subjectType:subjectId`) is defined ONCE, in
// `buildDedupKey()` (`src/jobs/job-keys.ts`), which this comment and the
// migration's raw SQL both point back to rather than restating it — see that
// file for why the format is what it is.
//
// -----------------------------------------------------------------------------
// priority — ASCENDING is more urgent
// -----------------------------------------------------------------------------
// Chosen so `ORDER BY priority ASC, created_at ASC` is both "most urgent
// first" and "oldest first within a priority", the same direction Postgres
// already walks a plain ascending b-tree index in — no `DESC` index variant
// needed for the hot claim-query ordering that `[status, priority,
// createdAt]` and `[status, scheduledFor, priority, createdAt]` below exist
// to serve. `0` is the default (normal) priority; more urgent work is a
// smaller (including negative) number, not a larger one.
//
// -----------------------------------------------------------------------------
// attempts vs rateLimitedAt/rateLimitHits — two counters for two different
// reasons a job didn't finish, deliberately not merged into one
// -----------------------------------------------------------------------------
// `attempts` is charged AT CLAIM TIME (incremented when a worker takes the
// job, not when it fails) and is what a max-retry policy reads. Being rate
// limited by a downstream provider is not the job's fault and is not a
// retry in that sense — charging it against `attempts` would make a job that
// is simply waiting its turn look like a job that keeps failing, and could
// exhaust its retry budget for a reason that has nothing to do with the
// job's own correctness. `rateLimitedAt` / `rateLimitHits` track that
// separately: `scheduledFor` is pushed out to defer the job, `rateLimitHits`
// records how often this has happened (for observability/alerting on a
// provider that is persistently saturated), and neither touches `attempts`.
//
// -----------------------------------------------------------------------------
// providerKey / modelVersion — audit of WHAT ran the job, not inputs to it
// -----------------------------------------------------------------------------
// Both nullable and both write-once-at-completion-time metadata: which
// downstream provider handled this job and which model/version it ran
// against, for after-the-fact questions ("did the incident affect jobs that
// ran on provider X" / "which jobs ran before the model version bump").
// Neither is read back by the claim query — they exist for audit, not for
// scheduling.
//
// -----------------------------------------------------------------------------
// claimedByNodeId — a real relation as of issue #267, epic #254
// -----------------------------------------------------------------------------
// This column existed unconstrained (`String? @db.Uuid`) from #255 onward, so
// the claim query and its indexes ([status, leaseExpiresAt],
// [claimedByNodeId]) could be built against their final shape before the
// `WorkerNode` table it references existed. #267 adds that table and wires
// the FK on top of this already-populated column: `onDelete: SetNull`, so a
// node's disappearance (deregistered, pruned, or manually deleted by an
// admin) frees the jobs it was holding — via `leaseExpiresAt` already having
// them look abandoned to the reaper — rather than deleting job history. See
// the block comment above the `WorkerNode` model for the corresponding
// `onDelete` decision on `WorkerNode.createdBy`, which is a different
// question (what happens to the NODE when its owning USER is deleted, not
// what happens to a JOB when its claiming NODE is deleted).
//
// -----------------------------------------------------------------------------
// sumDurationMs on JobStatsRollup — Float (double precision), NOT BigInt
// -----------------------------------------------------------------------------
// REJECTED: BigInt. Prisma maps a BigInt column to the JS `bigint` primitive,
// which `JSON.stringify` refuses outright ("Do not know how to serialize a
// BigInt") — the not-yet-built insights endpoint that reads this rollup would
// crash on its very first response, not degrade gracefully. A running sum of
// per-job durations in milliseconds, even at very high job volume, never
// approaches the ~2^53 safe-integer boundary where `Float` would start
// losing precision that matters for an aggregate (an average duration off by
// fractions of a millisecond at that scale is not a real-world concern);
// BigInt's exactness buys nothing here and costs a runtime crash.
//
// -----------------------------------------------------------------------------
// Prisma-expressible indexes vs the three below written directly in the
// migration (INTENTIONAL SCHEMA DRIFT — see migration.sql in
// 20260906120000_add_jobs)
// -----------------------------------------------------------------------------
// Everything Prisma's index DSL can express is declared with `@@index` below.
// Three more indexes exist ONLY in `migration.sql` because the Prisma schema
// language has no syntax for a partial index (a `WHERE` clause on the index
// itself) — `@@index` always builds a full index over every row:
//
//   - "jobs_active_dedup_uniq_idx": the partial UNIQUE index described above
//     that actually enforces the active-dedup constraint (`dedup_key` where
//     `status IN ('pending','running') AND dedup_key IS NOT NULL`).
//   - "jobs_attempts_gt1_idx": a partial index on `attempts` where
//     `attempts > 1`, sized to the small minority of jobs that have ever
//     been retried, for "show me flaky jobs" without indexing the (large)
//     majority that succeeded on the first attempt.
//   - "jobs_succeeded_duration_idx": a partial index on
//     `(finished_at, started_at, type)` where `status = 'succeeded' AND
//     started_at IS NOT NULL AND finished_at IS NOT NULL`, for computing
//     per-type duration stats (what feeds `JobStatsRollup`) without scanning
//     jobs that were never actually timed.
//
// Because `prisma migrate dev`/`diff` cannot regenerate these from the
// schema file, they will show up as "drift" if anyone ever diffs this schema
// against the live database with a tool that expects `@@index` to be the
// full story. That drift is intentional and this comment (plus the ones in
// the migration itself) is the record of why — do not "fix" it by dropping
// these three indexes, and do not try to force them into `@@index` syntax
// that does not exist.
model Job {
  id String @id @default(uuid()) @db.Uuid

  // The handler key a worker dispatches on (e.g. `'email.send'`,
  // `'export.csv'`). A small, code-owned, growing set — deliberately a plain
  // string and not a Prisma enum, for the same reason `NotificationDelivery
  // .channel` and `.eventKey` are plain strings: new handlers must cost zero
  // migrations, and a row must be able to outlive the handler that produced
  // it (a removed/renamed handler's historical jobs stay queryable).
  type String

  // See the block comment above for why these are plain nullable TEXT rather
  // than typed/FK'd columns, and why both null together means a
  // global/system job.
  subjectType String? @map("subject_type")
  subjectId   String? @map("subject_id")

  // See the block comment above ("dedupKey / the active-dedup unique index")
  // for the full mechanism. Built by `buildDedupKey()`
  // (`src/jobs/job-keys.ts`); nullable because most jobs opt out of dedup
  // entirely.
  dedupKey String? @map("dedup_key")

  status JobStatus @default(pending)
  reason JobReason

  // Ascending = more urgent. See the block comment above.
  priority Int @default(0)

  // Audit of what actually ran this job — see the block comment above.
  // Written once, at completion; never read by the claim query.
  providerKey  String? @map("provider_key")
  modelVersion String? @map("model_version")

  // Handler-defined input, opaque to this table.
  payload Json? @db.JsonB

  // Charged AT CLAIM TIME (see the block comment above for why this is kept
  // separate from rateLimitHits).
  attempts Int @default(0)

  lastError String? @map("last_error")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  startedAt  DateTime? @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz

  // NULL means eligible now. A non-null value in the future is what makes a
  // job invisible to the claim query until then (deferred rate-limit retries,
  // deliberately scheduled work).
  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz

  // Deferral bookkeeping, deliberately separate from `attempts` — see the
  // block comment above.
  rateLimitedAt DateTime? @map("rate_limited_at") @db.Timestamptz
  rateLimitHits Int       @default(0) @map("rate_limit_hits")

  // Node claiming. See the block comment above ("claimedByNodeId") for why
  // this relation arrived a migration after the column did, and why
  // `onDelete: SetNull` is correct here specifically.
  claimedByNodeId String?     @map("claimed_by_node_id") @db.Uuid
  claimedByNode   WorkerNode? @relation("NodeClaimedJobs", fields: [claimedByNodeId], references: [id], onDelete: SetNull)
  leaseExpiresAt  DateTime?   @map("lease_expires_at") @db.Timestamptz
  // 'server' | 'node' — which side actually executed the job. A plain
  // string, not an enum, for the same "small closed set, but code-owned and
  // not this table's own state machine" reasoning as
  // NotificationDelivery.channel above.
  executor        String?

  // The `database_backup_runs` row this job produced, when `type` is
  // `'db.backup.run'` (epic #345, issue #351). See `DatabaseBackupRun.jobId`
  // for the full reasoning behind `@unique`/nullable/`SetNull` — this is
  // just the required other half of that one-to-one relation.
  backupRun DatabaseBackupRun?

  // The `transcript_exports` row this job rendered, when `type` is
  // `'transcript.export'` (issue #24, epic #19). Same one-to-one shape as
  // `backupRun` immediately above, for the same reason: `TranscriptExport
  // .jobId` is `@unique`/nullable/`SetNull` because export rows have their
  // own 7-day retention (`transcripts.housekeeping`), independent of
  // `job.history.purge`'s schedule for this row.
  transcriptExport TranscriptExport?

  // The `note_exports` row this job rendered, when `type` is `'note.export'`
  // (issue #48, epic #45). Identical one-to-one shape as `transcriptExport`
  // immediately above, for the identical reason: `NoteExport.jobId` is
  // `@unique`/nullable/`SetNull` because export rows have their own 7-day
  // retention (`notes.housekeeping`), independent of `job.history.purge`'s
  // schedule for this row.
  noteExport NoteExport?

  // The `note_generations` row this job is producing (or produced), when
  // `type` is `'note.generate'` (issue #48, epic #45). Same one-to-one
  // shape as `noteExport`/`transcriptExport`/`backupRun` above, for the
  // same reason: `NoteGeneration.jobId` is `@unique`/nullable/`SetNull`
  // because a generation's own lifetime (read by the SSE stream and the
  // note detail page) is independent of `job.history.purge`'s schedule for
  // this row.
  noteGeneration NoteGeneration?

  // The `transcript_name_checks` row this job ran, when `type` is
  // `'transcript.name_check'` (issue #328, epic #326). Same one-to-one shape as
  // `transcriptExport`/`noteExport`/`noteGeneration` above, for the same
  // reason: `TranscriptNameCheck.jobId` is `@unique`/nullable/`SetNull`
  // because a run's own lifetime (read by the review UI long after job
  // history is purged) is independent of `job.history.purge`'s schedule for
  // this row.
  transcriptNameCheck TranscriptNameCheck?

  // The `kg_proposals` row this job is extracting (or extracted) into, when
  // `type` is `'kg.extract'` (epic #344, issue #351). Same one-to-one shape
  // as `transcriptNameCheck`/`noteGeneration`/`noteExport`/`transcriptExport`/
  // `backupRun` above, for the same reason: `KgProposal.jobId` is
  // `@unique`/nullable/`SetNull` because a proposal's own review lifetime is
  // independent of `job.history.purge`'s schedule for this row.
  kgProposal KgProposal?

  // See the block comment above ("Prisma-expressible indexes...") for why
  // these eight are declared here and three more exist only in
  // migration.sql.
  //
  // The hot claim-query orderings:
  @@index([status, priority, createdAt])
  @@index([status, scheduledFor, priority, createdAt])
  // "Every job for this subject" / "is there already a job for this exact
  // subject":
  @@index([subjectType, subjectId])
  // "How is this handler doing" (per-type status breakdown):
  @@index([type, status])
  // Lease expiry sweep (finding jobs whose claiming node went away):
  @@index([status, leaseExpiresAt])
  // "What is this node holding right now" — also backs the FK added by #267:
  @@index([claimedByNodeId])
  // Recency listings (admin job list, "what just happened"):
  @@index([createdAt(sort: Desc)])
  // Covering index: the two unconditional admin groupBy counts
  // (`groupBy({ by: ['status'] })`-shaped queries) are answered entirely from
  // this index — status, type and id are all it needs to project — so
  // Postgres never has to visit the heap for them (index-only scan).
  @@index([status, type, id])
  @@map("jobs")
}

enum JobStatus {
  pending
  running
  succeeded
  failed
}

enum JobReason {
  upload
  rerun
  backfill
}

// =============================================================================
// Job Stats Rollup (issue #255, epic #254)
// =============================================================================
//
// One row per `type` (Job.type), maintained incrementally as jobs finish
// rather than computed by aggregating the full `jobs` table on every read —
// `jobs` is expected to grow without bound (or be pruned independently of
// this rollup's needs), so a per-type COUNT/AVG over it is not something the
// not-yet-built insights endpoint should be doing on every request.
//
// `sumDurationMs` is `Float`, deliberately not `BigInt` — see the block
// comment above the `Job` model ("sumDurationMs on JobStatsRollup") for why
// BigInt would crash `JSON.stringify` at the exact place this rollup is
// meant to be read from. Average duration for a type is
// `sumDurationMs / durationSamples`, computed by the reader; this table
// stores the two accumulators, not the derived average, so re-deriving after
// a correction never requires touching historical precision.
model JobStatsRollup {
  type String @id

  succeededCount Int @default(0) @map("succeeded_count")
  failedCount    Int @default(0) @map("failed_count")

  // See the block comment above for why Float, not BigInt.
  sumDurationMs   Float @default(0) @map("sum_duration_ms")
  durationSamples Int   @default(0) @map("duration_samples")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("job_stats_rollup")
}

// =============================================================================
// Worker Nodes (issue #267, epic #254)
// =============================================================================
//
// This issue adds only the schema half of the node plane: `WorkerNode`
// itself, `NodeCredential` (the `nod_` bearer credential a node authenticates
// with), and the `Job.claimedByNode` relation deferred by #255 (see the
// block comment above the `Job` model, "claimedByNodeId"). The service that
// mints/validates `NodeCredential` tokens, the `/api/node-credentials`
// endpoints, and the `Bearer nod_` branch in `jwt-auth.guard.ts` all arrive
// in the same issue's backend half; the register/heartbeat/claim control
// plane that actually populates and mutates `WorkerNode` rows is #268. What
// is here is deliberately complete on its own for that later work: every
// column and index the control plane needs already exists, so #268 requires
// no follow-up migration to either table.
//
// -----------------------------------------------------------------------------
// Why a `NodeCredential` distinct from `PersonalAccessToken`, not a reused PAT
// -----------------------------------------------------------------------------
// A worker node runs unattended for months on a machine its operator may not
// tightly control. A leaked PAT carries its owning user's FULL authority —
// admin routes included, if the owner is an admin. A node only ever needs to
// talk to `/api/nodes/*` (enforced by a route allowlist in the guard, not by
// this schema), so its credential is a distinct token family precisely so a
// leak's blast radius is confined to that allowlist even for an admin owner.
// `NodeCredential` mirrors `PersonalAccessToken`'s shape — same hash/prefix
// pattern, same show-once-in-full contract — MINUS the duration bookkeeping;
// see the block comment on `NodeCredential.expiresAt` below for why that one
// column is deliberately not carried over.
model WorkerNode {
  id String @id @default(uuid()) @db.Uuid

  name String

  // Self-reported identity, refreshed on every successful register/reattach
  // and heartbeat (#268) — none of these three are queried on individually,
  // they exist for the fleet page and for operators diagnosing "which
  // process is this row". Not part of any uniqueness: a node can rename its
  // hostname or upgrade its CLI without becoming a different node, because
  // identity is `(createdById, name)`, not any of these.
  hostname   String
  platform   String
  cliVersion String @map("cli_version")

  // The handler `type` keys (see `Job.type`'s own comment for why that column
  // is a plain string, not an enum) this node is willing to claim. #268's
  // claim endpoint INTERSECTS a request's requested types with this list — a
  // node can only ever narrow what it claims, never broaden it beyond what it
  // last declared itself capable of running.
  eligibleTypes String[] @map("eligible_types")

  // The node's own claimed concurrency ceiling, read LIVE by #268's claim
  // endpoint (not cached at claim time) so a runtime `node set-concurrency`
  // call from the CLI takes effect on the very next claim without a
  // re-register.
  concurrency Int

  // Operator/administrative state, NOT liveness — a node can be `online` and
  // still be silently dead; that question is answered by comparing
  // `lastHeartbeatAt` against the heartbeat interval, elsewhere (#270's fleet
  // cron), not by this column. `disabled` is the operator-driven kill switch
  // (refuse this node's claims regardless of what it reports); `draining` is
  // "finish what you're holding, claim nothing new" — both are decisions a
  // human or #270's lifecycle cron makes, not facts the node reports about
  // itself.
  status NodeStatus @default(offline)

  // The node's last self-reported capability summary (CPU/RAM, GPU
  // presence, disk headroom, ... — the exact shape is #268/#276's to define,
  // not this schema's) from register or heartbeat. JSONB, not typed columns,
  // for the same reason `Job.payload` is JSONB: this is opaque, evolving,
  // node-supplied data that no query here needs to filter or index on —
  // it exists for the fleet page to display, not for this table to reason
  // about. Nullable: a node that has never heartbeated has reported nothing
  // yet.
  capabilities Json? @db.JsonB

  // When this row was first created (register), vs. `lastHeartbeatAt` below
  // which moves on every liveness ping. Distinct on purpose: "how long has
  // this node existed" and "is it still alive" are different questions, and
  // collapsing them into one timestamp would lose the first once the second
  // starts moving.
  registeredAt DateTime @default(now()) @map("registered_at") @db.Timestamptz

  // NULL until the first heartbeat. #270's liveness/prune cron reads this to
  // decide a node has gone dark; #268's lease reaper reads `Job
  // .leaseExpiresAt` for the same question about an individual claim — the
  // two are deliberately independent so a node with no jobs currently
  // claimed still shows up as stale when it stops heartbeating.
  lastHeartbeatAt DateTime? @map("last_heartbeat_at") @db.Timestamptz

  // The user who registered this node — see the long comment below for why
  // this is required (not nullable) and `onDelete: Cascade`.
  createdById String @map("created_by_id") @db.Uuid

  // Relations
  //
  // -----------------------------------------------------------------------------
  // createdBy — onDelete: Cascade, and `createdById` stays required
  // -----------------------------------------------------------------------------
  // This is NOT the audit-trail pattern this schema uses elsewhere
  // (`AuditEvent.actorUserId`, `Credential.updatedByUser`,
  // `NotificationDelivery.user` — all `SetNull`, all deliberately preserving a
  // history record after its actor is gone). A `WorkerNode` is closer to
  // `PushSubscription`: a LIVE registration with no standalone value once its
  // owner is gone, not a record of a past event. Concretely:
  //
  //   1. `NodeCredential.user` is `onDelete: Cascade` (mirroring
  //      `PersonalAccessToken`, per this table's own design above) — so
  //      deleting the owning user ALREADY destroys every credential that
  //      could ever authenticate as this node. A `WorkerNode` row surviving
  //      its owner would be permanently unauthenticatable inventory: no
  //      token can ever heartbeat, claim, or deregister it again.
  //   2. `assertOwnership` (#268) is `node.createdById === callerId` with no
  //      concept of "unowned" — a `SetNull`'d, ownerless node could not be
  //      managed (deregistered, disabled, viewed via `GET /nodes`) by
  //      anyone, ever, through the API this issue's sibling adds. It would
  //      sit as a permanently orphaned row no admin surface reaches.
  //   3. `@@unique([createdById, name])` below is #268's register-or-reattach
  //      anchor. Keeping `createdById` NOT NULL keeps that constraint doing
  //      real work: two different (deleted-owner) nodes could otherwise both
  //      carry `createdById: null` with the same `name` and NOT collide
  //      (Postgres does not treat two NULLs as equal for uniqueness) — a
  //      silent hole in the exact invariant #268 depends on "existing
  //      exactly this way" for.
  //
  // Cascade does not touch job HISTORY: `Job.claimedByNode` is its own
  // separate `onDelete: SetNull` (see the block comment above the `Job`
  // model), so a cascaded `WorkerNode` deletion still only nulls out
  // `claimedByNodeId` on whatever it was holding — it never deletes a `Job`
  // row. Losing the fleet-inventory row (hostname, platform, capabilities
  // history) when its owner's account is gone is an acceptable, even
  // correct, cleanup; losing job history is not, and nothing here does that.
  createdBy User @relation("UserWorkerNodes", fields: [createdById], references: [id], onDelete: Cascade)

  // The jobs this node currently holds or has ever held. See `Job
  // .claimedByNode`'s own comment for the `onDelete: SetNull` that keeps
  // this list from ever forcing a `Job` deletion.
  claimedJobs Job[] @relation("NodeClaimedJobs")

  // THE register-or-reattach anchor (#268's own words: "existing exactly
  // this way"). A node identifies itself to `/nodes/register` by
  // `(callerId, name)`; this is what lets that endpoint find-or-create
  // instead of always inserting, so a restarted container reattaches to its
  // existing row (refreshing hostname/platform/cliVersion/eligibleTypes/
  // concurrency and flipping back to `online`) rather than leaking a new
  // node row on every restart. `name` is caller-chosen precisely so one
  // user can register many distinctly-named nodes while each individual
  // name stays idempotent for them.
  @@unique([createdById, name])
  // "Every online/draining/offline/disabled node" — the fleet page's own
  // primary filter, and what #270's lifecycle cron scans to find nodes to
  // act on.
  @@index([status])
  // "This user's own nodes" — backs `GET /nodes` (#268: "the caller's own
  // nodes") and the ownership check inside `assertOwnership`, in addition to
  // already being the left half of the composite unique index above.
  @@index([createdById])
  @@map("worker_nodes")
}

enum NodeStatus {
  online
  draining
  offline
  disabled
}

// -----------------------------------------------------------------------------
// NodeCredential — mirrors PersonalAccessToken minus the duration bookkeeping
// -----------------------------------------------------------------------------
// Same token lifecycle as `PersonalAccessToken` (`pat.service.ts` is the
// documented model for `NodeCredentialService`): a `nod_`-prefixed token is
// minted, hashed with sha256 into `tokenHash`, a short `tokenPrefix` is kept
// for display, and the raw value is shown exactly once. `validateToken`
// rejects an unknown hash, a `revokedAt`, an expired `expiresAt`, or an
// inactive owning user, then stamps `lastUsedAt` fire-and-forget — all of
// that is `NodeCredentialService`'s job (#267's backend half), not this
// schema's; this model exists to make those checks possible.
//
// -----------------------------------------------------------------------------
// expiresAt — nullable here, REQUIRED on PersonalAccessToken. This is the one
// deliberate divergence from the PAT shape, and it is worth writing out why.
// -----------------------------------------------------------------------------
// A PAT is typically minted for a person's own convenience (the CLI, a
// script they wrote) and a forced expiry is a reasonable default nudge
// toward rotation — a human is around to notice it expired and mint a new
// one. A `NodeCredential` authenticates a worker node that is expected to
// run UNATTENDED FOR MONTHS: a spare box, a container in someone else's
// cluster, a machine nobody is watching a dashboard for. If that credential
// had a mandatory expiry the way a PAT does, the failure mode is an entire
// fleet going dark at 3am because a timer nobody scheduled fired — the
// worker can't heartbeat, can't claim, can't report results, and the first
// anyone learns of it is jobs silently piling up unclaimed. That is a WORSE
// failure than a long-lived credential, because the credential's blast
// radius is already confined to `/api/nodes/*` by the guard's route
// allowlist (issue #267) even if it leaks — the thing a mandatory expiry on
// a PAT protects against (a leaked token with the owner's full authority)
// simply does not apply here to the same degree. So `expiresAt` is nullable
// and NULL is a real, supported, expected value meaning "never expires,
// authenticate indefinitely until revoked" — not "not yet set". Revocation
// (`revokedAt`) is the actual control for a node credential, and it is
// immediate: an operator who needs to cut a node off does so by revoking,
// not by waiting for a clock. An operator who DOES want an expiring node
// credential can still set one; the column supports it, it is just not
// forced.
model NodeCredential {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  // Operator-chosen label ("prod-worker-1", "gpu-box-3"), shown alongside
  // `tokenPrefix` in list views — same role as `PersonalAccessToken.name`.
  name String

  // sha256 hash of the full `nod_...` token; the only form of the token this
  // table ever stores. Never the plaintext — see `NodeCredentialService
  // .validateToken`'s own documentation for the lookup this backs.
  tokenHash String @unique @map("token_hash")

  // Short, non-secret display fragment (e.g. the first several characters
  // after `nod_`) so an operator can tell two credentials apart in a list
  // without either one's full value ever being shown again after creation.
  tokenPrefix String @map("token_prefix")

  // See the block comment above for why this is nullable, unlike
  // `PersonalAccessToken.expiresAt` which is required. NULL = never expires.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  // Stamped fire-and-forget by `validateToken` on each successful
  // authentication — the operator-facing answer to "is this node actually
  // still using this credential, or is it dead and safe to revoke".
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // NULL means active. Set once, never cleared — revocation is a one-way
  // door, matching `PersonalAccessToken.revokedAt` and `RefreshToken
  // .revokedAt` elsewhere in this schema. Revocation is immediate: the
  // block comment above explains why this, not a clock, is the real control
  // for a node credential.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  // Relations
  //
  // onDelete: Cascade, matching `PersonalAccessToken.user` exactly (per
  // issue #267's own instruction) and for the identical reason: a node
  // credential is a live, personal authentication artifact with no
  // standalone value once its owning account is gone — there is no one left
  // to authorize a node acting on this user's behalf, and no audit value in
  // keeping hashed token material around for an account that no longer
  // exists. See `WorkerNode.createdBy`'s own comment above for how this
  // Cascade is part of the same reasoning that made `WorkerNode.createdBy`
  // Cascade too: the two tables are designed to disappear together.
  user User @relation("UserNodeCredentials", fields: [userId], references: [id], onDelete: Cascade)

  // "This user's own credentials" — backs `GET /api/node-credentials`
  // (#267's list endpoint), matching `PersonalAccessToken`'s own
  // `@@index([userId])` for the identical query shape.
  @@index([userId])
  @@map("node_credentials")
}

// =============================================================================
// Database Backup Runs (issue #281, epic #254)
// =============================================================================
//
// One row per attempt to dump this deployment's PostgreSQL database into
// object storage — and, from Phase 7 onwards, per attempt to restore FROM one.
// `DatabaseBackupRunnerService` (`src/db-backup/db-backup-runner.service.ts`)
// is the only writer of the backup half; the columns in the restore-audit
// group are declared here now and written by #285.
//
// -----------------------------------------------------------------------------
// ### Why this WAS not a queue job, and why it now is (issue #351, epic #345)
// -----------------------------------------------------------------------------
//
// ⚠ THIS SECTION USED TO SAY "DO NOT MIGRATE THIS ONTO THE QUEUE". It has
// been migrated, deliberately, and the history is kept because the three
// objections were correct and a reader needs to know WHERE EACH IS NOW
// ANSWERED rather than assume they were waved away.
//
//   1. `jobs.stuckThresholdMinutes` DEFAULTS TO 30 MINUTES. A dump of a real
//      production database routinely runs longer than that. The lease reaper
//      (`JobStuckResetTask`) would see a `running` job whose lease had
//      expired, conclude its executor had died, and RESET IT TO `pending` —
//      while `pg_dump` was still streaming. The next claim starts a SECOND
//      `pg_dump`, writing to the SAME derived storage key as the first, and
//      two processes interleave their output into one object.
//      → ANSWERED BY #346's PER-TYPE PROFILES. `db.backup.run` declares
//      `maxRuntimeMs: 6h`, and the claim's lease is DERIVED from that ceiling
//      (`resolveJobLeaseMs`), never declared beside it — so a lease shorter
//      than the permitted runtime is unrepresentable rather than merely
//      avoided.
//   2. THE IN-PROCESS WORKER HAS NO LEASE-RENEWAL PATH. `JobWorker` claimed
//      with a lease and never extended it, so the reaper's verdict above was
//      not a rare race but unconditional for any long job.
//      → ANSWERED BY #347. The worker renews on a ticker (lease ÷ 3) for
//      exactly as long as `process()` runs.
//   3. A JOB HAS `attempts` AND A RETRY BUDGET. Automatically re-running a
//      failed multi-gigabyte dump is exactly the wrong behaviour: it burns
//      hours of I/O on a database that is probably already unwell, and the
//      correct retry for a backup is "the next scheduled one", tomorrow.
//      → ANSWERED BY `maxAttempts: 1` on the same profile. The policy did not
//      change; what changed is that `JobStuckService`'s give-up phase now
//      ENFORCES it, instead of it holding by the accident of there being no
//      queue to disagree.
//
// This table still has its OWN heartbeat (`lastHeartbeatAt`, written every
// ~20s with live `bytesWritten`), its OWN staleness policy
// (`databaseBackup.runStaleMinutes`) and its OWN terminal states, and all
// three are still load-bearing — but their jobs have narrowed. The heartbeat
// is now PROGRESS REPORTING for the UI (the lease is the liveness signal),
// and the stale sweep is the backstop for the one path that still has no job:
// the `pre_restore` safety dump, which `DatabaseRestoreService` takes through
// `startBackup` because a restore must not wait on a worker slot.
//
// ⚠ THE TWO ROWS ARE NOT REDUNDANT. The `jobs` row answers who asked, when,
// which executor, which attempt and what error; this row answers what was
// PRODUCED — key, bucket, bytes, checksum, `verifiedAt`, the db/app/migration
// audit and the restore audit. They also have independent lifetimes: a job is
// purged by `job.history.purge` on a retention schedule that has nothing to do
// with how long the archive is kept, which is exactly why `jobId` is
// `onDelete: SetNull` and not `Cascade`.
//
// -----------------------------------------------------------------------------
// THE SINGLE-ACTIVE-RUN GUARD IS A PARTIAL UNIQUE INDEX, NOT APPLICATION CODE
// -----------------------------------------------------------------------------
//
// `database_backup_runs_active_uniq_idx` (hand-written in
// `prisma/migrations/20260907120000_add_database_backup_runs/migration.sql`,
// TIGHTENED by
// `prisma/migrations/<add_backup_run_job_link>/migration.sql`, epic #345,
// issue #351 — see that migration's own header for why) is a UNIQUE index on
// the CONSTANT EXPRESSION `(true)` restricted to `status IN
// ('pending','running')`. It is what makes "at most one backup at a time"
// true ACROSS REPLICAS.
//
// REJECTED: a `findFirst({ where: { status: 'running' } })` before the insert.
// It is a check-then-act race, and it is racy exactly when it matters — a
// scheduled tick on replica A and an admin's manual click on replica B, in
// the same second. Both would see no active run, both would insert, and two
// `pg_dump` processes would stream into two objects while the settings say
// one backup a night. Only the database can make "is one already active"
// atomic with the insert that would violate it.
//
// The loser's Prisma `P2002` becomes a typed `DatabaseBackupAlreadyRunningError`
// carrying the winner's run id, which #282/#283 turn into a 409.
//
// ⚠ PRISMA CANNOT EXPRESS THIS INDEX — INTENTIONAL SCHEMA DRIFT. The schema
// language has no syntax for a partial index OR an expression index, exactly
// as recorded above the `Job` model for `jobs_active_dedup_uniq_idx` and its
// two siblings. So `prisma migrate dev`/`diff` will not regenerate it and, if
// anyone diffs this schema against a live database, will want to DROP it.
// That drift is deliberate and permanent: do not "fix" it, and do not try to
// force it into `@@unique` syntax that does not exist. The migration file
// carries the same warning next to the statement itself.
//
// ⚠ WHAT THE INDEX ADMITS, PRECISELY, AND WHY THAT CHANGED. The ORIGINAL index
// keyed on the `status` COLUMN, filtered to two values — that admits at most
// one `pending` row AND at most one `running` row AT THE SAME TIME, i.e. TWO
// active runs, not one. That was harmless only as long as
// `DatabaseBackupRunnerService` inserted its claim directly as `running` and
// never wrote `pending`. #351 makes the backup a queue job: `POST
// /api/admin/db-backup/runs` now enqueues the job and creates the run row in
// `pending` BEFORE any worker has claimed it (so the endpoint can return a run
// id immediately and `GET /runs/{id}` keeps working), and the handler flips it
// to `running` once claimed. The moment `pending` rows are real, the
// column-keyed index stops meaning "at most one active run" and starts
// meaning "at most two". Keying on `(true)` instead makes every active row —
// whichever of the two statuses it holds — index to the SAME key, so at most
// one can exist across both statuses COMBINED. This is the exact tightening
// this comment always said a future path needing both states populated at
// once would require ("tighten this index to a constant expression, never
// move the guard into a service") — it has now happened.
//
// -----------------------------------------------------------------------------
// WHY THE RESTORE AUDIT LIVES ON THE BACKUP'S OWN ROW
// -----------------------------------------------------------------------------
//
// `restoreStatus`, `restoreError`, `restoredAt`, `restoredById`,
// `restoreScratchDb`, `restoreOldDb`, `swappedAt` and `preRestoreBackupId` are
// all nullable and all belong to Phase 7. They are columns on THIS table
// rather than a `database_restore_runs` table because A RESTORE IS ALWAYS
// DEFINED IN TERMS OF EXACTLY ONE BACKUP: there is no restore without an
// archive to restore, no archive is restored twice concurrently, and every
// question anyone asks about a restore ("which dump was this?", "how big was
// it?", "what migration was the schema on?") is answered by the backup's own
// columns. A separate table would buy a join on a strict 1:1 relationship and
// would let the two rows disagree about which archive was replayed.
//
// The cost is honest: a backup restored twice (a restore that failed, then
// retried) overwrites the first attempt's audit fields. That is the correct
// trade — the interesting record is the state of the LAST restore, and the
// full history of attempts is in `audit_events`.
//
// `preRestoreBackupId` is a SELF-FK: before a restore swaps a database away,
// #285 takes a `pre_restore` backup, and this column points the restore at the
// safety net it took. `onDelete: SetNull`, so pruning that safety backup by
// retention never deletes the restore record that referenced it.
model DatabaseBackupRun {
  id String @id @default(uuid()) @db.Uuid

  // The `jobs` row that drove this run, once the dump became a queue job
  // (`db.backup.run`, epic #345, issue #351). Three properties, each
  // load-bearing:
  //
  //   1. `@unique` is what makes a SECOND run row for one job
  //      UNREPRESENTABLE. #348 lets a handler derive its own node upload
  //      key, and a node may legitimately ask for that key twice (a
  //      timed-out transfer, a lost response, a restarted process still
  //      holding the lease). The backup's `deriveOutputKey` re-reads by
  //      `jobId` and returns the existing key; the unique index is what
  //      GUARANTEES there is at most one to find, rather than that being a
  //      convention the service has to remember.
  //
  //   2. Nullable, ON PURPOSE. Not every run has a job: the `pre_restore`
  //      dump `DatabaseRestoreService` takes goes through the runner
  //      directly, with no job in between, and rows predating this
  //      migration have no job at all. A required column would either break
  //      the restore path or need a backfill that invents job rows for
  //      history.
  //
  //   3. `onDelete: SetNull`, NOT `Cascade`. `job.history.purge` deletes
  //      `jobs` rows on a retention schedule that is completely independent
  //      of the archive retention. Cascade would let a routine history purge
  //      delete the record of a backup whose archive is still in the bucket
  //      and still restorable — the exact "deleting history must not delete
  //      history" hazard `JobStatsRollup` already exists to avoid on the
  //      stats side. Losing the LINK is acceptable; losing the RUN ROW is
  //      not.
  jobId String? @unique @map("job_id") @db.Uuid
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  // `pending` = claimed, dump not yet spawned. `running` = a `pg_dump` is
  // streaming. `completed` = uploaded AND verified (see `verifiedAt`).
  // `failed` = terminal, `lastError` says why. `stale` = the run's heartbeat
  // stopped for longer than `databaseBackup.runStaleMinutes` and #282's sweep
  // gave up on it — DISTINCT from `failed` on purpose, because nothing
  // observed this run fail; the process holding it disappeared, and an
  // operator reading the list needs to be able to tell "the dump errored"
  // from "the container went away mid-dump".
  status DatabaseBackupStatus @default(pending)

  // `manual` = an administrator clicked. `scheduled` = #282's cron.
  // `pre_restore` = the safety backup #285 takes immediately before swapping
  // a restored database into place. No default: a run with no known origin is
  // a run nobody can attribute, and every caller knows which it is.
  trigger DatabaseBackupTrigger

  // NULL until the dump is claimed / until it settles. `lastHeartbeatAt` is
  // now PROGRESS REPORTING for the UI rather than this table's liveness
  // signal — the job's LEASE is the liveness signal since #351/#352 — see the
  // "Why this WAS not a queue job, and why it now is" block above.
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz
  lastHeartbeatAt DateTime? @map("last_heartbeat_at") @db.Timestamptz

  // BigInt, both of them, and NOT `Int`. A PostgreSQL dump crossing 2 GiB is
  // ordinary, and `Int` is a signed 32-bit column that overflows at 2147483647
  // bytes — the failure would be a write error on the LARGEST backups, i.e.
  // exactly the deployments this feature exists for, and it would surface as
  // a failed run rather than as a wrong number.
  //
  // ⚠ A `BigInt` field is the JS `bigint` primitive, which `JSON.stringify`
  // REFUSES to serialise. #283's response DTO must convert these two to
  // `string` (or `Number`) explicitly — see the note above `JobStatsRollup`
  // for the same hazard, decided the other way there because that column is a
  // running average and this one is a byte count that must stay exact.
  //
  // `bytesWritten` is LIVE PROGRESS, rewritten by the heartbeat while the dump
  // streams; `sizeBytes` is the final size, written once at completion. They
  // converge on success and deliberately do not on a failure, where the
  // difference is "how far did it get".
  bytesWritten BigInt @default(0) @map("bytes_written")
  sizeBytes    BigInt @default(0) @map("size_bytes")

  // The storage triple: WHICH provider, WHICH key, WHICH bucket. All three
  // are recorded rather than derived on read, because all three can change
  // under a deployment (a bucket rename, a provider swap) and a backup that
  // cannot say where it was written is a backup nobody can restore. The key
  // is chosen by the SERVER (`buildBackupStorageKey`), never by a caller.
  storageProvider String @map("storage_provider")
  storageKey      String @map("storage_key")
  bucket          String

  // `pg_dump`'s archive format — `custom` (`-Fc`) for everything this
  // repository writes. Stored so a future format change does not make old
  // archives unreadable-by-inspection: `pg_restore` needs to know, and
  // guessing from the key's extension is not knowing.
  format String

  // sha256 of the archive, computed IN THE SAME SINGLE PASS as `sizeBytes`
  // while the bytes stream past on their way to storage — the archive is
  // never buffered and never read twice. NULL until the upload completes.
  checksumSha256 String? @map("checksum_sha256")

  // The audit quartet: what produced this archive. All four nullable because
  // each is read best-effort and NONE of them may fail a backup — a run that
  // could not read the server version is still a valid backup.
  //
  //   `dbVersion`     — the PostgreSQL server version this was dumped from.
  //                     A restore onto an older major will not work, and this
  //                     is the only place that fact is recorded.
  //   `appVersion`    — the application build (`resolveApiVersion()`).
  //   `migrationName` — the newest applied `_prisma_migrations` row. THE most
  //                     important of the four for a restore: it says which
  //                     schema the archive contains, so an operator can tell
  //                     before replaying it whether the running code will
  //                     understand what comes back.
  //   `pgDumpVersion` — the `pg_dump` client that WROTE the archive (#352,
  //                     epic #345). It was a trio until the dump could run on
  //                     a worker node: on that path the client is a binary on
  //                     a machine this deployment may not own and cannot
  //                     inspect, so unless the node reports it, nothing
  //                     anywhere records which `pg_dump` produced the file —
  //                     and a `pg_restore` older than the `pg_dump` that wrote
  //                     an archive simply cannot read it. The server path
  //                     fills the same column from its own image's client, so
  //                     the row means one thing whichever executor ran.
  dbVersion     String? @map("db_version")
  appVersion    String? @map("app_version")
  migrationName String? @map("migration_name")
  pgDumpVersion String? @map("pg_dump_version")

  // Set when the UPLOADED OBJECT was streamed back out of storage and read by
  // `pg_restore --list` with a non-empty table of contents. A run is never
  // `completed` without it: the checksum proves what we sent, this proves what
  // arrived is a readable archive.
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz

  lastError String? @map("last_error")

  // NULL for a `scheduled` run — nobody asked for it, a timer did. `SetNull`
  // rather than `Cascade`, matching `AuditEvent.actorUserId` and
  // `Credential.updatedByUser`: this is a HISTORY RECORD, and deleting an
  // administrator's account must never delete the record that a backup was
  // taken. Contrast `WorkerNode.createdBy`, which cascades because a node is
  // live inventory rather than history.
  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("UserDatabaseBackupRuns", fields: [createdById], references: [id], onDelete: SetNull)

  // ---------------------------------------------------------------------------
  // Restore audit (Phase 7). Declared by #281, written by #285's
  // `DatabaseRestoreService`. See the "WHY THE RESTORE AUDIT LIVES ON THE
  // BACKUP'S OWN ROW" block above.
  // ---------------------------------------------------------------------------

  // A plain string, not an enum, for the same reason `Job.executor` is one: a
  // small closed set owned by code rather than by this table's own state
  // machine, and adding a state to it must not cost a migration. NULL means
  // "this backup has never been restored".
  //
  // `restoring` -> `verifying` -> `swapping` -> `completed` | `failed`, plus
  // `rolled_back` for a restore that was swapped in and then undone. That last
  // one is the argument for the column being a string: it was added by #285
  // without a migration. The set lives in `RESTORE_STATUSES`
  // (`src/db-backup/database-restore.service.ts`).
  restoreStatus String? @map("restore_status")
  restoreError  String? @map("restore_error")

  restoredAt   DateTime? @map("restored_at") @db.Timestamptz
  restoredById String?   @map("restored_by_id") @db.Uuid
  restoredBy   User?     @relation("UserDatabaseRestores", fields: [restoredById], references: [id], onDelete: SetNull)

  // The names of the two databases a swap-style restore creates and displaces:
  // the scratch database the archive was replayed into, and the original that
  // was renamed out of the way. Recorded as NAMES because after the swap they
  // are the only handle an operator has on either — `databaseBackup
  // .restoreRollbackMode` decides whether the displaced one survives, and
  // `oldDatabaseRetentionHours` decides for how long.
  restoreScratchDb String?   @map("restore_scratch_db")
  restoreOldDb     String?   @map("restore_old_db")
  swappedAt        DateTime? @map("swapped_at") @db.Timestamptz

  // The `pre_restore` backup taken immediately before this row's archive was
  // swapped in — the way back. `SetNull` so retention pruning that safety
  // backup never deletes the restore record pointing at it.
  preRestoreBackupId String?             @map("pre_restore_backup_id") @db.Uuid
  preRestoreBackup   DatabaseBackupRun?  @relation("PreRestoreBackup", fields: [preRestoreBackupId], references: [id], onDelete: SetNull)
  // The back-reference Prisma requires for the self-relation above. Nothing
  // reads it today; it exists because a named relation needs both sides.
  restoresUsingThis  DatabaseBackupRun[] @relation("PreRestoreBackup")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // The queries #282 and #283 issue, and nothing speculative:
  //
  //   - the admin list and the retention sweep are both "newest first", which
  //     is `createdAt DESC`;
  //   - `startedAt DESC` answers "when did backups actually run", which is a
  //     different question from "when were they requested" for any run that
  //     waited or never started at all;
  //   - `[status]` backs the stale sweep (`status = 'running'`) and the
  //     active-run lookup that turns a P2002 into an id;
  //   - `[status, createdAt DESC]` is the retention query — "the completed
  //     runs, newest first, keep N" — which neither single-column index
  //     answers without a sort.
  @@index([createdAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@index([status])
  @@index([status, createdAt(sort: Desc)])
  @@map("database_backup_runs")
}

enum DatabaseBackupStatus {
  pending
  running
  completed
  failed
  stale
}

enum DatabaseBackupTrigger {
  manual
  scheduled
  pre_restore
}

// =============================================================================
// Job Node Secrets (issue #349, epic #345)
// =============================================================================
//
// THE AUDIT RECORD OF A CREDENTIAL A WORKER NODE ONCE HELD — and, precisely,
// NOT the credential. A node has no database access and no storage credentials
// by design (`docs/specs/worker-nodes.md` §8); epic #345 needs it to run work
// that genuinely requires one (a `pg_dump` needs a connection), so the server
// mints one per job, hands it over once, and destroys it on settlement. This
// table exists so that "which node held a credential to this deployment's
// database, of what kind, from when until when, and was it revoked" is a
// question with an answer.
//
// -----------------------------------------------------------------------------
// ⚠ THERE IS NO COLUMN HERE CAPABLE OF HOLDING SECRET MATERIAL, AND THERE MUST
// NEVER BE — NOT PLAINTEXT, NOT ENCRYPTED
// -----------------------------------------------------------------------------
//
// `handle` is an IDENTIFIER for the grant — a role name, a token id — and it is
// what `JobSecretBroker.revoke(handle)` takes. It is never the password. The
// material itself is serialised into exactly one HTTP response
// (`POST /api/nodes/:id/jobs/:jobId/secret`) and then dropped; nothing in this
// process, this database, or any backup of it retains a copy.
//
// REJECTED: an `encryptedMaterial` column, reusing `SECRETS_ENCRYPTION_KEY` the
// way the `credentials` table does. A credential that can be re-read is a
// credential that can be STOLEN TWICE, and nothing needs to re-read this one:
// the node received it once, and revocation is by handle rather than by
// presenting the secret back. `credentials` stores material because an SMTP
// password must be replayed on every send; a job credential must not be
// replayed at all. Storing it — even encrypted — would buy nothing and would
// put a live database password into this table, into every `pg_dump` of it,
// and into every copy of that dump, protected by a key that lives in the same
// deployment. That is the owner's rule for epic #345 expressed in schema rather
// than in a convention somebody can forget.
//
// -----------------------------------------------------------------------------
// `@@unique([jobId, kind])` — ONE CREDENTIAL PER JOB, EVER
// -----------------------------------------------------------------------------
//
// A node asks for its secret more than once as a matter of course: a process
// restarted while holding the lease, a response lost on the way back, a retry
// of the same job. Every one of those calls must land on the SAME grant,
// extended — never on a second one, because the revocation paths know exactly
// one handle per (job, kind) and a sibling grant would be one nothing ever
// destroys. The unique index makes the second row unrepresentable; the broker's
// own `issue` idempotence (see `job-secret-broker.ts`) is the other half.
//
// `@@index([expiresAt])` backs the sweeper, which scans unrevoked grants whose
// own clock has lapsed. See `NodeSecretBrokerService.sweep` for why the sweeper
// is NOT redundant with the settle-event revoker: three real cases emit no
// event at all.
//
// NO RELATIONS, DELIBERATELY. `jobId` and `nodeId` are plain UUID columns with
// no foreign key either way, for two reasons. `jobs` rows are deleted on a
// retention schedule (`job.history.purge`) that has nothing to do with a
// grant's lifetime, and a cascade from that purge would silently erase the
// audit record of a credential — which is the one thing this table is for. And
// a grant must stay revocable by handle after its job row is gone, which is
// why the sweeper resolves a broker by `kind` rather than by the job's `type`.
model JobNodeSecret {
  id String @id @default(uuid()) @db.Uuid

  jobId  String @map("job_id") @db.Uuid
  nodeId String @map("node_id") @db.Uuid

  // Which broker minted this — `JobSecretBroker.kind`, e.g.
  // `'postgres.readonly'`. Also how the revocation paths find their way back
  // to the broker that can destroy the grant. A plain string, not an enum, for
  // the same reason `Job.type` is: a fork's broker must cost zero migrations.
  kind String

  // The grant's identifier. ⚠ THE ROLE NAME. NEVER THE PASSWORD. See the block
  // comment above.
  handle String

  issuedAt  DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  // The credential's own backstop, bounded by the job's lease (never a second
  // clock of its own — see `JobSecretBroker.issue`). It is what makes a grant
  // worthless if BOTH revocation paths somehow miss it.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  // NULL means the grant is still live as far as this server knows. Set by
  // whichever revocation path got there first; both tolerate the other having
  // won.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  @@unique([jobId, kind])
  @@index([expiresAt])
  @@map("job_node_secrets")
}

// =============================================================================
// Transcripts (issue #24, epic #19) — docs/specs/transcription.md §3
// =============================================================================
//
// Six tables, all keyed to one `transcripts` row per uploaded recording. This
// issue adds only the schema — the upload/pipeline/editing/sharing/export
// logic that reads and writes it all arrives in issues #25–#29. What is here
// is deliberately complete on its own, mirroring the `jobs`/`worker_nodes`
// precedent of "the schema ships whole, ahead of the code that will use it,
// so nothing downstream needs a follow-up migration to these tables
// themselves." Every column, enum member and index below is named for and
// justified by docs/specs/transcription.md §1, §3, §4, §5, §6, §8 and §10 —
// read those sections for the full reasoning; this comment restates only
// what has to live beside the code to stay correct.
//
// -----------------------------------------------------------------------------
// Three status enums, not one — restated from spec §1.4
// -----------------------------------------------------------------------------
// `transcripts.status` (`TranscriptStatus`) is what every list view and every
// permission check reads. `transcriptionStatus` and `playbackStatus` are
// detail fields for the pipeline stepper (issue #30): the transcode and the
// transcription round trip run CONCURRENTLY, so a single top-level enum would
// need one member per combination of the two sub-pipelines' states and would
// still need a second field to say which failure belongs to which
// sub-pipeline. This is the same design `worker_nodes` already uses for its
// own health (`status` for stated intent, `lastHeartbeatAt` for computed
// liveness): small, independently updatable pieces of state, not one field
// pretending to be several.
//
// -----------------------------------------------------------------------------
// owner_id CASCADES; source_object_id (and every other storage_objects FK
// below) RESTRICTS — the same column shape, the opposite `onDelete`, because
// they answer opposite ownership questions
// -----------------------------------------------------------------------------
// `owner_id` points UP the ownership chain: a `transcripts` row's only reason
// to exist is that exactly one user owns it. This is the same "belongs
// entirely to this user" shape `user_settings`, `refresh_tokens`,
// `personal_access_tokens` and `device_codes` already use Cascade for — NOT
// the audit/history shape `AuditEvent.actorUserId`, `Credential
// .updatedByUserId` or `DatabaseBackupRun.createdById` use SetNull for. The
// difference is what the row IS: an audit row is a record of an act someone
// performed against shared infrastructure and must survive the actor's
// deletion to keep meaning; a transcript is not a record OF anything, it IS
// the private content itself, and this application's own access model (§6.1)
// has no path to it once its owner is gone — there is deliberately no
// `transcripts:read_any` (§6.2), so an owner-less transcript would be a row
// nobody, including an admin, could ever read, share, edit or delete again.
// Cascading it away when the account goes is the only outcome consistent
// with "no read-any, ever."
//
// `source_object_id` / `playback_object_id` / `raw_result_object_id` (below)
// and `transcript_versions.snapshot_object_id` / `transcript_exports
// .object_id` all point SIDEWAYS, across a module boundary, into a DIFFERENT
// feature's table (`storage_objects`, issue #21) that this feature does not
// own. Restrict here protects the referenced object FROM this table's own
// module boundary being crossed by someone else: a `storage_objects` row a
// transcript still needs may never be deleted out from under it by the
// generic storage endpoints or an unrelated cleanup sweep (the exact
// `managed_by` discipline spec §9.3 already gives every managed object). The
// only path that may ever remove one of these objects is `transcript.purge`
// (spec §1.5.7, §10) deleting the referencing row FIRST — which a Restrict
// FK permits freely, because Restrict blocks deleting the REFERENCED
// `storage_objects` row while a reference exists, not deleting the
// REFERENCING transcript row itself.
//
// ⚠ ONE CONSEQUENCE OF THAT PAIRING, STATED HONESTLY RATHER THAN PAPERED
// OVER: `owner_id`'s Cascade fires at the Postgres level on a raw user
// deletion and does not, and cannot, invoke `transcript.purge`'s storage and
// provider cleanup — a cascading DELETE only removes SQL rows, and Restrict
// on the sideways FKs means Postgres will not even attempt to touch the
// `storage_objects` rows those columns pointed at (a Restrict's ON DELETE
// action fires only when deleting the REFERENCED row, never when the
// referencing row disappears by any means, cascade included). A user
// deleted by a path other than the transcript's own `DELETE
// /api/transcripts/:id` → `transcript.purge` route therefore leaves that
// transcript's audio, rendition, raw result and export files as orphaned
// `storage_objects` rows — reclaimable, but not reclaimed by this cascade.
// This mirrors the same asymmetry already accepted for `WorkerNode
// .createdBy`'s Cascade (deleting the SQL row is not the same act as
// deleting the credential's real-world effects) and is exactly why spec §10
// frames `transcript.purge` as the only complete-deletion path — a future
// issue that adds account deletion as a first-class flow should route it
// through that job rather than a bare `prisma.user.delete()`. This is a
// decision made explicitly for issue #24, not an oversight; #25–#29 are the
// right place to close it if account deletion becomes a real user-facing
// flow.
//
// -----------------------------------------------------------------------------
// speaker_id on transcript_segments — also Restrict, for a same-feature
// reason rather than a cross-module one
// -----------------------------------------------------------------------------
// Unlike the storage FKs above, this Restrict is WITHIN the transcript
// feature: a speaker may not be deleted while any segment still names it.
// `speaker.merge` (spec §4.1) is the only op that ever deletes a speaker, and
// it re-points every one of that speaker's segments to the merge target
// FIRST, in the same transaction, before deleting the source speaker rows —
// exactly the shape Restrict requires and enforces. A hypothetical direct
// "delete this speaker" operation with segments still attached is therefore
// unrepresentable at the database level, not merely disallowed by service
// code that could have a bug.
//
// -----------------------------------------------------------------------------
// Hand-written, Prisma-inexpressible constraints — INTENTIONAL SCHEMA DRIFT,
// the same pattern `jobs_active_dedup_uniq_idx` / `database_backup_runs
// _active_uniq_idx` already establish
// -----------------------------------------------------------------------------
// `transcript_speakers_transcript_id_label_key`, declared only in this
// migration's `migration.sql`, not as a `@@unique` here: a provider-supplied
// `label` (e.g. `"A"`) must be unique per transcript, but a user-created
// speaker (`speaker.create`, spec §4.1) legitimately has none, and Prisma's
// `@@index`/`@@unique` DSL has no syntax for the partial index's `WHERE
// "label" IS NOT NULL` clause that scopes the constraint to labelled rows.
// See that migration file's own header for the full accounting. Every OTHER
// uniqueness constraint below (`transcript_versions` on `(transcriptId,
// version)` and `(transcriptId, clientBatchId)`, `transcript_shares` on
// `(transcriptId, userId)`) is fully expressible as a plain `@@unique` and is
// declared that way — Postgres's standard "NULLS DISTINCT" behaviour already
// gives `clientBatchId` exactly the semantics spec §5 wants (many versions
// with a null `clientBatchId`, at most one per transcript for any given
// non-null value) with no partial index required.
// =============================================================================

enum TranscriptStatus {
  uploading
  processing
  ready
  failed
  deleting
}

enum TranscriptionStatus {
  waiting_input
  queued
  submitting
  submitted
  processing
  completed
  failed
  cancelled
}

enum PlaybackStatus {
  pending
  processing
  ready
  failed
  not_needed
}

model Transcript {
  id String @id @default(uuid()) @db.Uuid

  ownerId  String  @map("owner_id") @db.Uuid
  title    String
  language String?

  status              TranscriptStatus    @default(uploading)
  transcriptionStatus TranscriptionStatus @default(waiting_input) @map("transcription_status")
  playbackStatus      PlaybackStatus      @default(pending) @map("playback_status")

  // The storage triple. See the block comment above for why every one of
  // these three is `onDelete: Restrict`, and why that is the opposite choice
  // from `ownerId` just above despite the same `String @db.Uuid` shape.
  sourceObjectId    String  @map("source_object_id") @db.Uuid
  playbackObjectId  String? @map("playback_object_id") @db.Uuid
  rawResultObjectId String? @map("raw_result_object_id") @db.Uuid

  // Which `TranscriptionProvider` (spec §2.1) this transcript was submitted
  // to, and that provider's own job id once submitted. Plain strings, not an
  // enum/FK — the provider registry is code-owned and open (a future
  // provider is one new class, per spec §2.1), the same reasoning `Job.type`
  // and `storage_objects.managed_by` already use for an open, code-owned set.
  provider        String
  providerJobId   String? @map("provider_job_id")
  // `{ speakersExpected?, language? }` (spec §2.1/§3.1) — the per-transcript
  // overrides a submitter chose, opaque JSONB for the same reason every
  // other provider-shaped payload in this schema (`Job.payload`) is: a
  // provider-specific option set must not force a migration per provider.
  providerOptions Json?   @map("provider_options") @db.JsonB

  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz
  lastPolledAt    DateTime? @map("last_polled_at") @db.Timestamptz
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  // Set once `provider.deleteRemote` succeeds (spec §1.5.2–4, §10) — either
  // right after `transcription.ingest` commits (the default,
  // `deleteRemoteAfterIngest: true`) or by `transcript.purge` if it had not
  // happened yet. NULL means the provider may still hold a copy.
  remoteDeletedAt DateTime? @map("remote_deleted_at") @db.Timestamptz
  // Set when `DELETE /api/transcripts/:id` moves this row to `deleting`
  // (spec §1.1) — i.e. WHEN REMOVAL WAS REQUESTED, not when it finished:
  // spec §10 is explicit that `transcript.purge` deletes the SQL row once it
  // is done ("only then deletes the SQL rows"), and the `TranscriptStatus`
  // enum has no terminal `deleted` member for a finished purge to move to.
  // This column therefore answers "how long has this been in `deleting`" —
  // the same question `database_backup_runs.lastHeartbeatAt` answers for a
  // running dump — for as long as the row exists to ask it of; it never
  // survives to describe a completed deletion, because nothing does.
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  // When the recording was made — defaults to the upload instant; the Meeting
  // date the knowledge graph reads (docs/specs/ontology.md §5.4). Issue #352:
  // backfilled from `created_at`, and `TranscriptsService.create` stamps it
  // with the same `Date` instance as `createdAt`. Editable by the owner or an
  // editor through `PATCH /api/transcripts/:id`; not versioned, like `title`.
  recordedAt      DateTime  @default(now()) @map("recorded_at") @db.Timestamptz

  durationMs     Int?    @map("duration_ms")
  failureReason  String? @map("failure_reason")
  // Bumped by the SAME conditional `UPDATE ... WHERE current_version = $n`
  // spec §5 describes for the batch-save race — 0 until `transcription
  // .ingest` writes version 1 inside its own transaction (spec §1.5.4).
  currentVersion Int     @default(0) @map("current_version")
  // Denormalized off `transcript_speakers`/`transcript_segments` so a list
  // view never joins and counts on every row, matching the "cheap to read
  // often, recomputed by the one write path that changes the true count"
  // shape `worker_nodes` and `job_stats_rollup` already use for their own
  // derived numbers elsewhere in this schema.
  speakerCount   Int     @default(0) @map("speaker_count")
  wordCount      Int     @default(0) @map("word_count")

  // A map `speakerId → displayName` recording the first time a user named an
  // AI-detected speaker (e.g. "Speaker A" -> "Oscar") — issue #323. That
  // naming is an IDENTIFICATION, metadata about the recording like `title`,
  // not a correction to its content, so it is deliberately NOT versioned:
  // `materialize()` overlays this map onto any speaker still at its ingest
  // default name (`Speaker <label>`) at ANY version, the same way a rename
  // applies uniformly regardless of which version is being viewed. Keys are
  // speaker ids with no FK — an entry for a speaker later merged or deleted
  // is simply ignored on overlay, which is harmless and needs no cleanup.
  speakerIdentities Json @default("{}") @map("speaker_identities") @db.JsonB

  // GENERATED ALWAYS AS (to_tsvector('english'::regconfig, coalesce(title,
  // ''))) STORED, plus a GIN index — issue #174, epic #164. Hand-written in
  // `20260915120000_add_search_vectors/migration.sql` (Prisma has no DSL for
  // a generated column's expression or an index's access method); see that
  // migration's header for the full argument, including why it is its OWN
  // column rather than folded into `TranscriptSegment.searchVector` (a
  // title match must surface a transcript with no matching segment at all)
  // and why the two-argument `to_tsvector` form is required (IMMUTABLE,
  // unlike the one-argument form). `Unsupported` and nullable-optional even
  // though the database column is generation-populated on every row —
  // Prisma has no syntax for "the database writes this," and an
  // `Unsupported` field is never selectable or writable through the client
  // regardless: every read of this column goes through raw SQL, by design.
  titleSearchVector Unsupported("tsvector")? @map("title_search_vector")

  owner           User           @relation("TranscriptOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sourceObject    StorageObject  @relation("TranscriptSourceObject", fields: [sourceObjectId], references: [id], onDelete: Restrict)
  playbackObject  StorageObject? @relation("TranscriptPlaybackObject", fields: [playbackObjectId], references: [id], onDelete: Restrict)
  rawResultObject StorageObject? @relation("TranscriptRawResultObject", fields: [rawResultObjectId], references: [id], onDelete: Restrict)

  speakers      TranscriptSpeaker[]
  segments      TranscriptSegment[]
  versions      TranscriptVersion[]
  shares        TranscriptShare[]
  exports       TranscriptExport[]
  // Every note that named this transcript as its source (issue #48, epic
  // #45) — Restrict on `notes.source_transcript_id`, so a transcript with a
  // dependent note cannot be deleted until `notes.service.ts`'s own delete
  // guard clears it. See the block comment above the `Note` model.
  notesAsSource Note[]                @relation("NoteSourceTranscript")
  // AI name-check runs against this transcript (issue #328, epic #326). See
  // the block comment above the `TranscriptNameCheck` model.
  nameChecks    TranscriptNameCheck[]

  // Connected Knowledge (epic #344, issue #351). Both SetNull: an evidence
  // row is a citation that survives losing what it points to (`quote` is
  // what keeps it readable — see the block comment above `KgEvidence`), and
  // a mention Cascades instead (see the block comment above `KgMention`).
  kgEvidence KgEvidence[]
  kgMentions KgMention[]

  // "This owner's transcripts, newest first" — the transcript list view.
  @@index([ownerId, updatedAt(sort: Desc)])
  // "This owner's transcripts by when they were recorded" (issue #352).
  @@index([ownerId, recordedAt(sort: Desc)])
  // "Every transcript in state X" — `transcripts.housekeeping`'s scans
  // (spec §1.5.8) and any future admin-adjacent health check.
  @@index([status])
  @@map("transcripts")
}

model TranscriptSpeaker {
  id           String @id @default(uuid()) @db.Uuid
  transcriptId String @map("transcript_id") @db.Uuid

  // The provider's own diarization label (e.g. `"A"`). NULL for a speaker a
  // user created directly (`speaker.create`, spec §4.1), which has none.
  // Unique per transcript AMONG LABELLED ROWS ONLY — see the block comment
  // above the enums for why that constraint is hand-written in
  // `migration.sql` rather than a `@@unique` here.
  label       String?
  displayName String  @map("display_name")
  colorIndex  Int     @map("color_index")
  // Optimistic-concurrency counter (spec §5). Starts at 1 — the row's first
  // write (ingest, or `speaker.create`) is already its first version.
  rev         Int     @default(1)

  transcript Transcript          @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  segments   TranscriptSegment[]

  // Connected Knowledge (epic #344, issue #351). The `IDENTIFIED_AS` edge a
  // diarized speaker gets linked to a real entity through — Cascade, so a
  // deleted (merged-away) speaker's link goes with it. See the block
  // comment above `KgRelation` for why this is a real FK to a speaker
  // rather than a polymorphic `from_kind`/`from_id` pair.
  kgRelationsAsSpeaker KgRelation[]

  @@map("transcript_speakers")
}

enum WordsAlignment {
  exact
  interpolated
  none
}

enum SegmentOrigin {
  ai
  user
}

model TranscriptSegment {
  // STABLE ACROSS EDITS (spec §3.5, §4.1's `segment.split` test vector): a
  // split keeps this id on the earlier half specifically so a bookmark, an
  // export reference, or a concurrent editor's stale `rev` for this segment
  // still names something real.
  id           String @id @default(uuid()) @db.Uuid
  transcriptId String @map("transcript_id") @db.Uuid
  // Restrict, not Cascade or SetNull — see the block comment above the
  // enums: a speaker may not be deleted while a segment still names it;
  // `speaker.merge` re-points every segment away first.
  speakerId    String @map("speaker_id") @db.Uuid

  startMs Int   @map("start_ms")
  endMs   Int   @map("end_ms")
  // Gap-based float, NOT a dense integer sequence (spec §3.4): a
  // `segment.split` only needs the midpoint between its two neighbours and
  // touches no other row, versus an integer sequence that would need to
  // renumber every later segment on every single split.
  ordinal Float

  text           String
  // `[{t, s, e, c}]` — text, start, end, confidence per word (spec §3.3),
  // kept terse because a 10-hour transcript's word array is the single
  // largest thing in this schema. Opaque JSONB, not a child table: word rows
  // are never queried or updated independently of their segment.
  words          Json           @db.JsonB
  // How much of `words[]` to trust after an edit (spec §3.5). `exact` is the
  // default because a freshly ingested (`ai_original`) segment, and either
  // half of a `segment.split`/`segment.join`, are always exact — nothing
  // about dividing or concatenating an existing array invents a timing.
  wordsAlignment WordsAlignment @default(exact) @map("words_alignment")
  confidence     Float?

  // Whether this segment's TEXT originated from the provider or was created
  // by a person. Defaults `ai` because every segment `transcription.ingest`
  // writes is exactly that; nothing in spec §4.1's op table currently
  // creates a segment from nothing (only `speaker.create` has a from-nothing
  // shape), so `user` exists for a future op without one today.
  origin     SegmentOrigin @default(ai)
  // Optimistic-concurrency counter (spec §5), same starting value and same
  // reasoning as `TranscriptSpeaker.rev` above.
  rev        Int           @default(1)
  editedById String?       @map("edited_by_id") @db.Uuid
  editedAt   DateTime?     @map("edited_at") @db.Timestamptz

  // GENERATED ALWAYS AS (to_tsvector('english'::regconfig, coalesce(text,
  // ''))) STORED, plus a GIN index — issue #174, epic #164. Unweighted,
  // unlike `Note.searchVector` below: a segment is one line of speech with
  // no title of its own to weight against. Hand-written in
  // `20260915120000_add_search_vectors/migration.sql`; see that migration's
  // header for the full argument (why the two-argument `to_tsvector` form
  // is required, why `'english'` is a stated v1 limitation, why a generated
  // column rather than a trigger — a trigger does not fire under the
  // `session_replication_role = replica` a database restore runs under).
  // `Unsupported` and nullable-optional for the same reason
  // `Transcript.titleSearchVector` is: Prisma cannot express "the database
  // writes this," and this field is never selectable or writable through
  // the client — every read goes through raw SQL.
  searchVector Unsupported("tsvector")? @map("search_vector")

  transcript Transcript        @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  speaker    TranscriptSpeaker @relation(fields: [speakerId], references: [id], onDelete: Restrict)
  // SetNull, matching `AuditEvent.actorUserId`/`Credential.updatedByUserId`:
  // "who last hand-edited this line" is an audit fact about the segment, not
  // something the segment's own existence depends on.
  editedBy   User?             @relation("TranscriptSegmentEditor", fields: [editedById], references: [id], onDelete: SetNull)

  // AI name-check suggestions proposed against this segment (issue #328,
  // epic #326). See the block comment above the `TranscriptNameCheck` model.
  nameSuggestions TranscriptNameSuggestion[]

  // Connected Knowledge (epic #344, issue #351). SetNull — an evidence row
  // is a citation that survives losing the segment it pointed to; `quote`
  // is what keeps it readable afterwards. See the block comment above
  // `KgEvidence`.
  kgEvidence KgEvidence[]

  // The compound order both a segment list and a time-window query
  // (`GET /:id/words?fromMs&toMs`) need (spec §3.3).
  @@index([transcriptId, startMs, ordinal])
  @@map("transcript_segments")
}

enum TranscriptVersionKind {
  ai_original
  edit
  restore
}

model TranscriptVersion {
  id           String                @id @default(uuid()) @db.Uuid
  transcriptId String                @map("transcript_id") @db.Uuid
  version      Int
  kind         TranscriptVersionKind

  // NULL means "the AI" — the ingest handler is the only writer that ever
  // leaves this null (spec §4.5); every human-triggered version (`edit`,
  // `restore`) always has a real author. SetNull, not Restrict/Cascade: a
  // version is permanent history (spec §4.5 — "nothing in this design ever
  // deletes a `transcript_versions` row"; only `transcript.purge` deleting
  // the whole transcript does) and must survive the author's own account
  // being deleted, the same audit posture as `DatabaseBackupRun.createdById`.
  authorId String? @map("author_id") @db.Uuid
  summary  String?
  // The concrete ops this version applied (spec §4.1) — e.g. the expanded
  // `segment.update_text` ops a `transcript.find_replace` call becomes
  // (spec §4.2), NEVER the abstract find/replace call itself, so replaying
  // history stays correct even if this application's matching logic changes
  // later.
  ops      Json    @db.JsonB

  // The version number this row restored FROM, when `kind: restore` (spec
  // §4.5). A plain version number, not a self-relation FK: it names another
  // row's `(transcriptId, version)` pair, which is not a column any FK can
  // point at directly, and a restore's target version is immutable history
  // that is never itself deleted (short of purging the whole transcript).
  restoredFromVersion Int?    @map("restored_from_version")
  // The gzipped materialized state at this version, when this version was
  // snapshotted (spec §4.3 — always for v1 and every restore, otherwise on a
  // size-or-count trigger). NULL for a version materialized purely by
  // replaying `ops` from the nearest earlier snapshot.
  snapshotObjectId    String? @map("snapshot_object_id") @db.Uuid
  // Idempotency key for a retried save (spec §5): a client that saved but
  // never saw the response retries with the SAME `clientBatchId`, and
  // `@@unique([transcriptId, clientBatchId])` below is what lets the write
  // path detect the retry and return the original version instead of
  // creating a second one. NULL for a version this application created
  // itself (ingest, restore) rather than in response to a client batch —
  // Postgres's standard NULLS-DISTINCT behaviour is exactly what is wanted
  // there: any number of null-`clientBatchId` versions may coexist.
  clientBatchId       String? @map("client_batch_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  transcript     Transcript     @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  author         User?          @relation("TranscriptVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  // Restrict, matching every other storage_objects FK on this feature — see
  // the block comment above the enums.
  snapshotObject StorageObject? @relation("TranscriptVersionSnapshotObject", fields: [snapshotObjectId], references: [id], onDelete: Restrict)

  // The version sequence itself, and what `materialize()` (spec §4.4) looks
  // up by.
  @@unique([transcriptId, version])
  // The idempotent-retry key described above. Plain `@@unique`, not a
  // hand-written partial index: Postgres's default NULLS DISTINCT behaviour
  // already gives exactly the wanted semantics for a nullable column, unlike
  // `transcript_speakers`' label uniqueness above.
  @@unique([transcriptId, clientBatchId])
  @@map("transcript_versions")
}

enum TranscriptShareRole {
  viewer
  editor
}

model TranscriptShare {
  id           String              @id @default(uuid()) @db.Uuid
  transcriptId String              @map("transcript_id") @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  // No default — matching `DatabaseBackupTrigger`'s own "a run with no known
  // origin is a run nobody can attribute" reasoning: every share is granted
  // with an explicit role, on purpose, every time.
  role         TranscriptShareRole
  grantedById  String              @map("granted_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  // Cascade: a share row has no meaning once either party to it is gone —
  // the recipient can no longer be granted access, and (today) the granter
  // is always the owner, whose own deletion already cascades the transcript
  // and therefore this row via `transcriptId` above regardless.
  user       User       @relation("TranscriptShareUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy  User       @relation("TranscriptShareGrantedBy", fields: [grantedById], references: [id], onDelete: Cascade)

  // `POST /api/transcripts/:id/shares` (spec §6.3) upserts on this pair —
  // one role per (transcript, user), never two competing rows.
  @@unique([transcriptId, userId])
  @@map("transcript_shares")
}

enum TranscriptExportStatus {
  pending
  ready
  failed
}

model TranscriptExport {
  id           String @id @default(uuid()) @db.Uuid
  transcriptId String @map("transcript_id") @db.Uuid
  version      Int

  // The exporter's own registry key (`markdown`, `pdf`, or the permanent
  // published JSON format spec §8.2 names). Plain string, not an enum, for
  // the same self-registering-registry reason `Job.type` is: adding an
  // exporter (spec §8.1 — "one new class registering itself") must cost
  // zero migrations to this table.
  format      String
  // The requester's export options, as passed to the exporter's own
  // `optionsSchema` (spec §8.1) — opaque JSONB, since the option shape is
  // defined by the exporter, not by this table.
  options     Json                   @db.JsonB
  // sha256 (or similar) of `{ format, version, options }` (spec §8.5) — the
  // content-addressed key `POST /:id/exports` looks up to decide whether an
  // existing, unexpired export can be returned instead of rendering again.
  optionsHash String                 @map("options_hash")
  status      TranscriptExportStatus @default(pending)

  // The rendered file, once `status: ready`. Restrict, matching every other
  // storage_objects FK on this feature (block comment above the enums) —
  // only `transcripts.housekeeping`'s expiry sweep (spec §8.5) may remove
  // it, and only after deleting this row first.
  objectId      String? @map("object_id") @db.Uuid
  // The `transcript.export` job that rendered this row, when one did (spec
  // §1.5.6). `@unique`/SetNull, mirroring `DatabaseBackupRun.jobId` exactly:
  // a second render for the SAME job is unrepresentable, this row's own
  // 7-day retention is independent of `job.history.purge`'s schedule for the
  // underlying `jobs` row, and losing the link on a history purge must never
  // mean losing the export.
  jobId         String? @unique @map("job_id") @db.Uuid
  // Who asked for this export. NOT NULL and Cascade — unlike every SetNull
  // audit column elsewhere in this schema, an export is a disposable,
  // byte-for-byte reproducible artifact with a 7-day expiry already built in
  // (spec §8.5): nothing is lost by deleting a pending/ready export row
  // alongside the account that requested it, the same way nothing is lost
  // by `transcripts.housekeeping` expiring it on its own schedule.
  requestedById String  @map("requested_by_id") @db.Uuid

  error     String?
  // 7 days out from creation by default (spec §8.5) — what
  // `transcripts.housekeeping`'s sweep compares against.
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  transcript  Transcript     @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  object      StorageObject? @relation("TranscriptExportObject", fields: [objectId], references: [id], onDelete: Restrict)
  job         Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  requestedBy User           @relation("TranscriptExportRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  // The reuse-by-content-hash lookup spec §8.5 names explicitly ("the index
  // issue #24 declares for exactly this lookup"). Not unique: an expired or
  // failed row may briefly coexist with a fresh one sharing the same key
  // before housekeeping removes the stale one.
  //
  // `map:` pins an explicit name: Prisma's own default-generated name for
  // this four-column index is 64 bytes, one over PostgreSQL's 63-byte
  // identifier limit, which would otherwise leave the exact truncated name
  // to guess at in the hand-written migration.sql this issue ships without a
  // live database to diff against.
  @@index([transcriptId, version, format, optionsHash], map: "transcript_exports_lookup_idx")
  @@map("transcript_exports")
}

// =============================================================================
// Transcript Name Checks (issue #328, epic #326)
// =============================================================================
//
// AI-assisted detection of misspelled/mis-transcribed proper names and terms
// across a transcript's segments. A `TranscriptNameCheck` is one AI run —
// the request, its cost accounting, and its terminal state — and a
// `TranscriptNameSuggestion` is one PROPOSED edit that run produced. Both
// tables are deliberately never a second source of truth for transcript
// content: accepting a suggestion turns it into an ordinary
// `segment.update_text` op recorded through the exact same `/operations`
// path and `TranscriptVersion` history every other correction uses (see the
// block comment above `TranscriptVersion`) — these rows never write
// `transcript_segments.text` directly, only propose a change to it.
// `segmentRev` on a suggestion pins the `TranscriptSegment.rev` its offsets
// were computed against, the identical optimistic-concurrency shape
// `TranscriptVersion`'s `rev` split already uses elsewhere in this schema,
// so a suggestion whose segment was edited out from under it is detectable
// at apply time rather than silently misapplied at the wrong offset —
// `status: stale` is that outcome, not a bug report.

enum TranscriptNameCheckMode {
  standard
  thorough
}

enum TranscriptNameCheckStatus {
  pending
  running
  ready
  failed
}

model TranscriptNameCheck {
  id           String @id @default(uuid()) @db.Uuid
  transcriptId String @map("transcript_id") @db.Uuid

  // Who asked for this run. SetNull, not Cascade/Restrict — unlike
  // `TranscriptExport.requestedById` (a disposable, re-renderable artifact
  // deleted with its requester), a name-check run and the suggestions it
  // produced are worth keeping as transcript history even after the
  // requesting account is gone, the same audit posture
  // `TranscriptVersion.authorId` already takes.
  requestedById String? @map("requested_by_id") @db.Uuid

  // `standard` (segments only) vs `thorough` (a wider discovery pass) — a
  // closed, spec-defined pair, worth a real enum rather than a string.
  mode   TranscriptNameCheckMode
  status TranscriptNameCheckStatus @default(pending)

  // The `Transcript.currentVersion` this run read segment text from,
  // matching `TranscriptExport.version`'s reasoning: a run started against
  // one version must not be silently reinterpreted against a later one once
  // edits land mid-run.
  basedOnVersion Int @map("based_on_version")

  // The target names/terms this run checked for — a string array, opaque
  // JSONB for the same reason `TranscriptSegment.words` and
  // `Transcript.providerOptions` are: the caller-supplied or AI-discovered
  // term list has no shape this table needs to enforce.
  terms Json @db.JsonB

  // Which AI provider/model produced this run's suggestions — plain
  // strings, not an enum/FK, matching `Transcript.provider`'s own
  // open-registry reasoning: a new provider must cost zero migrations here.
  providerId String? @map("provider_id")
  model      String?

  // Denormalized off `transcript_name_suggestions` so a list/detail read
  // never joins and counts on every request, matching
  // `Transcript.speakerCount`/`.wordCount`'s "cheap to read often,
  // recomputed by the one write path that changes the true count" shape.
  candidateCount  Int @default(0) @map("candidate_count")
  suggestionCount Int @default(0) @map("suggestion_count")

  // Cost accounting for this run's own AI call(s), the same pair
  // `NoteGeneration` tracks per generation.
  inputTokens  Int @default(0) @map("input_tokens")
  outputTokens Int @default(0) @map("output_tokens")

  // A closed-in-spirit taxonomy kept as a plain string rather than a second
  // copy of `NoteGenerationErrorClass`'s enum, matching `Job.type`'s own
  // "plain string, code-owned set" reasoning.
  errorClass String? @map("error_class")
  error      String?

  // The `transcript.name_check` job that ran this check, when one did. `@unique`/
  // nullable/`SetNull`, mirroring `TranscriptExport.jobId`/
  // `DatabaseBackupRun.jobId` exactly: this row's own lifetime (read by the
  // review UI long after job history is purged) is independent of
  // `job.history.purge`'s schedule for the underlying `jobs` row.
  jobId String? @unique @map("job_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  transcript  Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  requestedBy User?      @relation("TranscriptNameCheckRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  job         Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)

  suggestions TranscriptNameSuggestion[]

  // "This transcript's name-check runs, newest first" — the run history
  // list.
  @@index([transcriptId, createdAt(sort: Desc)])
  @@map("transcript_name_checks")
}

enum TranscriptNameSuggestionStatus {
  pending
  accepted
  rejected
  stale
}

model TranscriptNameSuggestion {
  id      String @id @default(uuid()) @db.Uuid
  checkId String @map("check_id") @db.Uuid

  // Cascade, matching `TranscriptSegment`'s own relation to `Transcript`: a
  // suggestion against a segment that no longer exists (a later
  // `segment.split`/`segment.join`/delete) has nothing left to apply to.
  segmentId  String @map("segment_id") @db.Uuid
  // The `TranscriptSegment.rev` these offsets were computed against — see
  // the block comment above for why a mismatch at apply time means `stale`,
  // never a silently wrong offset.
  segmentRev Int    @map("segment_rev")

  // UTF-16 offsets into `TranscriptSegment.text` at `segmentRev` — matching
  // JavaScript string indexing end to end, so the editor, the API and this
  // column all agree on one encoding.
  start Int
  end   Int

  original    String
  replacement String

  confidence Float?
  reason     String?
  // `'phonetic' | 'discovery'` today — plain string, not an enum, matching
  // `Transcript.provider`'s own open-registry reasoning: which detection
  // strategies exist is code, not schema.
  source     String

  status      TranscriptNameSuggestionStatus @default(pending)
  decidedAt   DateTime?                      @map("decided_at") @db.Timestamptz
  // SetNull, matching `TranscriptSegment.editedById`: "who accepted or
  // rejected this suggestion" is an audit fact about the suggestion, not
  // something its own existence depends on.
  decidedById String?                        @map("decided_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  check     TranscriptNameCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  segment   TranscriptSegment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  decidedBy User?               @relation("TranscriptNameSuggestionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  // "This run's suggestions, filtered by status" — the review UI's default
  // list.
  @@index([checkId, status])
  // "Every suggestion touching this segment" — applying/staling suggestions
  // when a segment is edited elsewhere.
  @@index([segmentId])
  @@map("transcript_name_suggestions")
}

// =============================================================================
// Notes (issue #48, epic #45) — docs/specs/notes.md §4
// =============================================================================
//
// Five tables — `notes`, `note_templates`, `note_generations`, `note_versions`,
// `note_exports` — for the AI-generated, user-correctable documents this epic
// adds on top of a transcript, another note, or an uploaded document. Nothing
// about generation, the stream, prompt assembly or export lands with this
// issue — only the schema and RBAC, ahead of the code that reads and writes
// it, matching the same "schema ships whole, code follows" precedent
// `jobs`/`worker_nodes` and `transcripts` (issue #24) already set. Every
// column, enum member and index below is named for and justified by
// docs/specs/notes.md §1, §4, §6 and §7 — read those sections for the full
// reasoning; this comment restates only what has to live beside the code to
// stay correct. `user_ai_credentials` (spec §4.2) is issue #47's table, not
// this one, and does not appear here.
//
// -----------------------------------------------------------------------------
// owner_id CASCADES; the three source pointers and template_id RESTRICT or
// SetNull — the exact `Transcript` shape (schema.prisma's own block comment
// above), with one genuinely new wrinkle: a SELF-relation
// -----------------------------------------------------------------------------
// `owner_id` points UP the ownership chain, identically to `transcripts
// .owner_id`: a note has no meaning and this application's access model has
// no path to it once its owner is gone — there is deliberately no
// `notes:read_any` (spec §6.3) — so Cascade is the only outcome consistent
// with "no read-any, ever."
//
// The three source columns point SIDEWAYS and RESTRICT, but spec §4.1 is
// explicit that the *consequence* of that Restrict is not uniform across the
// three, and this schema does not paper over the difference:
//
//   - `source_object_id` -> `storage_objects` is Restrict for the same
//     belt-and-suspenders reason every `storage_objects` FK on `transcripts`
//     is: the uploaded document is `managed_by: 'notes'`, so the generic
//     storage `DELETE` already 409s on it before this FK is ever tested.
//   - `source_transcript_id` -> `transcripts` and `source_note_id` -> `notes`
//     (a SELF-relation — the one structural difference from every Restrict FK
//     `transcripts` declares) point at rows that ARE independently,
//     legitimately deletable through their own existing endpoints, which
//     neither know nor care whether a note was ever derived from them.
//     Restrict therefore has a real, user-visible consequence here:
//     `DELETE /api/transcripts/:id` and (once #53 lands) `DELETE
//     /api/notes/:id` on a note cited as another note's source must both gain
//     a pre-check that 409s naming the blocking note id(s) BEFORE the row
//     reaches this constraint, exactly as `transcripts.service.ts` already
//     does for storage objects. This migration adds only the constraint; the
//     one-line guard for the transcript side is backend work for the PR that
//     lands transcripts.service.ts's next change, and the note-on-note guard
//     is #53's own responsibility once `notes.service.ts` exists to hold it.
//
// `template_id` is the one FK in this feature that is `SetNull`, not
// `Restrict`, and that asymmetry is deliberate (spec §4.1's own closing
// paragraph): a template is a reusable RECIPE, never EVIDENCE — VISION.md's
// Trust-and-Provenance thesis is about a note staying connected to the
// INFORMATION it transformed, never about which instructions did the
// transforming. Making it Restrict would mean a custom template could never
// be deleted once it had produced even one note, an ordinary thing a user
// wants to do (spec §7.3's duplicate-and-edit flow exists precisely so this
// is safe to allow). Losing the *reference* on delete costs nothing durable:
// `note_generations.templateNameSnapshot` below keeps "which recipe produced
// this" as a plain string forever, independent of whether the template row
// itself survives.
//
// -----------------------------------------------------------------------------
// `note_generations` is deliberately SELF-SUFFICIENT — everything
// `assemblePrompt` needs is denormalized onto the row, because a template
// PREVIEW generation has no `note_id` to join back through
// -----------------------------------------------------------------------------
// `template_name_snapshot`, `context_text`, `source_type` and the three
// (deliberately PLAIN, non-FK) `source_*_id` columns, `provider_id` and
// `model` are all copies taken at the moment a generation is created, not
// joins. Two things follow from that, both worth stating explicitly rather
// than leaving implicit:
//
//   - The three `source_*_id` columns here carry NO foreign key at all,
//     unlike their namesakes on `notes` above. They are a denormalized RECORD
//     of what was resolved when this generation started, not a reference this
//     schema has to keep valid — a `kind: 'preview'` row has no `note_id` and
//     is hard-deleted by its own TTL sweep regardless of what its source
//     later does, so there is nothing for a Restrict to protect here that the
//     owning `notes` row (for `create`/`regenerate`) is not already
//     protecting on its own account.
//   - `job_id` DOES EXIST ON THIS TABLE, `@unique`/nullable/`SetNull`,
//     mirroring `DatabaseBackupRun.jobId` and `TranscriptExport.jobId` for
//     the identical stated reason (issue #48): this row's own lifetime —
//     read by the SSE endpoint and the note detail page for as long as
//     generation is in flight or its content is still being displayed — is
//     independent of `job.history.purge`'s retention schedule for the
//     underlying `jobs` row. Losing the LINK on a history purge must never
//     mean losing the GENERATION (its buffered `content` is what a
//     `note_versions.ai_generated` row was stamped from). `SetNull` rather
//     than `Restrict` for the same reason every other `jobId` in this schema
//     is `SetNull`: a purged job's row disappearing is routine housekeeping,
//     not a reason to block it.
//
// `error_class` is a proper enum (`NoteGenerationErrorClass`), unlike
// `Job.type`/`StorageObject.managedBy`'s deliberately open, code-owned plain
// strings: spec §2.2's taxonomy is a small, CLOSED, product-defined set (not
// a registry of pluggable handlers), the same reasoning every other
// small-closed-set field in this schema (`TranscriptExportStatus`,
// `DatabaseBackupTrigger`) is an enum rather than a string.
//
// -----------------------------------------------------------------------------
// `note_versions` stores a FULL BODY SNAPSHOT per row, not an operation log —
// the decision issue #46/#48 flag explicitly as a genuinely different answer
// from `transcript_versions`, restated here because it is the one place a
// reader of this schema without the spec open would reasonably ask "why does
// this feature not reuse the op-log machinery next door"
// -----------------------------------------------------------------------------
// `docs/specs/transcription.md` §11's own rejected-alternatives entry gives
// the arithmetic that ruled a full snapshot OUT for transcripts: roughly 7 MB
// per save for a 10-hour, 90,000-word recording. A note is a page or two of
// prose — a few kilobytes — so that arithmetic simply does not apply, and the
// machinery an op log needs to earn its cost (pure reducers, `materialize()`,
// gap-based ordinals, per-entity `rev`) has no equivalent structure here: a
// note has no segments, no speakers, and no concurrent-editor reconciliation
// to do (spec §5's stream is the only writer while generating). Storing the
// whole markdown string per save is not a shortcut around building that
// machinery — for a document this small, the op log is what would have been
// over-engineering.
//
// -----------------------------------------------------------------------------
// `note_exports` mirrors `transcript_exports` FIELD FOR FIELD (spec §4.6),
// including the one place this migration follows the REAL, already-shipped
// `TranscriptExport` implementation over spec §4.6's own shorthand prose
// -----------------------------------------------------------------------------
// Spec §4.6 describes the reuse-by-content-hash lookup with the English word
// "unique". The actual `transcript_exports` table it says this mirrors does
// NOT enforce that with a `@@unique` — see this schema's own block comment
// above `TranscriptExport`: "an expired or failed row may briefly coexist
// with a fresh one sharing the same key before housekeeping removes the
// stale one." A literal `@@unique` here would make that ordinary coexistence
// a write failure. This migration reuses `transcript_exports_lookup_idx`'s
// actual shape — a plain, non-unique `@@index` — because "mirrors
// `transcript_exports` field for field" (issue #48's own proposed solution)
// is the more specific, more load-bearing instruction, and because matching
// the table this feature explicitly exists to let #54 "reuse #28's registry
// unchanged" against means matching what that registry's code actually
// queries, not a one-word paraphrase of it.
// =============================================================================

enum NoteStatus {
  draft
  generating
  ready
  failed
  deleting
}

enum NoteSourceType {
  transcript
  note
  document
}

enum NoteGenerationKind {
  create
  regenerate
  preview
}

enum NoteGenerationStatus {
  pending
  streaming
  succeeded
  failed
}

enum NoteGenerationErrorClass {
  auth
  refusal
  rate_limit
  other
}

enum NoteVersionKind {
  ai_generated
  edit
  restore
}

enum NoteExportStatus {
  pending
  ready
  failed
}

enum NoteTitleSource {
  ai
  user
  template
}

model Note {
  id String @id @default(uuid()) @db.Uuid

  ownerId String @map("owner_id") @db.Uuid
  title   String

  // WHO chose the current `title`, not just what it says (issue #180, epic
  // #163). A title had no provenance before this column: nothing could tell
  // a name the user typed apart from one the product guessed, so a
  // `regenerate` or a future bulk-retitle pass had no way to know a note's
  // owner had already renamed it — the exact failure mode this column exists
  // to rule out is silently overwriting a human-chosen title with an AI
  // guess. `template` is the default because that is literally what every
  // row in this table has been until now: `notes.service.ts` has always
  // fallen back to the source template's `name` when nothing more specific
  // was available, so `template` is the truthful value for the entire
  // existing dataset, not a placeholder invented for this migration.
  // `user` is STICKY — once a person edits the title directly it becomes
  // `user` and the AI titling path (present or future) must never overwrite
  // it or flip it back to `ai`/`template`; that check belongs to the service
  // layer, this column only makes the state it must check representable.
  titleSource NoteTitleSource @default(template) @map("title_source")

  // The LIVE working copy of the note's markdown body (issue #48). @db.Text,
  // defaulting to an empty string so a freshly created `draft` note (no
  // version yet — `currentVersion` starts at 0) has something to read rather
  // than a nullable hole every reader would have to special-case.
  //
  // THE INVARIANT THIS COLUMN EXISTS UNDER: `notes.body` always equals the
  // `note_versions` row at `note_versions.version = notes.current_version`.
  // `note_versions.body` is the immutable, append-only SNAPSHOT — one row
  // per save, never rewritten, the full history #53's version list and
  // restore endpoint read from. `notes.body` is the single denormalized
  // COPY of whichever snapshot is current, kept in lockstep by the same
  // write path that bumps `currentVersion` (spec §1.3): every write that
  // appends a `note_versions` row — AI generation completing, a `PATCH`
  // editing the body, a restore — updates both columns together, in the
  // same transaction, or not at all. This is what lets `GET /api/notes/:id`
  // (#53) answer "what does this note say right now" with a single-row read
  // and no join, while `GET /api/notes/:id/versions` still has the full,
  // independently-readable history to page through. A `notes.body` that
  // ever disagreed with its own `currentVersion`'s snapshot would be a bug
  // in that write path, not an expected state.
  body String @default("") @db.Text

  // The markdown-vs-plain-text syntax `body` is written in, SNAPSHOTTED from
  // the generating template's `bodyFormat` at generation time (never a live
  // read of the template) — so a later edit to the template's body format
  // never changes how an already-generated note renders. Plain String, not
  // an enum, mirroring `NoteTemplate.bodyFormat` exactly.
  bodyFormat String @default("markdown") @map("body_format")

  status NoteStatus @default(draft)

  // Bumped only by the write path that commits a new `note_versions` row
  // (spec §1.3) — the same "current pointer, not a computed MAX()"
  // convention `transcripts.currentVersion` already uses.
  currentVersion Int @default(0) @map("current_version")

  // Which registered `AiProvider` (issue #47) and which of its models
  // produced the CURRENT body — denormalized onto the note itself (issue
  // #48) so a note detail page can state "generated by GPT-4o" without
  // joining to `note_generations`, whose rows `notes.housekeeping` is free
  // to sweep (preview generations expire; nothing guarantees a `create`/
  // `regenerate` generation outlives the note it produced forever). Plain
  // strings, not an enum/FK — the provider registry is code-owned and open,
  // the same `Transcript.provider`/`NoteGeneration.providerId` reasoning
  // applied here. Both null until the first successful generation; a body
  // edited by a human afterward does NOT clear either — they answer "what
  // produced this note originally," not "who wrote the current body."
  provider String?
  model    String?

  // The generation to watch (spec §1.3) — set the moment a create/regenerate
  // request enqueues a job, never cleared afterward, so a `ready` note's
  // pointer always names the generation that produced its current content.
  // SetNull rather than Restrict: losing this pointer loses only "which
  // generation is live right now," never the generation row itself or any
  // `note_versions` row it already produced.
  currentGenerationId String? @map("current_generation_id") @db.Uuid

  // Exactly one of the three below is set, matching `sourceType` — enforced
  // by the service layer (`notes.service.ts`, #53), not by the database:
  // Postgres has no portable "exactly one of these three columns is
  // non-null" constraint short of a CHECK this schema does not add, the same
  // posture `transcripts` takes toward its own multi-column invariants.
  sourceType         NoteSourceType @map("source_type")
  sourceTranscriptId String?        @map("source_transcript_id") @db.Uuid
  sourceNoteId       String?        @map("source_note_id") @db.Uuid
  sourceObjectId     String?        @map("source_object_id") @db.Uuid

  // SetNull, not Restrict — see the block comment above the enums.
  templateId String? @map("template_id") @db.Uuid

  // The optional free-text Context (spec §3.1) — short, user-authored,
  // placed ahead of the source in every assembled prompt.
  contextText String? @map("context_text")

  failureReason String? @map("failure_reason")

  // GENERATED ALWAYS AS (setweight(to_tsvector('english'::regconfig,
  // coalesce(title, '')), 'A') || setweight(to_tsvector('english'::regconfig,
  // coalesce(body, '')), 'B')) STORED, plus a GIN index — issue #174, epic
  // #164. Weighted A/B, unlike `TranscriptSegment.searchVector`: `title` is
  // human-authored (the user wrote it) and `body` is AI-generated (or later
  // user-edited), so a title hit is stronger evidence and `ts_rank`/
  // `ts_rank_cd` can reflect that. Hand-written in
  // `20260915120000_add_search_vectors/migration.sql`; see that migration's
  // header for the full argument, including why the two-argument
  // `to_tsvector` form is required and why a generated column rather than a
  // trigger (restore-safety — a trigger does not fire under
  // `session_replication_role = replica`). `Unsupported` and
  // nullable-optional for the same reason `Transcript.titleSearchVector`
  // is: never selectable or writable through the Prisma client — every read
  // goes through raw SQL.
  searchVector Unsupported("tsvector")? @map("search_vector")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  owner             User            @relation("NoteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sourceTranscript  Transcript?     @relation("NoteSourceTranscript", fields: [sourceTranscriptId], references: [id], onDelete: Restrict)
  // Self-relation — see the block comment above the enums for why this one
  // Restrict FK has a real, user-visible delete-blocking consequence.
  sourceNote        Note?           @relation("NoteSourceNote", fields: [sourceNoteId], references: [id], onDelete: Restrict)
  sourceObject      StorageObject?  @relation("NoteSourceObject", fields: [sourceObjectId], references: [id], onDelete: Restrict)
  template          NoteTemplate?   @relation("NoteTemplateSelection", fields: [templateId], references: [id], onDelete: SetNull)
  currentGeneration NoteGeneration? @relation("NoteCurrentGeneration", fields: [currentGenerationId], references: [id], onDelete: SetNull)

  // The other side of the self-relation above: every note that named THIS
  // note as its source. What #53's own delete guard queries before allowing
  // `DELETE /api/notes/:id` to proceed.
  derivedNotes Note[]           @relation("NoteSourceNote")
  generations  NoteGeneration[] @relation("NoteGenerations")
  versions     NoteVersion[]
  exports      NoteExport[]

  // Connected Knowledge (epic #344, issue #351). `kgEvidence`/`kgProposals`
  // are SetNull (a citation, and an extraction run's own source pointer,
  // both survive losing the note they named — see the block comments above
  // `KgEvidence`/`KgProposal`); `kgMentions` Cascades (see the block
  // comment above `KgMention`).
  kgEvidence  KgEvidence[]
  kgMentions  KgMention[]
  kgProposals KgProposal[]

  // "This owner's notes, newest first" — the notes library list view.
  @@index([ownerId, updatedAt(sort: Desc)])
  // "Every note in state X" — `notes.housekeeping`'s scans (#53) and any
  // future admin-adjacent health check, matching `transcripts_status_idx`.
  @@index([status])
  @@map("notes")
}

// -----------------------------------------------------------------------------
// `note_templates.owner_id IS NULL` means BUILT-IN — readable by every user,
// editable by nobody through the API (spec §7.1-7.2) — the same "null means
// something specific and permanent" convention `transcript_speakers.label`
// established for a different column entirely. There is deliberately NO
// `is_built_in` boolean (spec §4.3): a second, independently-settable flag
// that could disagree with `owner_id IS NULL` is exactly the failure mode
// `job-handler.interface.ts`'s "presence is the declaration" rule already
// forbids for node eligibility.
//
// `instructions` PLUS six structured fields, not "one field, not several
// structured knobs" (issue #48's actual, explicit column list —
// `outputFormat`, `structure`, `tone`, `length`, `model`, `isArchived` — all
// six). `instructions` stays the free-text prompt body the system role
// carries verbatim; the structured fields sit BESIDE it, not composed into
// it, because #56's template editor round-trips them as real controls (an
// Output format select, an editable ordered list for Structure, Tone and
// Length pickers, an optional Model override) — a user who edits a template
// and reopens it must get their structured choices back, which is impossible
// if they were only ever flattened into prose on save with nothing left to
// read them back out of. `assemblePrompt` (#49) reads all of `instructions`
// AND the structured fields when building a generation's prompt; neither
// replaces the other.
//
// `structure` is `Json @db.JsonB` — an ordered array of section/heading
// strings (e.g. `["Overview", "Key Points", "Decisions"]`), the shape #56's
// editable ordered list edits directly. `outputFormat` is required (every
// template, built-in or custom, names one); `tone`, `length` and `model` are
// optional — a template author may leave any of them unset and let
// `assemblePrompt` fall back to a deployment default. `isArchived` defaults
// to `false`: an archived custom template is hidden from the picker without
// being deleted (and without orphaning notes/generations that already
// reference it via `SetNull`, see below).
//
// `@@unique([ownerId, name])` (issue #48): a user may not have two templates
// sharing a name. PostgreSQL's standard NULLS-DISTINCT behaviour means this
// is silently a no-op among built-ins — every built-in's `ownerId` is
// permanently `NULL`, and NULL is never equal to NULL for uniqueness
// purposes, so any number of built-in rows may coexist regardless of name.
// The constraint only ever fires among a single owner's own rows.
// -----------------------------------------------------------------------------
model NoteTemplate {
  id      String  @id @default(uuid()) @db.Uuid
  ownerId String? @map("owner_id") @db.Uuid

  name         String
  description  String
  // The prompt body the system role carries verbatim (spec §3.1), read
  // together with the structured fields below by `assemblePrompt` (#49).
  // @db.Text: free-text prompt instructions can run well past what a
  // VARCHAR would comfortably hold.
  instructions String @db.Text

  // Structured fields #56's template editor presents as real controls, and
  // reads back unchanged on reopen — see the block comment above the enums
  // for why these six are stored beside `instructions` rather than composed
  // into it.
  outputFormat String  @map("output_format")
  // The markdown-vs-plain-text SYNTAX the AI is asked to write in — a
  // separate axis from `outputFormat` above, which names the document TYPE
  // (meeting notes, summary, …) rather than how its text is styled. Plain
  // String, not an enum: same reasoning as `outputFormat` — validated by
  // Zod in the API ('markdown' | 'plain_text'), not by a database enum.
  bodyFormat   String  @default("markdown") @map("body_format")
  // Ordered array of section/heading strings, e.g. `["Overview", "Key
  // Points", "Decisions"]` — the shape #56's editable ordered list edits.
  structure    Json    @db.JsonB
  tone         String?
  length       String?
  // Optional per-template model override, populated in the web editor from
  // `GET /api/ai/config`'s permitted list so a user can never select a
  // model the deployment forbids. Plain string, not an enum/FK — same
  // "code-owned, open registry" reasoning as `NoteGeneration.model`.
  model        String?
  // Hides a custom template from the picker without deleting it (and
  // without orphaning anything that already references it — `notes
  // .templateId`/`note_generations.templateId` are both `SetNull`, so
  // archiving never breaks a note or generation that used this template).
  // Never meaningfully set on a built-in row today, but not schema-
  // prevented from being so in the future.
  isArchived   Boolean @default(false) @map("is_archived")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Cascade: a user's own custom template has no meaning once its owner is
  // gone, the identical "belongs entirely to this account" shape
  // `user_settings`/`personal_access_tokens` already use. Never fires for a
  // built-in row, whose `owner_id` is permanently NULL.
  owner User? @relation("NoteTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  notes       Note[]           @relation("NoteTemplateSelection")
  generations NoteGeneration[] @relation("NoteGenerationTemplateSelection")

  // Who has hidden THIS template from their own picker (#310, epic #306) —
  // the built-in-safe complement to `isArchived` above. See the block
  // comment above `UserHiddenNoteTemplate`.
  hiddenBy UserHiddenNoteTemplate[]

  // A user may not have two templates sharing a name — see the block
  // comment above the enums for why PostgreSQL's NULLS-DISTINCT behaviour
  // leaves built-ins (permanently null `ownerId`) entirely unaffected by
  // this constraint.
  @@unique([ownerId, name])
  @@map("note_templates")
}

// =============================================================================
// `user_hidden_note_templates`: a per-user LISTING preference, never access
// control (#310, epic #306)
// =============================================================================
//
// A join table, deliberately, over the two alternatives this could have been:
//
// 1. A `user_settings` namespace (an array of hidden template ids in the
//    caller's own JSONB blob). Rejected on three counts: a JSONB array has
//    no foreign key, so a deleted template leaves a dangling id nothing ever
//    cleans up — the exact failure mode `user_settings`'s existing namespaces
//    (`notifications`, `onboarding`, ...) never need to worry about, because
//    none of them names another table's row by id; "is this specific
//    template hidden" and "list every template I've hidden" both become an
//    application-level filter over a blob instead of a `WHERE` clause an
//    index can serve; and there is no natural cap, so a user who hides
//    hundreds of templates over time grows one JSONB column without bound.
//    It would also cost the six-file parity `user-settings-parity.spec.ts`
//    guards for every namespace, for a preference that isn't shaped like the
//    rest of that document at all — it names rows in another table, not a
//    scalar or a small enum a client renders as a toggle.
// 2. `note_templates.is_archived`, reused per-caller. Rejected outright:
//    `is_archived` is a property of the TEMPLATE, shared by every user who
//    can see it (a built-in row is everyone's row), so "archived" can only
//    ever mean one thing for all viewers at once. Hiding is a property of
//    the (user, template) PAIR — my hiding a built-in template from my own
//    picker must never affect anyone else's.
//
// A join table gives real FK integrity in both directions (see the two
// `onDelete: Cascade`s below — hiding a template is meaningless once either
// side is gone), a plain indexed `WHERE user_id = ...` for the picker's
// exclusion query, no cap, and zero settings-parity cost.
//
// ⚠ HIDING IS A LISTING PREFERENCE ONLY, NEVER ACCESS CONTROL. A row here
// must never be consulted by `POST /api/notes` (create), `POST
// /api/notes/:id/regenerate`, or `POST /api/note-templates/preview` — all
// three continue to accept a hidden template by id exactly as before. This
// table only narrows what a picker LISTS, the identical scope
// `note_templates.is_archived` already keeps for the built-in-vs-custom
// axis: archiving/hiding decide what is offered, never what is honoured.
// =============================================================================
model UserHiddenNoteTemplate {
  userId     String   @map("user_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Both cascade: a hidden-template row has no meaning once either the user
  // or the template it names is gone.
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  template NoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([userId, templateId])
  @@index([templateId])
  @@map("user_hidden_note_templates")
}

// -----------------------------------------------------------------------------
// `note_generations` is the durable buffer spec §5.1 streams from — see the
// block comment above the enums for why it denormalizes its inputs and why
// it deliberately carries no `job_id`.
// -----------------------------------------------------------------------------
model NoteGeneration {
  id String @id @default(uuid()) @db.Uuid

  // NULL for a template preview (spec §4.4) — a preview has no note to
  // belong to and is hard-deleted by its own `expiresAt` sweep, never a
  // `note_versions` row.
  noteId String?            @map("note_id") @db.Uuid
  kind   NoteGenerationKind

  status      NoteGenerationStatus      @default(pending)
  errorClass  NoteGenerationErrorClass? @map("error_class")
  errorDetail String?                   @map("error_detail")

  // Denormalized inputs — see the block comment above the enums. templateId
  // is nullable/SetNull for the same reason `notes.templateId` is (a
  // deleted template loses only the reference); templateNameSnapshot is
  // NOT NULL because a generation is never created without a template
  // having been resolved first, and the snapshot is what survives the
  // template's own later deletion.
  templateId           String?        @map("template_id") @db.Uuid
  templateNameSnapshot String         @map("template_name_snapshot")
  contextText          String?        @map("context_text")
  sourceType           NoteSourceType @map("source_type")
  sourceTranscriptId   String?        @map("source_transcript_id") @db.Uuid
  sourceNoteId         String?        @map("source_note_id") @db.Uuid
  sourceObjectId       String?        @map("source_object_id") @db.Uuid
  // Which registered `AiProvider` (issue #47) this generation was submitted
  // to, and which of its models. Plain strings, not an enum/FK — the
  // provider registry is code-owned and open, the same `Transcript.provider`
  // reasoning applied to a second, independent registry.
  providerId           String         @map("provider_id")
  model                String

  // The stream itself (spec §5.1). Append-only, flushed on a short interval
  // together with `lastEventId` in the SAME UPDATE, so the SSE `id:` sequence
  // is gapless and stable by construction — there is no separate counter
  // that could disagree with what actually landed in `content`.
  content     String @default("") @db.Text
  lastEventId Int    @default(0) @map("last_event_id")

  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")

  // A snapshot of WHAT WAS SENT to the AI provider — the exact
  // `assemblePrompt()` output (apps/api/src/notes/generation/prompt.ts) —
  // written BEFORE the provider call so a failed generation still records
  // it (issue #307). `sourceVersion` is the transcript `currentVersion` /
  // source note `currentVersion` actually materialized into the prompt;
  // NULL for a document source, which carries no version. NULL across all
  // four columns means the generation predates issue #307 — deliberately
  // no backfill, because re-materializing the source today would fabricate
  // history: the source transcript/note may have been corrected since, and
  // the template may have been edited since.
  systemPrompt      String?   @map("system_prompt") @db.Text
  userContent       String?   @map("user_content") @db.Text
  sourceVersion     Int?      @map("source_version")
  contextCapturedAt DateTime? @map("context_captured_at") @db.Timestamptz

  // The `note.generate` job that produced (or is producing) this row, when
  // one exists. `@unique`/nullable/`SetNull`, mirroring `DatabaseBackupRun
  // .jobId` and `TranscriptExport.jobId` (issue #48): this row's own
  // lifetime — read by the SSE stream and the note detail page for as long
  // as generation is in flight, and kept afterward as the AI-generated
  // version's provenance — is independent of `job.history.purge`'s
  // retention schedule for the underlying `jobs` row. See the block comment
  // above the enums for the full reasoning.
  jobId String? @unique @map("job_id") @db.Uuid

  // Only ever set for `kind: 'preview'` — what `notes.housekeeping`'s TTL
  // sweep hard-deletes past (spec §4.4). A `create`/`regenerate` generation
  // has no expiry of its own; it lives as long as its `note_versions` row
  // needs it for provenance.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  // NOTE: deliberately no `updatedAt` here, matching docs/specs/notes.md
  // §4.4's Lifecycle group exactly — this row is already flushed on a
  // 250ms interval while streaming (spec §5.1); a second auto-maintained
  // timestamp on the same hot write path would cost index/row-version
  // churn spec §4.4 does not ask for and nothing downstream reads.
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  note     Note?         @relation("NoteGenerations", fields: [noteId], references: [id], onDelete: Cascade)
  template NoteTemplate? @relation("NoteGenerationTemplateSelection", fields: [templateId], references: [id], onDelete: SetNull)
  job      Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)

  // The inverse of `Note.currentGenerationId` above — structurally a list
  // because the FK carries no `@unique`, even though at most one note will
  // ever actually point here in practice (the note this generation belongs
  // to, if any).
  currentForNotes Note[]        @relation("NoteCurrentGeneration")
  versions        NoteVersion[] @relation("NoteVersionGeneration")

  @@map("note_generations")
}

// -----------------------------------------------------------------------------
// `note_versions` mirrors `transcript_versions` in spirit only — see the
// block comment above the enums for why a full body snapshot replaces the op
// log entirely rather than reusing it.
// -----------------------------------------------------------------------------
model NoteVersion {
  id      String          @id @default(uuid()) @db.Uuid
  noteId  String          @map("note_id") @db.Uuid
  version Int
  kind    NoteVersionKind

  // The full markdown, as stored — see the block comment above the enums.
  body String @db.Text

  // The syntax THIS version's body is written in ('markdown'|'plain_text',
  // validated by Zod in the API, not by a database enum) — issue #337.
  // Immutable once written: the source of truth for rendering/exporting
  // that version, not a live read of the note's or template's current
  // format. Restoring a version brings its format back onto the note,
  // exactly as it brings the body back.
  bodyFormat String @default("markdown") @map("body_format")

  // A short, optional human- or AI-authored description of what changed in
  // this version (issue #48) — e.g. "fixed the attendee list" for an
  // `edit`, or left unset for most `ai_generated`/`restore` rows. Purely a
  // display convenience for the version history list (#53); nothing in this
  // schema derives it and nothing requires it to be set.
  summary String?

  // NULL means "the AI" — the identical convention `transcript_versions
  // .authorId` already establishes, not a missing value. SetNull: a version
  // is permanent history and must survive its human author's own account
  // being deleted.
  authorId String? @map("author_id") @db.Uuid

  // Which generation produced this version, for `kind: 'ai_generated'`; NULL
  // for `edit`/`restore`. SetNull for the identical reason `authorId` is —
  // the version's `body` already carries everything durable; losing the
  // pointer back to the generation that produced it loses only "which
  // streaming run wrote this," never the content itself.
  generationId String? @map("generation_id") @db.Uuid

  // The version number this row restored FROM, when `kind: 'restore'` — a
  // plain version number, not a self-relation FK, matching `transcripts
  // .restoredFromVersion` exactly and for the identical reason: it names
  // another row's `(noteId, version)` pair, not a column any FK can target.
  restoredFromVersion Int?    @map("restored_from_version")
  // Idempotency key for the save endpoint (#53) — the same purpose as
  // `transcript_versions.clientBatchId`, and the same free NULLS-DISTINCT
  // behaviour below rather than a hand-written partial index.
  clientBatchId       String? @map("client_batch_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  note       Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author     User?           @relation("NoteVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  generation NoteGeneration? @relation("NoteVersionGeneration", fields: [generationId], references: [id], onDelete: SetNull)

  // The version sequence itself.
  @@unique([noteId, version])
  // The idempotent-retry key. Plain `@@unique`, not hand-written: Postgres's
  // standard NULLS DISTINCT behaviour already gives the wanted semantics for
  // this nullable column (any number of null-`clientBatchId` rows coexist).
  @@unique([noteId, clientBatchId])
  @@map("note_versions")
}

// -----------------------------------------------------------------------------
// `note_exports` mirrors `transcript_exports` FIELD FOR FIELD — see the block
// comment above the enums for the one place ("@@index", not "@@unique") this
// migration follows that table's real, already-shipped shape over spec
// §4.6's own shorthand prose.
// -----------------------------------------------------------------------------
model NoteExport {
  id      String @id @default(uuid()) @db.Uuid
  noteId  String @map("note_id") @db.Uuid
  version Int

  // The exporter's own registry key (`markdown`, `pdf`, `docx` — spec §8.1,
  // §8.3). Plain string, not an enum, for the same self-registering-registry
  // reason `TranscriptExport.format` is: adding an exporter must cost zero
  // migrations to this table.
  format      String
  options     Json             @db.JsonB
  optionsHash String           @map("options_hash")
  status      NoteExportStatus @default(pending)

  // Restrict, matching every `storage_objects` FK on `transcripts`: only
  // `notes.housekeeping`'s expiry sweep (spec §8.4) may remove the rendered
  // file, and only after deleting this row first.
  objectId String? @map("object_id") @db.Uuid
  // The `note.export` job that rendered this row, when one did.
  // `@unique`/SetNull, mirroring `TranscriptExport.jobId` exactly: a second
  // render for the SAME job is unrepresentable, and this row's own 7-day
  // retention is independent of `job.history.purge`'s schedule for the
  // underlying `jobs` row.
  jobId    String? @unique @map("job_id") @db.Uuid

  // Who asked for this export. NOT NULL and Cascade, matching
  // `TranscriptExport.requestedById`: an export is a disposable,
  // byte-for-byte reproducible artifact with its own 7-day expiry already
  // built in — nothing is lost by deleting a pending/ready row alongside the
  // account that requested it.
  requestedById String @map("requested_by_id") @db.Uuid

  error     String?
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  note        Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  object      StorageObject? @relation("NoteExportObject", fields: [objectId], references: [id], onDelete: Restrict)
  job         Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  requestedBy User           @relation("NoteExportRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  // The reuse-by-content-hash lookup (spec §8.4) — deliberately a plain,
  // NON-unique index. See the block comment above the enums for why this
  // migration follows `transcript_exports_lookup_idx`'s real shape rather
  // than spec §4.6's shorthand "unique" wording: an expired or failed row
  // may briefly coexist with a fresh one sharing the same key before
  // housekeeping removes the stale one.
  //
  // `map:` pins an explicit name for the identical reason
  // `transcript_exports_lookup_idx` needed one: Prisma's own default name
  // for this four-column index is one byte over PostgreSQL's 63-byte
  // identifier limit.
  @@index([noteId, version, format, optionsHash], map: "note_exports_lookup_idx")
  @@map("note_exports")
}

// =============================================================================
// Per-user AI credentials (issue #47, epic #45)
// =============================================================================
//
// THE FIRST PER-USER SECRET IN THIS SCHEMA. Every other credential this
// application stores is DEPLOYMENT-SCOPED — the SMTP password, the AssemblyAI
// key, the VAPID private key — and all of them live in `credentials`, keyed
// `(purpose, name)`. Epic #45's AI features are strict BYO instead: a user
// brings their own OpenAI account, their own quota and their own bill, and a
// user with no key has no AI features (there is deliberately no deployment
// fallback key — see docs/specs/notes.md §9).
//
// -----------------------------------------------------------------------------
// WHY THIS IS NOT A ROW IN `credentials`
// -----------------------------------------------------------------------------
//
// The obvious alternative — `(purpose 'ai', name 'openai:<userId>')` — was
// rejected for one structural reason: `credentials` HAS NO FOREIGN KEY TO
// `users`, and cannot grow one, because its whole point is to hold secrets that
// belong to the deployment rather than to a person (`Credential.updatedByUserId`
// is `SetNull` precisely so offboarding an administrator does not delete a
// working SMTP configuration). Encoding a user id into the `name` column would
// therefore mean that deleting a user leaves their encrypted PERSONAL API key in
// the table forever, with nothing to clean it up and no enumeration path short of
// string-parsing every row's `name`. A cascading foreign key is the entire point
// of this table: the key is the user's, so its lifetime is the user's.
//
// -----------------------------------------------------------------------------
// ZERO NEW CRYPTOGRAPHY
// -----------------------------------------------------------------------------
//
// `secret` holds `encryptSecret(rawKey, 'ai-key')`'s output —
// `common/crypto/secret-cipher.ts` UNCHANGED, with a new purpose string as the
// AES-GCM sub-key domain. `@db.Text` for the same reason `Credential.secret` is:
// a base64 AES-GCM payload has no meaningful bound and must never be truncated.
//
// A NEW PURPOSE, NOT `'transcription'` OR `'smtp'`: `purpose` is the derivation
// label, so domain separation means a ciphertext lifted out of `credentials` and
// pasted into this column fails authentication rather than decrypting into a
// context where it means something else. Changing `'ai-key'` later does not
// rename anything — it orphans every stored key permanently.
//
// -----------------------------------------------------------------------------
// NEVER RETURNED, BY ANY ROUTE
// -----------------------------------------------------------------------------
//
// `GET /api/ai-credentials` returns `provider`, `hint`, `label` and
// `lastUsedAt`. The ciphertext is not selected by that query at all, and no
// response DTO in `src/ai/dto/` has a field able to hold it. `hint` is the same
// non-secret mask `Credential.hint` carries (`••••` plus at most four trailing
// characters, nothing at all below eight), derived on write by code that already
// holds the plaintext.
// =============================================================================
model UserAiCredential {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  // Which registered `AiProvider` (`src/ai/ai-provider.registry.ts`) this key
  // is for. A PLAIN STRING, not an enum — the provider registry is code-owned
  // and open, exactly like `Transcript.provider` and `Job.type`, so a fork
  // registering its own OpenAI-compatible vendor costs zero migrations.
  provider String

  // `encryptSecret(rawKey, 'ai-key')`. See the header: this column is the only
  // place a user's AI key exists at rest, and nothing reads it but the one
  // service method that hands the plaintext straight to a provider context.
  secret String @db.Text

  // The non-secret display mask, e.g. `••••a1b2`. Nullable for the same reason
  // `Credential.hint` is: a short key has no suffix worth revealing.
  hint String?

  // A user-supplied label, so somebody with keys on two accounts can tell them
  // apart ("work", "personal"). Non-secret and shown verbatim.
  label String?

  // When this key was last USED — updated by the generation path (#49) and by a
  // successful probe, so the settings page can say "last used 2 hours ago"
  // without re-probing on every page load. Never a clock this application acts
  // on; purely informational.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // ⚠ Cascade, and this is the whole reason the table exists. See the header.
  user User @relation("UserAiCredentials", fields: [userId], references: [id], onDelete: Cascade)

  // One key per user per provider. The address every read and write uses;
  // replacing a key is an upsert on this pair, never a second row.
  @@unique([userId, provider])
  @@map("user_ai_credentials")
}

// =============================================================================
// Semantic search: pgvector storage (issue #181, epic #165)
// =============================================================================
//
// Layer 2 of search, sitting beside layer 1's generated `tsvector` columns
// (`20260915120000_add_search_vectors`): MEANING-based retrieval over the
// same transcript/note content, via vectors an AI embedding model produces.
// This is storage only — no embedding call, no chunking pipeline, lives in
// this schema; that is later issues in epic #165. The full argument for
// every decision below (the `vector(1536)` width contract, why
// `document_id` carries no foreign key, HNSW vs. IVFFlat, the
// `vector_cosine_ops` opclass, why embeddings are not a column on the
// document row, content addressing via `content_hash`, and why `status` is
// a Prisma enum while `document_type`/`reason` stay plain text) is in the
// header of `20260915130000_add_search_embeddings/migration.sql` — read that
// first; this comment only orients the three models against each other.
// =============================================================================

enum SearchIndexStatus {
  pending
  indexing
  indexed
  failed
  skipped
}

// One row per chunk of a document's text (issue #181). `documentType` +
// `documentId` is a polymorphic reference with NO foreign key in either
// direction — the same precedent `Job.subjectType`/`subjectId` sets (see the
// block comment above `model Job`) and for the identical reason: the set of
// searchable document types is open-ended and code-owned. See the migration
// header's point 2 for the cost of that choice (an orphan row is possible)
// and who owes the sweep (the deleting document's own `transcript.purge` /
// `note.purge` handler, wired by a later issue).
model SearchChunk {
  id String @id @default(uuid()) @db.Uuid

  documentType String @map("document_type")
  documentId   String @map("document_id") @db.Uuid

  // Position among this document's chunks. Together with
  // (documentType, documentId) this is the natural key — see the unique
  // index below.
  ordinal Int

  text String

  // sha256 of this chunk's FINAL text — the content-addressing key. See the
  // migration header's point 6: re-indexing an edited document only needs to
  // re-embed the chunks whose hash actually changed, and the bill for that
  // is the document owner's own vendor account.
  contentHash String @map("content_hash")

  // Character offsets into the document's source text, so a search result's
  // snippet can be built directly from this row without re-locating the
  // chunk inside the document. See the migration header's point 5 for why
  // this lives on its own row rather than as a column on the document.
  charStart Int @map("char_start")
  charEnd   Int @map("char_end")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  embeddings SearchEmbedding[]

  // One chunk per position per document — the natural key a re-chunk
  // upserts against.
  @@unique([documentType, documentId, ordinal])
  // The lookup every read of "this document's chunks" uses.
  @@index([documentType, documentId])
  // The content-addressing lookup the migration header's point 6 argues for.
  @@index([contentHash])
  @@map("search_chunks")
}

// One (chunk, model) embedding vector (issue #181). `chunkId` IS a real
// foreign key — unlike `SearchChunk.documentId` above, it points INSIDE this
// same module's own table, not sideways into another module's — and
// CASCADES: an embedding with no chunk left to belong to means nothing.
//
// ⚠ `embedding` is `Unsupported("vector(1536)")`, and it is REQUIRED, not
// optional — unlike the FTS `tsvector` columns in the sibling migration,
// which are database-GENERATED and so Prisma must never attempt to write
// them. This column is the opposite: application code writes it, on every
// insert, with no database-side generation at all. A REQUIRED `Unsupported`
// field makes `prisma.searchEmbedding.create(...)` (and every other
// generated-client write) UNCREATABLE for this model — the generated client
// has no way to construct a value for an unsupported type, so every write to
// this table MUST go through raw SQL (`$queryRaw`/`$executeRaw`, building the
// vector literal by hand). That is correct and intended, not a limitation to
// route around: a `vector` literal has to be assembled as raw SQL regardless
// of what the client layer offers, because there is no TypeScript
// representation of a pgvector value the generated client could accept in
// the first place. See the migration header's points 1, 3, 4 and 6 for the
// width contract, the HNSW index choice, the `vector_cosine_ops` opclass,
// and why `UNIQUE (chunkId, model)` is what makes a repeat embed cheap.
model SearchEmbedding {
  id String @id @default(uuid()) @db.Uuid

  chunkId String @map("chunk_id") @db.Uuid

  // Which embedding model produced this vector — a plain string, open-ended,
  // exactly like `Job.type` and `Transcript.provider` elsewhere in this
  // schema, so a new or changed model costs this table zero migrations.
  model String

  // Recorded fact about the row, kept even though the column type already
  // enforces the real width constraint. See the migration header's point 1
  // for why this is not redundant: it is what lets a future width migration
  // tell old rows from new ones without re-deriving the width from the
  // vector itself.
  dimensions Int

  // `vector(1536)` — see the block comment above the model for the whole
  // "why Unsupported, why required, why raw SQL" argument, and the migration
  // header's point 1 for why 1536 specifically is a CONTRACT with
  // `AiProvider`'s `EMBEDDING_DIMENSIONS`, not a default.
  embedding Unsupported("vector(1536)")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ⚠ Cascade — this row has no meaning once its chunk is gone. See the
  // header above the model.
  chunk SearchChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  // One vector per chunk per model — the natural key a re-embed upserts
  // against, and the index the migration header's point 6 argues makes a
  // repeat-embed check a single indexed lookup rather than a scan.
  @@unique([chunkId, model])
  // HAND-WRITTEN in migration.sql only — Prisma has no DSL for `USING hnsw`
  // or for an index's operator class. See the migration header's
  // "INTENTIONAL SCHEMA DRIFT" section (occurrence 5 of 5: `jobs`,
  // `database_backup_runs`, `transcript_speakers`, this migration's own
  // sibling's generated tsvector columns, and this). Do not "fix" this by
  // inventing a Prisma-expressible substitute — there isn't one, and
  // `prisma migrate dev`/`diff` must never be asked to reconcile this index
  // away.
  @@map("search_embeddings")
}

// One row per DOCUMENT (not chunk) — the legibility surface an owner or
// admin reads to answer "is this document semantically searchable, and if
// not, why not" (issue #181). `documentType`/`documentId` mirror
// `SearchChunk`'s polymorphic reference exactly, and for the identical
// reason (no foreign key, open-ended document types). `ownerId` IS a real
// foreign key into `users` and CASCADES: an index-state row for a document
// whose owner no longer exists means nothing, the same reasoning
// `Transcript.ownerId`/`Note.ownerId` already establish in this schema.
model SearchIndexState {
  id String @id @default(uuid()) @db.Uuid

  documentType String @map("document_type")
  documentId   String @map("document_id") @db.Uuid

  ownerId String @map("owner_id") @db.Uuid

  // A CLOSED set this application owns end to end — every value is written
  // by code inside this repository, nothing external ever proposes a new
  // one — so, unlike documentType/reason beside it, this IS a Prisma enum.
  // See the migration header's "STATUS" section for the full three-way
  // argument.
  status SearchIndexStatus @default(pending)

  // WHY this document is not (yet, or ever) semantically searchable —
  // `ai_key_missing`, `ai_not_configured`, `dimension_mismatch`, … Plain
  // TEXT and deliberately not an enum: it is a diagnostic string for a human
  // debugging a stuck document, and it will grow new values as new failure
  // modes are discovered. NULL outside of `failed`/`skipped` is itself
  // informative.
  reason String?

  chunkCount Int @default(0) @map("chunk_count")

  // Which embedding model produced the current chunk set, so a later change
  // to the deployment's active model can be detected against rows indexed
  // under an earlier one.
  model String?

  // The per-document hash "has this document's content changed since it was
  // last indexed" is checked against — one comparison, not a full re-chunk,
  // to decide whether a re-index has anything to do at all.
  contentFingerprint String? @map("content_fingerprint")

  lastError String? @map("last_error")

  indexedAt DateTime? @map("indexed_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // ⚠ Cascade. See the block comment above the model.
  owner User @relation("SearchIndexStateOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // One state row per document — the address every read/write of "this
  // document's indexing status" uses.
  @@unique([documentType, documentId])
  // The `unindexedCount` query: "how many of this owner's documents are in
  // state X".
  @@index([ownerId, status])
  @@map("search_index_state")
}

// =============================================================================
// Connected Knowledge (epic #344)
// =============================================================================
//
// The graph foundation: entities, relations, items (commitments, decisions,
// claims, person facts), the evidence that anchors every claim back to a
// transcript segment or note span, and the review-and-commit proposal model
// extraction runs through. Full design in `docs/specs/ontology.md`; §10 is
// this section's own summary, kept in sync with the column list below.
// SCHEMA ONLY in this migration — no service, no endpoint, no data. The
// evidence-invariant trigger is #355's own migration, landing with the code
// that satisfies it; `kg_graph_layouts` and `ask_*` are #371's and #376's
// own migrations.
//
// Five conventions every model below shares, stated once here rather than
// repeated per model:
//
// 1. `owner_id → users.id`, `onDelete: Cascade`, on every table but one. An
//    entity/relation/item/evidence row/mention/proposal/merge/distinct-pair/
//    attribute-def has no meaning and no permission path to read it once its
//    owner is gone — the identical reasoning `notes.owner_id`/
//    `transcripts.owner_id` already establish, and there is no
//    `graph:read_any` for the identical reason there is no `notes:read_any`.
//    `kg_entity_views` is the one exception: it carries `user_id`, because
//    "which entities has THIS user looked at" is a per-viewer fact, not an
//    ownership fact.
// 2. `type`/`kind` columns that name an ONTOLOGY key (`kg_entities.type`,
//    `kg_relations.type`) are plain TEXT, never a Prisma enum — the same
//    "small, code-owned, growing set" reasoning `jobs.type` and
//    `storage_objects.managed_by` already establish elsewhere in this
//    schema. Every enum below instead closes a set this SCHEMA itself
//    enforces (a review lifecycle, a proposal's own status machine) — see
//    §17.4 for the full type-vs-enum argument.
// 3. `props`/`stats`/`user_guidance` JSONB columns default `'{}'` where
//    listed, exactly like `jobs.payload`/`kg_entities.props` elsewhere in
//    this file — an empty object, never NULL, so a reader never has to
//    special-case "no extra data yet" against "extra data exists but is
//    empty."
// 4. `ontology_version` (text) on every row a §17.4 definition-file version
//    could apply to (`kg_entities`, `kg_relations`, `kg_items`) — which
//    version of the ontology's own type/attribute definitions this row was
//    written against, so a later definition-file migration can tell an
//    old row from a new one without re-deriving it.
// 5. `valid tstzrange` (on `kg_relations` and `kg_items`) is written and
//    read entirely OUTSIDE Prisma's query API. Prisma cannot construct,
//    bind, or select a `tstzrange` value — the column is declared
//    `Unsupported("tstzrange")` below specifically so the generated client
//    refuses to touch it at all, the same "declare it unsupported so a
//    mistaken ORM write is impossible" shape `SearchEmbedding.embedding`
//    already establishes for `vector(1536)`. Writers set `valid` with
//    `$executeRaw` inside the SAME transaction as the `create`; readers
//    select `lower(valid)`, `upper(valid)` and `lower_inc(valid)`/
//    `upper_inc(valid)` via `$queryRaw`. #353 provides the `toPgRange`/
//    `fromPgRange` helpers every future reader/writer uses instead of
//    reinventing this.
//
// -----------------------------------------------------------------------------
// WHY THERE IS NO ANCHOR CHECK ON `kg_evidence`.
// -----------------------------------------------------------------------------
//
// Every FK `kg_evidence` holds into another module's table
// (`transcript_id`/`segment_id`/`note_id`/`import_object_id`) is `SetNull`,
// by design (§10) — an evidence row is a CITATION, and a citation survives
// losing the thing it pointed to; `quote` (NOT NULL) is stored precisely so
// the citation stays readable once every anchor has gone to NULL. A CHECK
// requiring at least one anchor to be non-NULL would make deleting a
// transcript FAIL the moment its own evidence rows lose their last pointer —
// exactly the failure `SetNull` exists to avoid. So there is deliberately no
// such CHECK: a fully-anchorless evidence row (every FK NULL, `quote` intact)
// is a valid, expected end state, not a bug to prevent.
//
// -----------------------------------------------------------------------------
// INTENTIONAL SCHEMA DRIFT — HAND-WRITTEN, PRISMA-INEXPRESSIBLE SQL LIVES
// ONLY IN `migration.sql`, THE SAME PATTERN `jobs_active_dedup_uniq_idx` AND
// `search_embeddings_embedding_hnsw_idx` ALREADY ESTABLISH.
// -----------------------------------------------------------------------------
//
// `migration.sql` for this section hand-writes:
//   - `CREATE EXTENSION IF NOT EXISTS pg_trgm` — a new capability for this
//     codebase (pgvector already is not new; `SearchEmbedding` already
//     depends on it). Trusted on PG13+, so the migration role needs no
//     superuser.
//   - Two `gin (… gin_trgm_ops)` trigram indexes (fuzzy candidate generation,
//     §7): `kg_entities_label_trgm_idx`, `kg_entity_aliases_normalized_trgm_idx`.
//   - Two `gist (valid)` range indexes (§5.4's containment/overlap queries):
//     `kg_relations_valid_gist_idx`, `kg_items_valid_gist_idx`.
//   - Two `hnsw (embedding vector_cosine_ops)` indexes, matching
//     `SearchEmbedding`'s own hand-written index discipline exactly:
//     `kg_entities_embedding_hnsw_idx`, `kg_items_embedding_hnsw_idx`.
//   - Five partial unique indexes and one CHECK-shaped guard, all below.
//   - Eight CHECK constraints, all below.
// None of the above has a Prisma DSL equivalent; `prisma migrate dev`/`diff`
// will propose to drop every one of them and must never be asked to
// reconcile that "drift" away.
//
// -----------------------------------------------------------------------------
// FIVE PARTIAL UNIQUE INDEXES, EACH ENFORCED IN THE DATABASE, NEVER BY A
// `findFirst` BEFORE THE INSERT — THE `database_backup_runs_active_uniq_idx`
// REASONING, FIVE TIMES OVER.
// -----------------------------------------------------------------------------
//
//   - `kg_items_live_statement_uniq_idx` — the "known, skipped" dedup guard
//     (§8): a verbatim restatement of an already-`accepted`/`edited` item
//     attaches new evidence instead of inserting a duplicate row. Scoped to
//     `review_status IN ('accepted','edited')` and `subject_id IS NOT NULL`
//     so a `rejected` row's hash never blocks a legitimate later insert.
//   - `kg_proposals_note_draft_uniq_idx` — at most one OPEN draft per note.
//     Whoever creates a new draft discards the previous one in the same
//     transaction (#363); this index is what makes "at most one" true even
//     under a race, not the service-layer discard alone.
//   - `kg_proposals_note_extracting_uniq_idx` — at most one RUNNING
//     extraction per note (#363's 409 `extraction_running`).
//   - `kg_proposals_owner_import_extracting_uniq_idx` — at most one RUNNING
//     import per OWNER (#387's), scoped by `owner_id` rather than `note_id`
//     because an import proposal has no note at all.
//   - `kg_relations_speaker_link_uniq_idx` — at most one `IDENTIFIED_AS`
//     edge per diarized speaker (a speaker names at most one entity).
//
// -----------------------------------------------------------------------------
// EIGHT CHECK CONSTRAINTS.
// -----------------------------------------------------------------------------
//
//   - `kg_distinct_pairs_order_chk` (`a_id < b_id`) — canonicalizes an
//     unordered pair into exactly one storable row, so `(a, b)` and `(b, a)`
//     can never both be inserted as two different "confirmed distinct" facts.
//   - `kg_mentions_one_source_chk` (`num_nonnulls(note_id, transcript_id) =
//     1`) — a mention always comes from exactly one source document.
//   - `kg_relations_one_source_chk` (`num_nonnulls(from_id, from_speaker_id)
//     = 1`) — a relation's `from` side is EITHER a resolved entity OR a
//     diarized speaker awaiting `IDENTIFIED_AS`, never both, never neither.
//   - `kg_relations_speaker_type_chk` (`from_speaker_id IS NULL OR type =
//     'IDENTIFIED_AS'`) — `from_speaker_id` exists for exactly one
//     relation type, and no other.
//   - `kg_relations_valid_precision_chk` (`(valid IS NULL) =
//     (valid_precision IS NULL) OR valid_precision IS NOT DISTINCT FROM
//     'unknown'` — `IS NOT DISTINCT FROM`, not `=`, since #398: with `=` a
//     NULL precision made the CHECK evaluate NULL, which passes) — a
//     temporal relation always states a precision, but `unknown` is
//     representable even should `valid` itself later become NULL (e.g. a
//     future correction that clears a range while a precision is still on
//     record as having once been claimed).
//   - `kg_items_sensitivity_chk` (`(kind = 'person_fact') = (sensitivity IS
//     NOT NULL)`) — sensitivity is meaningful for exactly one item kind
//     (§5.6), and this makes "a claim with a sensitivity" and "a person
//     fact with none" both unrepresentable rather than merely discouraged.
//   - `kg_items_subject_required_chk` (`kind NOT IN ('claim','person_fact')
//     OR subject_id IS NOT NULL`) — a claim or a person fact is always
//     ABOUT something; a commitment/decision may stand on its own.
//   - `kg_evidence_char_range_chk` / `kg_evidence_ms_range_chk` — an end
//     offset, when both ends are given, is never before its start.
//   - `kg_proposal_items_kind_payload_chk` (`jsonb_typeof(payload) =
//     'object'`) — `payload` is always a JSON object, never a bare array or
//     scalar, so every reader can assume key access without a type guard.
//   - `kg_proposal_items_merge_into_chk` (`merge_into_id IS NULL OR decision
//     = 'merge_into'`) — the override column and the decision it overrides
//     can never disagree about which decision this row represents.
//     `merge_into_id` is `SetNull`: forgetting or purging the target entity
//     clears the override, and the row falls back to `pending` semantics at
//     commit (#366 refuses a `merge_into` row without a target).
//   - `kg_proposals_note_source_chk` (`CASE WHEN kind = 'extraction' THEN
//     note_version IS NOT NULL ELSE note_id IS NULL AND note_version IS
//     NULL END`) — keys on `note_version`, NEVER on `note_id`, and this is
//     deliberate: `note_id` is inserted non-null for every extraction
//     proposal and can only become NULL afterwards through the note's own
//     `SetNull` FK once the note is hard-deleted. A CHECK keyed on `note_id`
//     would then start failing for rows that were valid when written; a
//     CHECK keyed on `note_version` (never nulled by any FK action) stays
//     satisfied for the life of the row.
//
// -----------------------------------------------------------------------------
// FUTURE MIGRATIONS: when a later `prisma migrate dev` proposes `DROP INDEX`
// for any hand-written name above, DELETE those proposed lines. This is
// intentional drift, not decay to fix.
// =============================================================================

enum KgReviewStatus {
  unreviewed
  accepted
  edited
  rejected
  merged
  superseded

  @@map("kg_review_status")
}

enum KgValidPrecision {
  day
  month
  year
  unknown

  @@map("kg_valid_precision")
}

enum KgItemKind {
  commitment
  decision
  claim
  person_fact

  @@map("kg_item_kind")
}

enum KgSensitivity {
  business
  personal
  sensitive

  @@map("kg_sensitivity")
}

enum KgAliasSource {
  user
  extraction
  speaker_naming
  import

  @@map("kg_alias_source")
}

enum KgEvidenceSubjectKind {
  entity
  relation
  item
  proposal_item
  import

  @@map("kg_evidence_subject_kind")
}

enum KgMentionStatus {
  suggested
  linked
  new
  ignored

  @@map("kg_mention_status")
}

// The COMPLETE proposal model, up front — every status and kind #363, #364,
// #366 and #387 need, so none of them ever needs `ALTER TYPE … ADD VALUE` or
// a proposal-table migration of its own. `extracting`/`resolution` are used
// by no code yet; #363 owns the prose for the `extracting` lifecycle and the
// `resolution` kind, this migration owns only the column list (issue #351).
enum KgProposalKind {
  extraction
  import
  resolution

  @@map("kg_proposal_kind")
}

// Lifecycle: `extracting → draft | failed`, `draft → committed | discarded`,
// `failed → discarded`, `committed → reverted`. Transitions are enforced by
// the SERVICES (#363/#366), not by a database trigger — this enum only
// closes the set of states a row may ever be in.
enum KgProposalStatus {
  draft
  extracting
  committed
  discarded
  failed
  reverted

  @@map("kg_proposal_status")
}

enum KgProposalItemKind {
  entity
  relation
  item
  closing

  @@map("kg_proposal_item_kind")
}

enum KgProposalItemDecision {
  pending
  accept
  edit
  reject
  merge_into

  @@map("kg_proposal_item_decision")
}

enum KgProposalItemOrigin {
  ai
  user

  @@map("kg_proposal_item_origin")
}

enum KgAttributeKind {
  text
  number
  date
  boolean
  select
  multi_select
  url
  entity_ref

  @@map("kg_attribute_kind")
}

// -----------------------------------------------------------------------------
// `kg_entities` — Person, Organization, Project, Meeting (`type` is a plain
// ontology key, §17.4 — never a Prisma enum; see the section header above).
// `owner_id` Cascade — see convention 1 above. `embedding vector(1536)`
// reuses the EXACT model/dimension contract `SearchEmbedding` already
// carries (see that model's own block comment for the full "why
// `Unsupported`, why raw SQL" argument) rather than inventing a second
// embedding convention; `embedding_hash` is the content hash #364's
// `kg.embed` keys re-embedding on, mirroring `SearchChunk.contentHash`.
// `merged_into_id` is a self-relation: once an entity is merged into
// another (§7), this points at the survivor and `review_status` moves to
// `merged` — SetNull so deleting the survivor un-merges rather than
// cascading a delete backward onto every entity it absorbed.
// `occurred_at` is set on `Meeting` rows only (the ontology's own type
// contract, not a database constraint — a fork's own type could reuse it
// differently).
// -----------------------------------------------------------------------------
model KgEntity {
  id String @id @default(uuid()) @db.Uuid

  ownerId String @map("owner_id") @db.Uuid
  type    String
  label   String
  props   Json   @default("{}") @db.JsonB

  // See the section header's convention 5 — `Unsupported`, written/read only
  // through `$executeRaw`/`$queryRaw`, matching `SearchEmbedding.embedding`.
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?                      @map("embedding_model")
  embeddingHash  String?                      @map("embedding_hash")

  reviewStatus KgReviewStatus @default(accepted) @map("review_status")
  mergedIntoId String?        @map("merged_into_id") @db.Uuid
  occurredAt   DateTime?      @map("occurred_at") @db.Timestamptz

  ontologyVersion String   @map("ontology_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mergedInto KgEntity? @relation("KgEntityMergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)

  mergedFrom              KgEntity[]       @relation("KgEntityMergedInto")
  aliases                 KgEntityAlias[]
  relationsFrom           KgRelation[]     @relation("KgRelationFrom")
  relationsTo             KgRelation[]     @relation("KgRelationTo")
  itemsAsSubject          KgItem[]         @relation("KgItemSubject")
  itemsAsMeeting          KgItem[]         @relation("KgItemMeeting")
  itemsAsOwnerPerson      KgItem[]         @relation("KgItemOwnerPerson")
  itemsAsCounterparty     KgItem[]         @relation("KgItemCounterparty")
  mentions                KgMention[]
  proposalItemsMergedInto KgProposalItem[] @relation("KgProposalItemMergeInto")
  mergesAsSurvivor        KgMerge[]        @relation("KgMergeSurvivor")
  mergesAsMerged          KgMerge[]        @relation("KgMergeMerged")
  distinctPairsAsA        KgDistinctPair[] @relation("KgDistinctPairA")
  distinctPairsAsB        KgDistinctPair[] @relation("KgDistinctPairB")
  digest                  KgEntityDigest?
  views                   KgEntityView[]

  // "This owner's entities of type X, by review state" and "this owner's
  // entities, recently updated" — the two shapes an entity list/filter reads.
  @@index([ownerId, type, reviewStatus])
  @@index([ownerId, updatedAt(sort: Desc)])
  // "Every entity that merged into this one" — the merge-reversal read path.
  @@index([mergedIntoId])
  // HAND-WRITTEN in migration.sql only: `kg_entities_label_trgm_idx` (gin,
  // gin_trgm_ops) and `kg_entities_embedding_hnsw_idx` (hnsw,
  // vector_cosine_ops). See the section header's "INTENTIONAL SCHEMA DRIFT"
  // note — Prisma has no DSL for either.
  @@map("kg_entities")
}

// -----------------------------------------------------------------------------
// `kg_entity_aliases` — a SEPARATE table, not an array column on
// `kg_entities`, specifically because an alias needs its own indexed
// exact/fuzzy lookup AND its own provenance (`source`) — an array column
// could hold the strings but not which of four very different origins each
// one came from (§10). `normalized` is produced by #355's `normalizeAlias()`
// (NFKC, lowercase, trimmed, whitespace collapsed) — this REPLACES `citext`,
// which is not installed and is not needed: a normalized `text` column
// produced by one pure function gives exact matching AND feeds `pg_trgm`
// directly, at the cost of nothing `citext` would have bought here.
// `entity_id`/`owner_id` both Cascade — an alias has no meaning once either
// its entity or its owner is gone.
// -----------------------------------------------------------------------------
model KgEntityAlias {
  id       String @id @default(uuid()) @db.Uuid
  entityId String @map("entity_id") @db.Uuid
  ownerId  String @map("owner_id") @db.Uuid

  alias      String
  // See the block comment above the model for the full `normalizeAlias()`
  // argument — this is why there is no `citext` column here.
  normalized String

  source KgAliasSource

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  entity KgEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  owner  User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // One alias per (entity, normalized form) — a repeat submission of the
  // identically-normalized alias is a no-op, not a duplicate row.
  @@unique([entityId, normalized])
  @@index([ownerId, normalized])
  @@index([entityId])
  // HAND-WRITTEN in migration.sql only: `kg_entity_aliases_normalized_trgm_idx`
  // (gin, gin_trgm_ops) — fuzzy candidate generation (§7). See the section
  // header's "INTENTIONAL SCHEMA DRIFT" note.
  @@map("kg_entity_aliases")
}

// -----------------------------------------------------------------------------
// `kg_relations` — `type` is one of §5.2's sixteen ontology edge types
// (plain text, never a Prisma enum — convention 2 above). No inverse row is
// EVER stored (§5.2): a "from" side is either a resolved `KgEntity`
// (`from_id`) or a diarized speaker awaiting identification
// (`from_speaker_id`) — `kg_relations_one_source_chk` makes exactly one of
// the two representable, and `kg_relations_speaker_type_chk` restricts
// `from_speaker_id` to the one relation type (`IDENTIFIED_AS`) whose source
// is a speaker rather than an entity. This is a contract addition beyond
// spec §10's original text (§5.1/§5.2): a polymorphic `from_kind`/`from_id`
// pair without FKs was rejected in favour of a REAL FK to
// `transcript_speakers`, so deleting a merged speaker's row cleans up the
// edge for free. `valid`/`valid_precision` are the §5.4 bitemporal pair —
// see the section header's convention 5 for how `valid` is actually
// written/read. `superseded_by_id` is a self-relation (§5.5's "closing a
// temporal edge" case), SetNull so deleting the successor un-supersedes
// rather than cascading backward.
// -----------------------------------------------------------------------------
model KgRelation {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  type    String

  // Endpoints — see the block comment above the model for the full
  // exactly-one-of argument enforced by `kg_relations_one_source_chk`.
  fromId        String? @map("from_id") @db.Uuid
  fromSpeakerId String? @map("from_speaker_id") @db.Uuid
  toId          String  @map("to_id") @db.Uuid

  props Json @default("{}") @db.JsonB

  // §5.4's bitemporal pair. See the section header's convention 5 for why
  // `valid` is `Unsupported` and written/read only via raw SQL.
  valid          Unsupported("tstzrange")?
  validPrecision KgValidPrecision?         @map("valid_precision")

  reviewStatus   KgReviewStatus @default(accepted) @map("review_status")
  confidence     Float?
  supersededById String?        @map("superseded_by_id") @db.Uuid

  ontologyVersion String   @map("ontology_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fromEntity   KgEntity?          @relation("KgRelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  fromSpeaker  TranscriptSpeaker? @relation(fields: [fromSpeakerId], references: [id], onDelete: Cascade)
  toEntity     KgEntity           @relation("KgRelationTo", fields: [toId], references: [id], onDelete: Cascade)
  supersededBy KgRelation?        @relation("KgRelationSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)

  supersedes KgRelation[] @relation("KgRelationSupersededBy")

  // §5.2's "joins are symmetric" argument, made concrete: a relation is
  // looked up from either endpoint equally often.
  @@index([ownerId, fromId, type])
  @@index([ownerId, toId, type])
  @@index([fromSpeakerId])
  @@index([supersededById])
  @@index([ownerId, type, reviewStatus])
  // HAND-WRITTEN in migration.sql only: `kg_relations_valid_gist_idx` (gist,
  // §5.4's containment/overlap queries) and `kg_relations_speaker_link_uniq_idx`
  // (a partial unique index — see the section header). See the section
  // header's "INTENTIONAL SCHEMA DRIFT" note.
  @@map("kg_relations")
}

// -----------------------------------------------------------------------------
// `kg_items` — Commitment, Decision, Claim, and PersonFact in ONE table,
// distinguished by `kind` (a real Prisma enum here, unlike `kg_entities
// .type`/`kg_relations.type` — see §10, this is the schema's own closed
// four-way split, not an open ontology key). `meeting_id` backs
// `CREATED_IN`/`DECIDED_IN` (a contract addition beyond the original §10
// text) — SetNull, so deleting the meeting entity leaves the item itself
// intact with a now-unknown venue rather than deleting the item.
// `owner_person_id`/`counterparty_id` Cascade (deleting the person this
// commitment is FOR/BETWEEN removes the commitment's meaning entirely, the
// same argument as `subject_id`); `subject_id` also Cascade. `sensitivity`
// is meaningful for exactly one `kind` (§5.6), enforced by
// `kg_items_sensitivity_chk`. `statement_hash` is the §7 dedup/suppression
// key `kg_items_live_statement_uniq_idx` enforces. `valid`/`valid_precision`
// mirror `kg_relations`'s own bitemporal pair (§5.4) so an item's own valid
// period is never a second stored shape from its edges' shape.
// -----------------------------------------------------------------------------
model KgItem {
  id      String     @id @default(uuid()) @db.Uuid
  ownerId String     @map("owner_id") @db.Uuid
  kind    KgItemKind

  subjectId      String? @map("subject_id") @db.Uuid
  meetingId      String? @map("meeting_id") @db.Uuid
  ownerPersonId  String? @map("owner_person_id") @db.Uuid
  counterpartyId String? @map("counterparty_id") @db.Uuid

  title     String?
  // Commitment: `open | done | dropped | superseded`. Others: `active |
  // superseded`. Plain text, not an enum — the same "small, code-owned set
  // that varies per `kind`" reasoning `props`/§10 already give this table
  // its single-table shape for.
  statement String
  status    String
  props     Json    @default("{}") @db.JsonB

  occurredAt DateTime? @map("occurred_at") @db.Timestamptz
  dueAt      DateTime? @map("due_at") @db.Timestamptz

  supersededById String?        @map("superseded_by_id") @db.Uuid
  sensitivity    KgSensitivity?
  // The §7 dedup/suppression key — see `kg_items_live_statement_uniq_idx`
  // below (hand-written, since Prisma cannot express its `WHERE` clause).
  statementHash  String         @map("statement_hash")

  // §5.4's bitemporal pair, mirroring `kg_relations` exactly. See the
  // section header's convention 5 for why `valid` is `Unsupported`.
  valid          Unsupported("tstzrange")?
  validPrecision KgValidPrecision?         @map("valid_precision")

  // See the section header's convention 5 — same `Unsupported`/raw-SQL
  // contract as `kg_entities.embedding` and `SearchEmbedding.embedding`.
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?                      @map("embedding_model")
  embeddingHash  String?                      @map("embedding_hash")

  reviewStatus KgReviewStatus @default(accepted) @map("review_status")
  confidence   Float?

  ontologyVersion String   @map("ontology_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subject      KgEntity? @relation("KgItemSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  meeting      KgEntity? @relation("KgItemMeeting", fields: [meetingId], references: [id], onDelete: SetNull)
  ownerPerson  KgEntity? @relation("KgItemOwnerPerson", fields: [ownerPersonId], references: [id], onDelete: Cascade)
  counterparty KgEntity? @relation("KgItemCounterparty", fields: [counterpartyId], references: [id], onDelete: Cascade)
  supersededBy KgItem?   @relation("KgItemSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)

  supersedes KgItem[] @relation("KgItemSupersededBy")

  // §9.1's "what's changed for this entity" brief query.
  @@index([ownerId, subjectId, occurredAt(sort: Desc)])
  @@index([ownerId, kind, status])
  @@index([ownerId, statementHash])
  @@index([ownerPersonId])
  @@index([counterpartyId])
  @@index([meetingId])
  @@index([supersededById])
  // HAND-WRITTEN in migration.sql only: `kg_items_valid_gist_idx` (gist),
  // `kg_items_embedding_hnsw_idx` (hnsw, vector_cosine_ops), and
  // `kg_items_live_statement_uniq_idx` (a partial unique index — the "known,
  // skipped" §8 dedup guard). See the section header's "INTENTIONAL SCHEMA
  // DRIFT" note.
  @@map("kg_items")
}

// -----------------------------------------------------------------------------
// `kg_evidence` — the §5.3 evidence contract. `subject_kind`/`subject_id`
// are POLYMORPHIC, carrying NO foreign key — the identical `jobs.subject_
// type`/`subject_id` pattern this schema already uses, because the set of
// things evidence can anchor (an entity, a relation, an item, a proposal
// item, an import) is open-ended and code-owned. The transcript/note/import
// anchors ARE real foreign keys, and every one of them is `SetNull` — see
// the section header's "WHY THERE IS NO ANCHOR CHECK" note for the full
// argument; `quote` (NOT NULL) is what keeps a citation readable once every
// anchor has gone to NULL. `char_start`/`char_end` are offsets into the
// cited NOTE VERSION BODY when `note_id` is set, or into the cited
// SEGMENT'S TEXT when `segment_id` is set — NULL means the whole segment.
// #363 relies on this exact convention; do not reinterpret it per-caller.
// -----------------------------------------------------------------------------
model KgEvidence {
  id          String                @id @default(uuid()) @db.Uuid
  ownerId     String                @map("owner_id") @db.Uuid
  subjectKind KgEvidenceSubjectKind @map("subject_kind")
  // Polymorphic, no FK — see the block comment above the model.
  subjectId   String                @map("subject_id") @db.Uuid

  // Transcript anchor. SetNull — see the section header's "WHY THERE IS NO
  // ANCHOR CHECK" note.
  transcriptId String? @map("transcript_id") @db.Uuid
  segmentId    String? @map("segment_id") @db.Uuid
  segmentRev   Int?    @map("segment_rev")
  startMs      Int?    @map("start_ms")
  endMs        Int?    @map("end_ms")

  // Note anchor. SetNull, same reasoning.
  noteId      String? @map("note_id") @db.Uuid
  noteVersion Int?    @map("note_version")

  // Offsets into the cited NOTE VERSION BODY when `noteId` is set, or into
  // the cited SEGMENT'S TEXT when `segmentId` is set. NULL means the whole
  // segment. See the block comment above the model — #363 reads this
  // convention directly.
  charStart Int? @map("char_start")
  charEnd   Int? @map("char_end")

  // The text AT ANCHORING TIME (§5.3) — NOT NULL, deliberately: this is
  // what keeps the citation readable once every anchor above has gone to
  // NULL (see the section header's "WHY THERE IS NO ANCHOR CHECK" note).
  quote String

  // Import anchor. SetNull, same reasoning.
  importObjectId String? @map("import_object_id") @db.Uuid
  sourceIri      String? @map("source_iri")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transcript   Transcript?        @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  segment      TranscriptSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  note         Note?              @relation(fields: [noteId], references: [id], onDelete: SetNull)
  importObject StorageObject?     @relation(fields: [importObjectId], references: [id], onDelete: SetNull)

  @@index([subjectKind, subjectId])
  @@index([ownerId, transcriptId])
  @@index([segmentId])
  @@index([ownerId, noteId])
  @@map("kg_evidence")
}

// -----------------------------------------------------------------------------
// `kg_mentions` — the coarse `MENTIONS` shortcut (§5.2): what an entity
// page's "notes about Joe" section reads, distinct from `kg_evidence`'s
// precise per-claim citation. Exactly one source document per row
// (`kg_mentions_one_source_chk`). `entity_id`/`note_id`/`transcript_id` ALL
// Cascade — a mention has no meaning once either side is gone, the opposite
// of `kg_evidence`'s pointer relationship above.
// -----------------------------------------------------------------------------
model KgMention {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid

  entityId String @map("entity_id") @db.Uuid

  noteId       String? @map("note_id") @db.Uuid
  transcriptId String? @map("transcript_id") @db.Uuid

  // `{charStart,charEnd}` or `{segmentId}` — which shape depends on which of
  // `noteId`/`transcriptId` is set.
  span   Json?           @db.JsonB
  status KgMentionStatus @default(linked)
  score  Float?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entity     KgEntity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  note       Note?       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  transcript Transcript? @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([ownerId, entityId])
  @@index([noteId])
  @@index([transcriptId])
  // HAND-WRITTEN in migration.sql only: `kg_mentions_one_source_chk`. See
  // the section header's "EIGHT CHECK CONSTRAINTS" note.
  @@map("kg_mentions")
}

// -----------------------------------------------------------------------------
// `kg_proposals` — one row per extraction, import, or resolution run
// (§8, §18.3; the complete kind/status enums are declared above THIS
// migration, issue #351, so #363/#364/#366/#387 never need `ALTER TYPE`).
// Only `kind = 'extraction'` has a note — `kg_proposals_note_source_chk`
// requires `note_version` for `extraction` and requires BOTH `note_id` AND
// `note_version` NULL for `import`/`resolution`. The CHECK keys on
// `note_version`, never `note_id`: `note_id` is inserted non-null for every
// extraction and can only become NULL afterwards via the note's own
// `SetNull` FK once the note is hard-deleted, so a CHECK on `note_id` would
// start failing for rows that were valid when written. `commit_log` is
// #366's internal undo record — the commit writes it, the revert reads it —
// and it is NEVER serialized to clients; `stats` is the display copy.
// `job_id` mirrors `TranscriptExport.jobId` exactly (`@unique`, nullable,
// SetNull): a proposal's own review lifetime is independent of
// `job.history.purge`'s schedule for the job row.
// -----------------------------------------------------------------------------
model KgProposal {
  id      String           @id @default(uuid()) @db.Uuid
  ownerId String           @map("owner_id") @db.Uuid
  kind    KgProposalKind
  status  KgProposalStatus @default(draft)

  // Only `kind = 'extraction'` has a note. See the block comment above the
  // model for why `kg_proposals_note_source_chk` keys on `noteVersion`.
  noteId      String? @map("note_id") @db.Uuid
  noteVersion Int?    @map("note_version")

  // Generation context — which task-model resolution actually ran (§20),
  // recorded rather than re-derived, so an administrator changing the
  // default tomorrow never rewrites what an already-committed proposal used
  // yesterday.
  model        String?
  provider     String?
  systemPrompt String? @map("system_prompt")
  userContent  String? @map("user_content")
  userGuidance Json?   @map("user_guidance") @db.JsonB

  stats Json @default("{}") @db.JsonB

  committedAt DateTime? @map("committed_at") @db.Timestamptz
  revertedAt  DateTime? @map("reverted_at") @db.Timestamptz
  jobId       String?   @unique @map("job_id") @db.Uuid

  // #366's internal undo record — the commit writes it, the revert reads
  // it. NEVER serialized to clients; `stats` above is the display copy.
  commitLog Json? @map("commit_log") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  note  Note? @relation(fields: [noteId], references: [id], onDelete: SetNull)
  job   Job?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  items KgProposalItem[]

  @@index([ownerId, status, createdAt(sort: Desc)])
  @@index([noteId, createdAt(sort: Desc)])
  // HAND-WRITTEN in migration.sql only: `kg_proposals_note_draft_uniq_idx`,
  // `kg_proposals_note_extracting_uniq_idx`,
  // `kg_proposals_owner_import_extracting_uniq_idx` (three partial unique
  // indexes) and `kg_proposals_note_source_chk`. See the section header's
  // "FIVE PARTIAL UNIQUE INDEXES" / "EIGHT CHECK CONSTRAINTS" notes.
  @@map("kg_proposals")
}

// -----------------------------------------------------------------------------
// `kg_proposal_items` — one row per proposed entity, relation, item, or
// closing edit (`closing` is §7's "closing a temporal edge is a proposal
// row" case). `merge_into_id`/`distinct_from` are #366's reviewer-override
// columns, declared up front by this migration (issue #351) so #366 needs
// no schema change of its own: `merge_into_id` is set IFF `decision =
// 'merge_into'` (`kg_proposal_items_merge_into_chk`), SetNull so losing the
// target entity clears the override rather than blocking the delete;
// `distinct_from` records the "not the same as" candidates a reviewer ruled
// out, as plain uuids (no FK — these are recorded facts about a review
// decision, not live references another table's delete must cascade
// through). `committed_ref_id` is polymorphic (no FK), the row this item
// became once committed — #366's revert reads this to know exactly what to
// undo.
// -----------------------------------------------------------------------------
model KgProposalItem {
  id         String             @id @default(uuid()) @db.Uuid
  proposalId String             @map("proposal_id") @db.Uuid
  kind       KgProposalItemKind

  payload       Json  @db.JsonB
  resolution    Json? @db.JsonB
  editedPayload Json? @map("edited_payload") @db.JsonB

  decision KgProposalItemDecision @default(pending)
  // Values from #363's `PROPOSAL_ITEM_FLAGS` — plain text[], not an enum:
  // the review panel's pre-check flags are a growing, code-owned set, the
  // same reasoning `kg_entities.type` stays plain text.
  flags    String[]               @default([])
  origin   KgProposalItemOrigin   @default(ai)

  // #366's reviewer-override columns. See the block comment above the model
  // for the exactly-one-decision argument `kg_proposal_items_merge_into_chk`
  // enforces, and why `mergeIntoId` is SetNull.
  mergeIntoId  String?  @map("merge_into_id") @db.Uuid
  distinctFrom String[] @default([]) @map("distinct_from")

  // Polymorphic, no FK — the `kg_entities`/`kg_relations`/`kg_items` row
  // this item became once committed.
  committedRefId String? @map("committed_ref_id") @db.Uuid
  sortOrder      Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  proposal  KgProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  mergeInto KgEntity?  @relation("KgProposalItemMergeInto", fields: [mergeIntoId], references: [id], onDelete: SetNull)

  @@index([proposalId, kind, sortOrder])
  // HAND-WRITTEN in migration.sql only: `kg_proposal_items_kind_payload_chk`
  // and `kg_proposal_items_merge_into_chk`. See the section header's "EIGHT
  // CHECK CONSTRAINTS" note.
  @@map("kg_proposal_items")
}

// One row per merge (§7), with the full reversal payload — what #366 (and
// an entity page's "undo merge" action) replays to restore the merged
// entity. `survivor_id`/`merged_id` both Cascade: a merge record has no
// meaning once either entity it names is gone.
model KgMerge {
  id         String @id @default(uuid()) @db.Uuid
  ownerId    String @map("owner_id") @db.Uuid
  survivorId String @map("survivor_id") @db.Uuid
  mergedId   String @map("merged_id") @db.Uuid

  reversal   Json      @db.JsonB
  reversedAt DateTime? @map("reversed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  survivor KgEntity @relation("KgMergeSurvivor", fields: [survivorId], references: [id], onDelete: Cascade)
  merged   KgEntity @relation("KgMergeMerged", fields: [mergedId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([survivorId])
  @@index([mergedId])
  @@map("kg_merges")
}

// Confirmed-NOT-the-same pairs (§7), skipped by every future
// candidate-generation pass. `a_id < b_id` is enforced by
// `kg_distinct_pairs_order_chk` (hand-written — Prisma cannot express a
// cross-column CHECK), so `(a, b)` and `(b, a)` can never both exist as two
// different rows for what is the same unordered fact. Both entity FKs
// Cascade.
model KgDistinctPair {
  ownerId String @map("owner_id") @db.Uuid
  aId     String @map("a_id") @db.Uuid
  bId     String @map("b_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entityA KgEntity @relation("KgDistinctPairA", fields: [aId], references: [id], onDelete: Cascade)
  entityB KgEntity @relation("KgDistinctPairB", fields: [bId], references: [id], onDelete: Cascade)

  @@id([ownerId, aId, bId])
  // HAND-WRITTEN in migration.sql only: `kg_distinct_pairs_order_chk`. See
  // the section header's "EIGHT CHECK CONSTRAINTS" note.
  @@map("kg_distinct_pairs")
}

// One row per user-defined attribute (§17.3) — the schema half of the
// ontology's user-extensibility story. `owner_id` Cascade, the same
// reasoning every other `kg_*` table's `owner_id` follows.
model KgAttributeDef {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid

  entityType String          @map("entity_type")
  key        String
  label      String
  kind       KgAttributeKind
  options    Json?           @db.JsonB

  extractable    Boolean @default(false)
  extractionHint String? @map("extraction_hint")

  sensitivity  KgSensitivity?
  sortOrder    Int            @default(0) @map("sort_order")
  deprecatedAt DateTime?      @map("deprecated_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, entityType, key])
  @@index([ownerId, entityType, sortOrder])
  @@map("kg_attribute_defs")
}

// §9.2's precomputed entity brief — "precompute once, read cheaply," the
// same economy `kg_graph_layouts` (its own, later migration) applies to a
// whole-graph layout. `entity_id` is the PRIMARY KEY (not a separate `id`):
// there is exactly one digest per entity, always replaced in place, never
// versioned.
model KgEntityDigest {
  entityId String @id @map("entity_id") @db.Uuid
  ownerId  String @map("owner_id") @db.Uuid

  summary     String
  citations   Json     @db.JsonB
  coversUntil DateTime @map("covers_until") @db.Timestamptz
  model       String
  generatedAt DateTime @map("generated_at") @db.Timestamptz

  entity KgEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  owner  User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("kg_entity_digests")
}

// (user_id, entity_id, last_viewed_at) — §9.2's "recently viewed" list. The
// ONE table in this section keyed on `user_id`, not `owner_id` — see
// convention 1 above: which entities a viewer has looked at is a per-viewer
// fact, not an ownership fact (a shared/admin view is out of scope today,
// but the column name is deliberately not `owner_id` so it never implies
// one). A plain `@@unique`, exactly as issue #351's canonical column list
// specifies — NOT the partial unique §10's prose mentions elsewhere;
// nothing about this row is conditional.
model KgEntityView {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  entityId     String   @map("entity_id") @db.Uuid
  lastViewedAt DateTime @map("last_viewed_at") @db.Timestamptz

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity KgEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
  @@map("kg_entity_views")
}
