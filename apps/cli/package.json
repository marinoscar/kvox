{
  "name": "cli",
  "version": "1.10.4",
  "private": true,
  "description": "First-party command-line client for the API (epic #110), built on @marinoscar/platform-cli (epic #478).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kvox": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured'",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:ci": "vitest run --coverage --passWithNoTests --reporter=junit --outputFile=junit.xml"
  },
  "dependencies": {
    "@app/shared": "*",
    "@marinoscar/platform-cli": "0.1.0-next.11",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
