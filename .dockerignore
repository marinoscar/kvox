# =============================================================================
# Docker build context exclusions (repo root)
# =============================================================================
# Both apps/api/Dockerfile and apps/web/Dockerfile build from the repository
# root so that package-lock.json is reachable. That makes the context the whole
# repo, so trimming it here matters for build speed.
#
# Do NOT exclude: package.json, package-lock.json, apps/*/package.json,
# packages/ (the api and web images both install @app/shared as a workspace
# dependency and copy the package itself), scripts/, tsconfig*.json, or
# apps/api/prisma/ — the builds need all of them.
# =============================================================================

# Dependencies - always installed inside the image via npm ci
**/node_modules

# Build outputs
**/dist
**/build
**/*.tsbuildinfo

# Git and worktrees
.git
.gitignore
worktrees

# Secrets and local environment - must never enter an image layer
**/.env
**/.env.*
!**/.env.example

# Test artifacts and coverage
**/coverage
**/.nyc_output
**/junit.xml
**/test-results.json

# Infrastructure and CI (not needed by app images)
infra
.github

# Documentation
docs
*.md

# IDE and OS
.vscode
.idea
**/*.swp
**/*.swo
**/.DS_Store
**/Thumbs.db

# Logs and caches
**/logs
**/*.log
**/.cache

# Local databases
**/*.db
**/*.db-journal
