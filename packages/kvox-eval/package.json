{
  "name": "@marinoscar/kvox-eval",
  "version": "0.1.0-next.0",
  "description": "The KVox knowledge-graph and Ask evaluation: the synthetic golden set, its schemas, the scorers, the report and the live runners, over the model port only (CommonJS, with the kvox-eval CLI).",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinoscar/kvox.git",
    "directory": "packages/kvox-eval"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kvox-eval": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ask-run": {
      "types": "./dist/ask-run/index.d.ts",
      "default": "./dist/ask-run/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "default": "./dist/fixtures/index.js"
    },
    "./parity": {
      "types": "./dist/parity/index.d.ts",
      "default": "./dist/parity/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fixtures",
    "parity",
    "host",
    "!host/prisma.config.ts",
    "!host/.stamp",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare:host": "node scripts/prepare-host.mjs",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && node scripts/prepare-host.mjs",
    "prepack": "node ../../scripts/kvox-packages/copy-license.mjs",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "pretypecheck": "node scripts/prepare-host.mjs",
    "typecheck": "tsc --noEmit",
    "predocs": "node scripts/prepare-host.mjs",
    "docs": "typedoc --options typedoc.json",
    "pretest": "node scripts/prepare-host.mjs",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js -c test/jest.config.js",
    "pretest:run": "node scripts/prepare-host.mjs",
    "test:run": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js -c test/jest.config.js --ci"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@electric-sql/pglite-socket": "0.2.13",
    "@marinoscar/kvox-ai": ">=0.0.0-0 || >=0.1.0-0",
    "@marinoscar/kvox-api": ">=0.0.0-0 || >=0.1.0-0",
    "@marinoscar/kvox-contract": ">=0.0.0-0 || >=0.1.0-0",
    "@marinoscar/platform-ai-providers": "0.1.0-next.6",
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@electric-sql/pglite-socket": "0.2.13",
    "@marinoscar/kvox-ai": "0.1.0-next.0",
    "@marinoscar/kvox-api": "0.1.0-next.0",
    "@marinoscar/kvox-contract": "0.1.0-next.0",
    "@marinoscar/kvox-db": "0.1.0-next.0",
    "@marinoscar/platform-ai-providers": "0.1.0-next.6",
    "@marinoscar/platform-db": "0.1.0-next.5",
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/config": "^7.8.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.32",
    "jest": "^30.4.2",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
