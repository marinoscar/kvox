{
  "name": "@marinoscar/kvox-web",
  "version": "0.0.0",
  "description": "The React side of the KVox domain: pages, components and hooks, one subpath per slice (ESM).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinoscar/kvox.git",
    "directory": "packages/kvox-web"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    "./core/headless": {
      "types": "./dist/core/headless/index.d.ts",
      "default": "./dist/core/headless/index.js"
    },
    "./core/ui": {
      "types": "./dist/core/ui/index.d.ts",
      "default": "./dist/core/ui/index.js"
    },
    "./core/testing": {
      "types": "./dist/core/testing/index.d.ts",
      "default": "./dist/core/testing/index.js"
    },
    "./transcription/headless": {
      "types": "./dist/transcription/headless/index.d.ts",
      "default": "./dist/transcription/headless/index.js"
    },
    "./transcription/ui": {
      "types": "./dist/transcription/ui/index.d.ts",
      "default": "./dist/transcription/ui/index.js"
    },
    "./search/headless": {
      "types": "./dist/search/headless/index.d.ts",
      "default": "./dist/search/headless/index.js"
    },
    "./search/ui": {
      "types": "./dist/search/ui/index.d.ts",
      "default": "./dist/search/ui/index.js"
    },
    "./transcripts/headless": {
      "types": "./dist/transcripts/headless/index.d.ts",
      "default": "./dist/transcripts/headless/index.js"
    },
    "./transcripts/ui": {
      "types": "./dist/transcripts/ui/index.d.ts",
      "default": "./dist/transcripts/ui/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/kvox-packages/copy-license.mjs",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc --options typedoc.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "@marinoscar/kvox-contract": ">=0.0.0-0 || >=0.1.0-0",
    "@marinoscar/platform-web": "0.1.0-next.5",
    "@mui/icons-material": "^9.1.0",
    "@mui/material": "^9.1.0",
    "@tanstack/react-virtual": "^3.14.12",
    "@testing-library/react": "^16.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0"
  },
  "peerDependenciesMeta": {
    "@marinoscar/platform-web": {
      "optional": true
    },
    "@mui/icons-material": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    },
    "@tanstack/react-virtual": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.0",
    "@mui/material": "^9.1.0",
    "@tanstack/react-virtual": "^3.14.12",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.32",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vitest-axe": "^1.0.0-pre.5"
  }
}
