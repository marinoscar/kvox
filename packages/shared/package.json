{
  "name": "@app/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-app constants. Home of APP_NAME - the one line a fork edits to rebrand.",
  "type": "commonjs",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./ontology": {
      "types": "./ontology/index.d.ts",
      "default": "./ontology/index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "identity.json",
    "ontology"
  ],
  "scripts": {
    "build:ontology": "tsc -p tsconfig.ontology.json",
    "typecheck": "tsc -p tsconfig.ontology.json --noEmit",
    "lint": "echo 'No linter configured'"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
