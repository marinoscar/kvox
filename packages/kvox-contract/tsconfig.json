{
  // Typecheck only (`npm run typecheck`, the editor, the ESLint resolver). The
  // package is "type": "module", so under NodeNext a relative import needs its
  // `.js` extension; leaving it out typechecks nowhere and fails at run time
  // with ERR_MODULE_NOT_FOUND.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
