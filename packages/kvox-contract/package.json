{
  "name": "@marinoscar/kvox-contract",
  "version": "0.1.0-next.13",
  "description": "Zod wire schemas, error codes and the ontology of the KVox domain, shared by the API, the web app and any other host. Dual CommonJS + ESM.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinoscar/kvox.git",
    "directory": "packages/kvox-contract"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./transcription": {
      "import": {
        "types": "./dist/esm/transcription/index.d.ts",
        "default": "./dist/esm/transcription/index.js"
      },
      "require": {
        "types": "./dist/cjs/transcription/index.d.ts",
        "default": "./dist/cjs/transcription/index.js"
      }
    },
    "./transcripts": {
      "import": {
        "types": "./dist/esm/transcripts/index.d.ts",
        "default": "./dist/esm/transcripts/index.js"
      },
      "require": {
        "types": "./dist/cjs/transcripts/index.d.ts",
        "default": "./dist/cjs/transcripts/index.js"
      }
    },
    "./search": {
      "import": {
        "types": "./dist/esm/search/index.d.ts",
        "default": "./dist/esm/search/index.js"
      },
      "require": {
        "types": "./dist/cjs/search/index.d.ts",
        "default": "./dist/cjs/search/index.js"
      }
    },
    "./notes": {
      "import": {
        "types": "./dist/esm/notes/index.d.ts",
        "default": "./dist/esm/notes/index.js"
      },
      "require": {
        "types": "./dist/cjs/notes/index.d.ts",
        "default": "./dist/cjs/notes/index.js"
      }
    },
    "./graph": {
      "import": {
        "types": "./dist/esm/graph/index.d.ts",
        "default": "./dist/esm/graph/index.js"
      },
      "require": {
        "types": "./dist/cjs/graph/index.d.ts",
        "default": "./dist/cjs/graph/index.js"
      }
    },
    "./ask": {
      "import": {
        "types": "./dist/esm/ask/index.d.ts",
        "default": "./dist/esm/ask/index.js"
      },
      "require": {
        "types": "./dist/cjs/ask/index.d.ts",
        "default": "./dist/cjs/ask/index.js"
      }
    },
    "./ontology": {
      "import": {
        "types": "./dist/esm/ontology/index.d.ts",
        "default": "./dist/esm/ontology/index.js"
      },
      "require": {
        "types": "./dist/cjs/ontology/index.d.ts",
        "default": "./dist/cjs/ontology/index.js"
      }
    },
    "./copilot": {
      "import": {
        "types": "./dist/esm/copilot/index.d.ts",
        "default": "./dist/esm/copilot/index.js"
      },
      "require": {
        "types": "./dist/cjs/copilot/index.d.ts",
        "default": "./dist/cjs/copilot/index.js"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/esm/errors/index.d.ts",
        "default": "./dist/esm/errors/index.js"
      },
      "require": {
        "types": "./dist/cjs/errors/index.d.ts",
        "default": "./dist/cjs/errors/index.js"
      }
    },
    "./brand": {
      "import": {
        "types": "./dist/esm/brand/index.d.ts",
        "default": "./dist/esm/brand/index.js"
      },
      "require": {
        "types": "./dist/cjs/brand/index.d.ts",
        "default": "./dist/cjs/brand/index.js"
      }
    },
    "./schemas/transcript-export.v1.json": "./schemas/transcript-export.v1.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/kvox-packages/copy-license.mjs",
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node ../../scripts/kvox-packages/write-dist-stubs.mjs",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc --options typedoc.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
