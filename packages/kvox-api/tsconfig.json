{
  // Typecheck and ts-jest. Decorator metadata is on because the slices that
  // arrive in Epic 6 are Nest providers; the build config repeats it.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node", "jest"]
  },
  "include": ["src", "test"],
  // The test host has its own config (`test/host/tsconfig.json`): its client is
  // generated by `npm run test:host:prepare` and does not exist on a bare checkout.
  "exclude": ["test/host/generated", "test/host/prisma", "test/host/db.ts", "**/*.db.spec.ts"]
}
