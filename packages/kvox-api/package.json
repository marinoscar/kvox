      "types": "./dist/graph-rdf/index.d.ts",
      "default": "./dist/graph-rdf/index.js"
    },
    "./graph-rdf/shacl-runner": {
      "types": "./dist/graph-rdf/shacl-runner/index.d.ts",
      "default": "./dist/graph-rdf/shacl-runner/index.js"
    },
    "./graph-rdf/testing": {
      "types": "./dist/graph-rdf/testing/index.d.ts",
      "default": "./dist/graph-rdf/testing/index.js"
    },
    "./ask": {
      "types": "./dist/ask/index.d.ts",
      "default": "./dist/ask/index.js"
    },
    "./ask/testing": {
      "types": "./dist/ask/testing/index.d.ts",
      "default": "./dist/ask/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "runners",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/kvox-packages/copy-license.mjs",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc --options typedoc.json",
    "test": "node test/jest.js -c test/jest.config.js --selectProjects unit",
    "test:run": "node test/jest.js -c test/jest.config.js --selectProjects unit --ci",
    "test:db": "node test/jest.js -c test/jest.config.js --selectProjects db --runInBand",
    "test:host:prepare": "node test/host/prepare.mjs"
  },
  "peerDependencies": {
