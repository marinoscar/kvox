{
  "name": "@marinoscar/kvox-api",
  "version": "0.0.0",
  "description": "The NestJS side of the KVox domain: host ports, in-memory fakes and, later, the domain slices (CommonJS).",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinoscar/kvox.git",
    "directory": "packages/kvox-api"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "default": "./dist/ports/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/kvox-packages/copy-license.mjs",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc --options typedoc.json",
    "test": "jest --config ./test/jest.config.js",
    "test:run": "jest --config ./test/jest.config.js --ci"
  },
  "peerDependencies": {
    "@marinoscar/kvox-contract": ">=0.0.0-0 || >=0.1.0-0",
    "@marinoscar/platform-api": "0.1.0-next.5",
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.5",
    "@prisma/client-runtime-utils": "^7.8.0",
    "nestjs-zod": "^5.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@marinoscar/platform-api": {
      "optional": true
    },
    "@nestjs/event-emitter": {
      "optional": true
    },
    "@nestjs/schedule": {
      "optional": true
    },
    "@nestjs/swagger": {
      "optional": true
    },
    "@prisma/client-runtime-utils": {
      "optional": true
    },
    "nestjs-zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.32",
    "jest": "^30.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
