{
  "name": "@marinoscar/kvox-api",
  "version": "0.1.0-next.0",
  "description": "The NestJS side of the KVox domain: host ports, in-memory fakes and, later, the domain slices (CommonJS).",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinoscar/kvox.git",
    "directory": "packages/kvox-api"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "default": "./dist/ports/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./transcription": {
      "types": "./dist/transcription/index.d.ts",
