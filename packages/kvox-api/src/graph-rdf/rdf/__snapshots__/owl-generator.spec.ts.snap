// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`generateOwl parses with n3 and matches the snapshot 1`] = `
"@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix kv: <https://fixture.app/ns#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kv:
    a owl:Ontology ;
    rdfs:label "<APP_NAME> ontology" ;
    owl:versionInfo "1.4.0" .

kv:ABOUT
    a owl:ObjectProperty ;
    rdfs:comment "The entity an item (a claim, decision, commitment or person fact) is about: its subject." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( kv:Claim kv:Commitment kv:Decision kv:PersonFact kv:Risk )
    ] ;
    rdfs:label "About" ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( kv:Interest kv:Meeting kv:Milestone kv:Opportunity kv:Organization kv:Person kv:Product kv:Project kv:Topic kv:Trip )
    ] .

kv:ASSIGNED_TO
    a owl:ObjectProperty ;
    rdfs:comment "The person who owns a commitment and is expected to carry it out." ;
    rdfs:domain kv:Commitment ;
    rdfs:label "Assigned to" ;
    rdfs:range kv:Person .

kv:ATTENDED
    a owl:ObjectProperty ;
    rdfs:comment "A person took part in a meeting, or was invited to or copied on it. Set attendance to invited for someone who was invited but not there, copied for someone who only received the material; when attendance is omitted the person attended." ;
    rdfs:domain kv:Person ;
    rdfs:label "Attended" ;
    rdfs:range kv:Meeting ;
    rdfs:subPropertyOf schema:attendee .

kv:ATTENDED.attendance
    a owl:DatatypeProperty ;
    rdfs:comment "Whether the person attended, was only invited, or was only copied; omitted means attended." ;
    rdfs:domain kv:Assertion ;
    rdfs:label "Attendance" ;
    rdfs:range xsd:string .

kv:Assertion
    a owl:Class ;
    rdfs:comment "A relation, reified: rdf:subject/rdf:predicate/rdf:object name the edge, prov:startedAtTime/prov:endedAtTime its validity range, and prov:wasDerivedFrom its citations." ;
    rdfs:label "Assertion" ;
    rdfs:subClassOf rdf:Statement .

kv:BROADER
    a owl:ObjectProperty ;
    rdfs:comment "A topic that is a narrower part of a broader theme: \\"licensing cost\\" BROADER \\"AI governance\\" rolls the narrower topic up into the theme." ;
    rdfs:domain kv:Topic ;
    rdfs:label "Broader" ;
    rdfs:range kv:Topic ;
    rdfs:subPropertyOf skos:broader .

kv:COMPETING_FOR
    a owl:ObjectProperty ;
    rdfs:comment "An organization is a rival bidder for an opportunity: \\"Org Gamma is also bidding on the Product X renewal\\" is Org Gamma COMPETING_FOR the renewal. Only when the source says the organization is bidding or in the running; the organization already pursuing it is PURSUED_BY." ;
    rdfs:domain kv:Organization ;
    rdfs:label "Competing for" ;
    rdfs:range kv:Opportunity .

kv:COMPETITOR_OF
    a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Two organizations compete in the same market: \\"Org Gamma and Org Beta compete on productivity suites\\". Direction does not matter: record it once. Only when the source says or clearly implies the organizations compete; two organizations merely mentioned together are not competitors." ;
    rdfs:domain kv:Organization ;
    rdfs:label "Competitor of" ;
    rdfs:range kv:Organization .

kv:CONCERNS
    a owl:ObjectProperty ;
    rdfs:comment "What a project or an opportunity is about: \\"The Product X rollout concerns Product X and licensing cost\\" gives the project CONCERNS the product and CONCERNS the topic. A meeting covering a subject is DISCUSSED; CONCERNS ties a project to its own subject matter. A project that adopts or runs a product is USES; use CONCERNS for the product the effort is about. An opportunity CONCERNS the product, topic or project it would deliver or extend." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( kv:Opportunity kv:Project )
    ] ;
    rdfs:label "Concerns" ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( kv:Product kv:Project kv:Topic )
    ] .

kv:CREATED_IN
    a owl:ObjectProperty ;
    rdfs:comment "The meeting in which a commitment was made." ;
    rdfs:domain kv:Commitment ;
    rdfs:label "Created in" ;
    rdfs:range kv:Meeting .

kv:CUSTOMER_OF
    a owl:ObjectProperty ;
    rdfs:comment "An organization buys from another organization: \\"Company A is an Org Beta customer\\" is Company A CUSTOMER_OF Org Beta. Direction matters: customer first, supplier second. Using a specific product is USES; CUSTOMER_OF is the commercial relationship between the two organizations. A partner, reseller or integrator is PARTNER_OF, not CUSTOMER_OF." ;
    rdfs:domain kv:Organization ;
    rdfs:label "Customer of" ;
    rdfs:range kv:Organization .

kv:Claim
    a owl:Class ;
    rdfs:comment "A dated statement of fact about an entity that is neither a decision nor a commitment, e.g. \\"the budget was cut 20%\\" or \\"the pilot moved to Q2\\"." ;
    rdfs:label "Claim" .

kv:Claim.claimKind
    a owl:DatatypeProperty ;
    rdfs:comment "What kind of statement it is, only if the source makes it clear; a plain statement of fact is fact." ;
    rdfs:domain kv:Claim ;
    rdfs:label "Kind" ;
    rdfs:range xsd:string .

kv:Claim.statement
    a owl:DatatypeProperty ;
    rdfs:comment "What the item states, in one sentence." ;
    rdfs:domain kv:Claim ;
    rdfs:label "Statement" ;
    rdfs:range xsd:string .

kv:Claim.unit
    a owl:DatatypeProperty ;
    rdfs:comment "The unit of the value (\\"percent\\", \\"weeks\\", \\"seats\\"), only if the source states it." ;
    rdfs:domain kv:Claim ;
    rdfs:label "Unit" ;
    rdfs:range xsd:string .

kv:Claim.value
    a owl:DatatypeProperty ;
    rdfs:comment "The figure the claim states, copied as written (\\"20%\\", \\"3 to 4 weeks\\", \\"120\\"), only for a metric." ;
    rdfs:domain kv:Claim ;
    rdfs:label "Value" ;
    rdfs:range xsd:string .

kv:Commitment
    a owl:Class ;
    rdfs:comment "A task with an owner and, optionally, a counterparty and a due date, stated or clearly implied by the source, e.g. \\"Sasha will send the updated proposal by Friday\\"." ;
    rdfs:label "Commitment" .

kv:Commitment.statement
    a owl:DatatypeProperty ;
    rdfs:comment "What the item states, in one sentence." ;
    rdfs:domain kv:Commitment ;
    rdfs:label "Statement" ;
    rdfs:range xsd:string .

kv:DECIDED_IN
    a owl:ObjectProperty ;
    rdfs:comment "The meeting in which a decision was made." ;
    rdfs:domain kv:Decision ;
    rdfs:label "Decided in" ;
    rdfs:range kv:Meeting .

kv:DISCUSSED
    a owl:ObjectProperty ;
    rdfs:comment "A meeting discussed a project, topic, product or organization as a substantive subject." ;
    rdfs:domain kv:Meeting ;
    rdfs:label "Discussed" ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( kv:Organization kv:Product kv:Project kv:Topic )
    ] .

kv:Decision
    a owl:Class ;
    rdfs:comment "A choice that was made: what was chosen and, when the source states it, the option that was rejected." ;
    rdfs:label "Decision" .

kv:Decision.rejectedOption
    a owl:DatatypeProperty ;
    rdfs:comment "The option that was considered and rejected, only if the source states it." ;
    rdfs:domain kv:Decision ;
    rdfs:label "Rejected option" ;
    rdfs:range xsd:string .

kv:Decision.statement
    a owl:DatatypeProperty ;
    rdfs:comment "What the item states, in one sentence." ;
    rdfs:domain kv:Decision ;
    rdfs:label "Statement" ;
    rdfs:range xsd:string .

kv:Document
    a owl:Class ;
    rdfs:comment "A document that was shown, shared or recorded in a meeting, e.g. a slide deck or a proposal; created by the system from the source, never proposed by extraction." ;
    rdfs:label "Document" ;
    rdfs:subClassOf schema:DigitalDocument .

kv:Document.classification
    a owl:DatatypeProperty ;
    rdfs:comment "The handling label the document carries, e.g. \\"internal\\" or \\"confidential\\", set by the system." ;
    rdfs:domain kv:Document ;
    rdfs:label "Classification" ;
    rdfs:range xsd:string .

kv:Document.preparedOn
    a owl:DatatypeProperty ;
    rdfs:comment "The date the document was prepared, set by the system." ;
    rdfs:domain kv:Document ;
    rdfs:label "Prepared on" ;
    rdfs:range xsd:date .

kv:Document.title
    a owl:DatatypeProperty ;
    rdfs:comment "The document's title, set by the system." ;
    rdfs:domain kv:Document ;
    rdfs:label "Title" ;
    rdfs:range xsd:string .

kv:FRIEND_OF
    a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Two people are personal friends, beyond working together. Direction does not matter: record it once." ;
    rdfs:domain kv:Person ;
    rdfs:label "Friend of" ;
    rdfs:range kv:Person ;
    rdfs:subPropertyOf foaf:knows .

kv:HAS_MILESTONE
    a owl:ObjectProperty ;
    rdfs:comment "A life event belongs to this person: it is their birthday, wedding, graduation or move." ;
    rdfs:domain kv:Person ;
    rdfs:label "Has milestone" ;
    rdfs:range kv:Milestone .

kv:HAS_ROLE
    a owl:ObjectProperty ;
    rdfs:comment "A person holds a titled role, optionally within a business unit, at an organization for a period of time: \\"Jonty, VP of Supply Chain at Org Beta\\" is Jonty HAS_ROLE Org Beta {title: \\"VP\\", businessUnit: \\"Supply Chain\\"}." ;
    rdfs:domain kv:Person ;
    rdfs:label "Has role" ;
    rdfs:range kv:Organization ;
    rdfs:subPropertyOf schema:hasOccupation .

kv:HAS_ROLE.businessUnit
    a owl:DatatypeProperty ;
    rdfs:comment "The business unit, division, practice or department within the organization this role sits in, e.g. \\"Supply Chain\\", only if the source states it." ;
    rdfs:domain kv:Assertion ;
    rdfs:label "Business unit" ;
    rdfs:range xsd:string .

kv:HAS_ROLE.title
    a owl:DatatypeProperty ;
    rdfs:comment "The job title the person holds in this role, e.g. \\"Staff Engineer\\"." ;
    rdfs:domain kv:Assertion ;
    rdfs:label "Role" ;
    rdfs:range xsd:string .

kv:INTERESTED_IN
    a owl:ObjectProperty ;
    rdfs:comment "A person has a lasting personal interest." ;
    rdfs:domain kv:Person ;
    rdfs:label "Interested in" ;
    rdfs:range kv:Interest ;
    rdfs:subPropertyOf foaf:topic_interest .

kv:INVOLVED_IN
    a owl:ObjectProperty ;
    rdfs:comment "A person has a stated role in a project or an opportunity, and optionally a stance toward it: \\"Jonty is the budget approver for the Product X rollout and is skeptical of it\\" is Jonty INVOLVED_IN Product X rollout {role: approver, stance: skeptical}. Assigned tasks are Commitments with ASSIGNED_TO; attending one meeting about a project is ATTENDED + DISCUSSED, not INVOLVED_IN unless the source states a role. Set role only to the role the source states or clearly implies; if no role is stated, do not create INVOLVED_IN. Set stance only when the source states it or the person's position is unmistakably implied (an explicit objection, endorsement or refusal). Never infer stance from tone, a single question, or silence; when in doubt, omit it." ;
    rdfs:domain kv:Person ;
    rdfs:label "Involved in" ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( kv:Opportunity kv:Project )
    ] .

kv:INVOLVED_IN.role
    a owl:DatatypeProperty ;
    rdfs:comment "The role the person plays in the project or opportunity, as the source states it. decision_maker signs off, influencer sways the decision without signing, evaluator assesses the options, account_lead owns the relationship with the client." ;
    rdfs:domain kv:Assertion ;
    rdfs:label "Role" ;
    rdfs:range xsd:string .

kv:INVOLVED_IN.stance
    a owl:DatatypeProperty ;
    rdfs:comment "The person's position toward the project, only when the source states it or it is unmistakably implied; never inferred from tone alone." ;
    rdfs:domain kv:Assertion ;
    rdfs:label "Stance" ;
    rdfs:range xsd:string .

kv:Interest
    a owl:Class ;
    rdfs:comment "A lasting personal interest a person has outside work — a hobby, a sport, music, food, travel or a cause — e.g. \\"trail running\\", \\"jazz piano\\" or \\"the local food bank\\"." ;
    rdfs:label "Interest" ;
    rdfs:subClassOf schema:Thing .

kv:Interest.category
    a owl:DatatypeProperty ;
    rdfs:comment "What kind of interest this is, only if it is clear from the source." ;
    rdfs:domain kv:Interest ;
    rdfs:label "Category" ;
    rdfs:range xsd:string .

kv:KNOWS_ABOUT
    a owl:ObjectProperty ;
    rdfs:comment "A person has expertise in a topic or product: \\"Maren is our expert on AI governance\\" is Maren KNOWS_ABOUT AI governance {level: expert}. Hobbies and lasting private interests are not KNOWS_ABOUT. Set level only when the source states it (\\"expert\\", \\"hands-on\\", \\"just heard of it\\"); attending a meeting about a topic does not make someone know about it." ;
    rdfs:domain kv:Person ;
    rdfs:label "Knows about" ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( kv:Product kv:Topic )
    ] ;
    rdfs:subPropertyOf schema:knowsAbout .

kv:KNOWS_ABOUT.level
    a owl:DatatypeProperty ;
    rdfs:comment "How deep the knowledge is, only if the source states it." ;
    rdfs:domain kv:Assertion ;
    rdfs:label "Level" ;
    rdfs:range xsd:string .

kv:Meeting
    a owl:Class ;
    rdfs:comment "The event anchor: a dated meeting or conversation, its attendees, and the transcript and/or note it was drawn from." ;
    rdfs:label "Meeting" ;
    rdfs:subClassOf schema:Event .

kv:Meeting.dateSource
    a owl:DatatypeProperty ;
    rdfs:comment "Where the meeting's date came from: stated in the source, or the note's creation date." ;
    rdfs:domain kv:Meeting ;
    rdfs:label "Date source" ;
    rdfs:range xsd:string .

kv:Meeting.meetingKind
    a owl:DatatypeProperty ;
    rdfs:comment "What kind of meeting it was, only if the source makes it clear." ;
    rdfs:domain kv:Meeting ;
    rdfs:label "Kind" ;
    rdfs:range xsd:string .

kv:Meeting.noteId
    a owl:DatatypeProperty ;
    rdfs:comment "The id of the note this meeting was drawn from, set by the system." ;
    rdfs:domain kv:Meeting ;
    rdfs:label "Note" ;
    rdfs:range xsd:string .

kv:Meeting.occurredOn
    a owl:DatatypeProperty ;
    rdfs:comment "The date the meeting took place, only if the source states it." ;
    rdfs:domain kv:Meeting ;
    rdfs:label "Occurred on" ;
    rdfs:range xsd:date .

kv:Meeting.topics
    a owl:DatatypeProperty ;
    rdfs:comment "Free-text subjects discussed in the meeting that are not Projects of their own." ;
    rdfs:domain kv:Meeting ;
    rdfs:label "Topics" ;
    rdfs:range xsd:string .

kv:Meeting.transcriptId
    a owl:DatatypeProperty ;
    rdfs:comment "The id of the transcript this meeting was drawn from, set by the system." ;
    rdfs:domain kv:Meeting ;
    rdfs:label "Transcript" ;
    rdfs:range xsd:string .

kv:Milestone
    a owl:Class ;
    rdfs:comment "A dated life event of one person — a birthday, an anniversary, a wedding, a birth, a graduation, a move or a retirement." ;
    rdfs:label "Milestone" ;
    rdfs:subClassOf schema:Event .

kv:Milestone.date
    a owl:DatatypeProperty ;
    rdfs:comment "The date of the event, if stated." ;
    rdfs:domain kv:Milestone ;
    rdfs:label "Date" ;
    rdfs:range xsd:date .

kv:Milestone.kind
    a owl:DatatypeProperty ;
    rdfs:comment "What kind of life event this is." ;
    rdfs:domain kv:Milestone ;
    rdfs:label "Kind" ;
    rdfs:range xsd:string .

kv:OFFERED_BY
    a owl:ObjectProperty ;
    rdfs:comment "The vendor of a product: \\"Product X is Org Beta's\\" is Product X OFFERED_BY Org Beta. A product has one current vendor; a change of vendor (an acquisition) is a new OFFERED_BY that closes the old one. A customer that merely uses the product is USES or CUSTOMER_OF, never OFFERED_BY." ;
    rdfs:domain kv:Product ;
    rdfs:label "Offered by" ;
    rdfs:range kv:Organization ;
    rdfs:subPropertyOf schema:manufacturer .

kv:ORGANIZED
    a owl:ObjectProperty ;
    rdfs:comment "A person convened or hosted a meeting: \\"Person A set up the review\\" is Person A ORGANIZED the review meeting. Only when the source says who called or hosted it; being present is ATTENDED, and the organizer also attended is recorded with a separate ATTENDED." ;
    rdfs:domain kv:Person ;
    rdfs:label "Organized" ;
    rdfs:range kv:Meeting ;
    rdfs:subPropertyOf schema:organizer .

kv:OWED_TO
    a owl:ObjectProperty ;
    rdfs:comment "The person or organization a commitment is owed to, when one is stated." ;
    rdfs:domain kv:Commitment ;
    rdfs:label "Owed to" ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( kv:Organization kv:Person )
    ] .

kv:Opportunity
    a owl:Class ;
    rdfs:comment "A potential piece of work or sale that is being pursued with a client and has not started yet, e.g. \\"the Org Alpha analytics engagement\\" or \\"the Product X renewal\\"." ;
    rdfs:label "Opportunity" ;
    rdfs:subClassOf schema:Offer .

kv:Opportunity.confidence
    a owl:DatatypeProperty ;
    rdfs:comment "How likely the speakers say the opportunity is to close, only if they say so." ;
    rdfs:domain kv:Opportunity ;
    rdfs:label "Confidence" ;
    rdfs:range xsd:string .

kv:Opportunity.stage
    a owl:DatatypeProperty ;
    rdfs:comment "How far the pursuit has gone, only if the source says so." ;
    rdfs:domain kv:Opportunity ;
    rdfs:label "Stage" ;
    rdfs:range xsd:string .

kv:Opportunity.timing
    a owl:DatatypeProperty ;
    rdfs:comment "When a decision or start is expected, as the source words it (\\"end of Q3\\", \\"after the budget review\\"), only if stated." ;
    rdfs:domain kv:Opportunity ;
    rdfs:label "Timing" ;
    rdfs:range xsd:string .

kv:Opportunity.valueText
    a owl:DatatypeProperty ;
    rdfs:comment "The expected value or size as the source words it (\\"around 200 thousand\\", \\"a multi-year deal\\"), only if stated." ;
    rdfs:domain kv:Opportunity ;
    rdfs:label "Value" ;
    rdfs:range xsd:string .

kv:Organization
    a owl:Class ;
    rdfs:comment "A company, client, vendor or institution, or an internal team specifically when that team acts as a party to a commitment or decision." ;
    rdfs:label "Organization" ;
    rdfs:subClassOf schema:Organization .

kv:PARENT_OF
    a owl:ObjectProperty ;
    rdfs:comment "A person is the parent of another person: from is the parent, to is the child." ;
    rdfs:domain kv:Person ;
    rdfs:label "Parent of" ;
    rdfs:range kv:Person ;
    rdfs:subPropertyOf schema:children .

kv:PARTNER_OF
    a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Two organizations are business partners (alliance, reseller, integrator): \\"Org Delta is Company A's partner\\". Direction does not matter: record it once. A buyer and supplier is CUSTOMER_OF; organizations that compete are COMPETITOR_OF." ;
    rdfs:domain kv:Organization ;
    rdfs:label "Partner of" ;
    rdfs:range kv:Organization .

kv:PART_OF
    a owl:ObjectProperty ;
    rdfs:comment "A project belongs to an organization, a meeting belongs to a project, a topic is scoped under a project, or an organization is a sub-unit of a larger one (\\"the data team at Org Alpha\\" is part of Org Alpha). An organization is never PART_OF itself." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( kv:Meeting kv:Organization kv:Project kv:Topic )
    ] ;
    rdfs:label "Part of" ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( kv:Organization kv:Project )
    ] .

kv:PREPARED_FOR
    a owl:ObjectProperty ;
    rdfs:comment "The person a document was prepared for, written by the system." ;
    rdfs:domain kv:Document ;
    rdfs:label "Prepared for" ;
    rdfs:range kv:Person .

kv:PURSUED_BY
    a owl:ObjectProperty ;
    rdfs:comment "The organization that is going after an opportunity: \\"Org Beta is pursuing the Product X renewal\\" is the renewal PURSUED_BY Org Beta. Several organizations may pursue one together; a rival bidding for it is COMPETING_FOR, not PURSUED_BY." ;
    rdfs:domain kv:Opportunity ;
    rdfs:label "Pursued by" ;
    rdfs:range kv:Organization .

kv:Person
    a owl:Class ;
    rdfs:comment "A human being: one specific, individual person named or unambiguously identified in the source." ;
    rdfs:label "Person" ;
    rdfs:subClassOf schema:Person .

kv:PersonFact
    a owl:Class ;
    rdfs:comment "A statement about a Person as an individual rather than about their work: an interest, a preference, a personal-life detail, or their communication style." ;
    rdfs:label "Person fact" .

kv:PersonFact.statement
    a owl:DatatypeProperty ;
    rdfs:comment "What the item states, in one sentence." ;
    rdfs:domain kv:PersonFact ;
    rdfs:label "Statement" ;
    rdfs:range xsd:string .

kv:Product
    a owl:Class ;
    rdfs:comment "A named product, service, tool, platform or technology that organizations offer, adopt or evaluate, e.g. \\"Product X\\", \\"Product Y\\", \\"Product Z\\"." ;
    rdfs:label "Product" ;
    rdfs:subClassOf schema:Product .

kv:Product.category
    a owl:DatatypeProperty ;
    rdfs:comment "What kind of product this is, only if the source says so." ;
    rdfs:domain kv:Product ;
    rdfs:label "Category" ;
    rdfs:range xsd:string .

kv:Product.vendorName
    a owl:DatatypeProperty ;
    rdfs:comment "The name of the vendor that offers the product, only if the source states it. A resolution hint, not a link." ;
    rdfs:domain kv:Product ;
    rdfs:label "Vendor" ;
    rdfs:range xsd:string .

kv:Project
    a owl:Class ;
    rdfs:comment "A named effort with a start and an expected (even if fuzzy) end that meetings, decisions and commitments attach to, e.g. \\"Q2 pilot\\" or \\"the vendor migration\\"." ;
    rdfs:label "Project" ;
    rdfs:subClassOf schema:Project .

kv:Project.endDate
    a owl:DatatypeProperty ;
    rdfs:comment "The date the project ended or is expected to end, if stated." ;
    rdfs:domain kv:Project ;
    rdfs:label "End date" ;
    rdfs:range xsd:date .

kv:Project.startDate
    a owl:DatatypeProperty ;
    rdfs:comment "The date the project started or is planned to start, if stated." ;
    rdfs:domain kv:Project ;
    rdfs:label "Start date" ;
    rdfs:range xsd:date .

kv:Project.status
    a owl:DatatypeProperty ;
    rdfs:comment "Where the project stands, only if the source says so." ;
    rdfs:domain kv:Project ;
    rdfs:label "Status" ;
    rdfs:range xsd:string .

kv:RECORDED_IN
    a owl:ObjectProperty ;
    rdfs:comment "The document in which a meeting was recorded (minutes, a deck, a briefing), written by the system." ;
    rdfs:domain kv:Meeting ;
    rdfs:label "Recorded in" ;
    rdfs:range kv:Document .

kv:REPORTS_TO
    a owl:ObjectProperty ;
    rdfs:comment "A person reports to another person, their manager, for a period of time." ;
    rdfs:domain kv:Person ;
    rdfs:label "Reports to" ;
    rdfs:range kv:Person .

kv:Risk
    a owl:Class ;
    rdfs:comment "A risk, issue or blocker that someone raised about a project, product or organization, e.g. \\"licence budget not approved could delay the rollout\\"." ;
    rdfs:label "Risk" .

kv:Risk.mitigation
    a owl:DatatypeProperty ;
    rdfs:comment "What was said about reducing or removing the risk, only if the source states it." ;
    rdfs:domain kv:Risk ;
    rdfs:label "Mitigation" ;
    rdfs:range xsd:string .

kv:Risk.riskKind
    a owl:DatatypeProperty ;
    rdfs:comment "Whether it is a possible future problem (risk), a problem that is already happening (issue) or something that stops work now (blocker)." ;
    rdfs:domain kv:Risk ;
    rdfs:label "Kind" ;
    rdfs:range xsd:string .

kv:Risk.severity
    a owl:DatatypeProperty ;
    rdfs:comment "How serious the source makes the risk sound, only if it says so." ;
    rdfs:domain kv:Risk ;
    rdfs:label "Severity" ;
    rdfs:range xsd:string .

kv:Risk.statement
    a owl:DatatypeProperty ;
    rdfs:comment "What the item states, in one sentence." ;
    rdfs:domain kv:Risk ;
    rdfs:label "Statement" ;
    rdfs:range xsd:string .

kv:SPOUSE_OF
    a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Two people are married to, or the life partners of, each other. Direction does not matter: record it once." ;
    rdfs:domain kv:Person ;
    rdfs:label "Spouse of" ;
    rdfs:range kv:Person ;
    rdfs:subPropertyOf schema:spouse .

kv:SUPERSEDES
    a owl:ObjectProperty ;
    rdfs:comment "A newer decision, claim or commitment that replaces an older one of the same type." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( kv:Claim kv:Commitment kv:Decision kv:Risk )
    ] ;
    rdfs:label "Supersedes" ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( kv:Claim kv:Commitment kv:Decision kv:Risk )
    ] ;
    rdfs:subPropertyOf prov:wasRevisionOf .

kv:TRAVELED_ON
    a owl:ObjectProperty ;
    rdfs:comment "A person went, or is going, on a personal trip." ;
    rdfs:domain kv:Person ;
    rdfs:label "Traveled on" ;
    rdfs:range kv:Trip .

kv:Topic
    a owl:Class ;
    rdfs:comment "A recurring subject of discussion that is not itself a unit of work, e.g. \\"AI governance\\", \\"licensing cost\\", \\"change management\\"." ;
    rdfs:label "Topic" ;
    rdfs:subClassOf skos:Concept .

kv:Topic.summary
    a owl:DatatypeProperty ;
    rdfs:comment "A short summary of the topic, written by the user." ;
    rdfs:domain kv:Topic ;
    rdfs:label "Summary" ;
    rdfs:range xsd:string .

kv:Trip
    a owl:Class ;
    rdfs:comment "A specific personal journey with a destination and rough dates, e.g. \\"the family trip to Lisbon in June\\"." ;
    rdfs:label "Trip" ;
    rdfs:subClassOf schema:Trip .

kv:Trip.destination
    a owl:DatatypeProperty ;
    rdfs:comment "Where the trip goes, as the source names it." ;
    rdfs:domain kv:Trip ;
    rdfs:label "Destination" ;
    rdfs:range xsd:string .

kv:Trip.endDate
    a owl:DatatypeProperty ;
    rdfs:comment "The date the trip ends or ended, if stated." ;
    rdfs:domain kv:Trip ;
    rdfs:label "End date" ;
    rdfs:range xsd:date .

kv:Trip.startDate
    a owl:DatatypeProperty ;
    rdfs:comment "The date the trip starts or started, if stated." ;
    rdfs:domain kv:Trip ;
    rdfs:label "Start date" ;
    rdfs:range xsd:date .

kv:USES
    a owl:ObjectProperty ;
    rdfs:comment "An organization or a project adopts, evaluates or runs a product, at a stage: \\"Company A is piloting Product X\\" is Company A USES Product X {stage: piloting}. A move to a later stage (piloting to adopted) is a new USES with the new stage, which closes the earlier one; never edit the old stage. The vendor of the product is OFFERED_BY, not USES; a project about a product without adopting it is CONCERNS. Set stage only when the source states it; \\"evaluating\\" is for a stated assessment, not for a passing mention." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( kv:Organization kv:Project )
    ] ;
    rdfs:label "Uses" ;
    rdfs:range kv:Product .

kv:USES.scale
    a owl:DatatypeProperty ;
    rdfs:comment "How widely the product is used, as the source words it (\\"120 seats\\", \\"two business units\\"), only if stated." ;
    rdfs:domain kv:Assertion ;
    rdfs:label "Scale" ;
    rdfs:range xsd:string .

kv:USES.stage
    a owl:DatatypeProperty ;
    rdfs:comment "How far the adoption has gone, only if the source states it." ;
    rdfs:domain kv:Assertion ;
    rdfs:label "Stage" ;
    rdfs:range xsd:string .

kv:WITH_CLIENT
    a owl:ObjectProperty ;
    rdfs:comment "The client an opportunity is being pursued with: \\"the Product X renewal with Org Alpha\\" is the renewal WITH_CLIENT Org Alpha. An opportunity has one current client; the vendor side that pursues it is PURSUED_BY." ;
    rdfs:domain kv:Opportunity ;
    rdfs:label "With client" ;
    rdfs:range kv:Organization .

kv:WORKS_FOR
    a owl:ObjectProperty ;
    rdfs:comment "A person is employed by, or works on behalf of, an organization — the one way a person's employer is recorded: \\"Jonty works for Org Beta\\" is Jonty WORKS_FOR Org Beta (an Organization); his role and business unit there are a HAS_ROLE to the same Organization." ;
    rdfs:domain kv:Person ;
    rdfs:label "Works for" ;
    rdfs:range kv:Organization ;
    rdfs:subPropertyOf schema:worksFor .

<https://fixture.app/ns#attr/11111111-1111-4111-8111-111111111111>
    a owl:DatatypeProperty ;
    rdfs:domain kv:Organization ;
    rdfs:label "Tier" ;
    rdfs:range xsd:string .

<https://fixture.app/ns#attr/22222222-2222-4222-8222-222222222222>
    a owl:DatatypeProperty ;
    rdfs:domain kv:Person ;
    rdfs:label "Old nickname" ;
    rdfs:range xsd:string ;
    owl:deprecated true .

kv:confidence
    a owl:AnnotationProperty ;
    rdfs:comment "The extraction confidence recorded for a graph row, between 0 and 1." ;
    rdfs:label "Confidence" .

kv:dueAt
    a owl:DatatypeProperty ;
    rdfs:comment "When an item, typically a commitment, is due." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( kv:Claim kv:Commitment kv:Decision kv:PersonFact kv:Risk )
    ] ;
    rdfs:label "Due at" ;
    rdfs:range xsd:dateTime .

kv:occurredAt
    a owl:DatatypeProperty ;
    rdfs:comment "When a meeting or an item happened." ;
    rdfs:label "Occurred at" ;
    rdfs:range xsd:dateTime .

kv:ontologyVersion
    a owl:AnnotationProperty ;
    rdfs:comment "The ontology version a graph row was written against." ;
    rdfs:label "Ontology version" .

kv:reviewStatus
    a owl:AnnotationProperty ;
    rdfs:comment "Where a graph row stands in the review lifecycle (accepted or edited, for anything exported)." ;
    rdfs:label "Review status" .

kv:status
    a owl:DatatypeProperty ;
    rdfs:comment "An item's lifecycle status: one of the statuses its type declares." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( kv:Claim kv:Commitment kv:Decision kv:PersonFact kv:Risk )
    ] ;
    rdfs:label "Status" ;
    rdfs:range xsd:string .

kv:validPrecision
    a owl:AnnotationProperty ;
    rdfs:comment "How exact the source was about a validity range: day, month, year or unknown." ;
    rdfs:label "Valid precision" .

schema:jobTitle
    a owl:DatatypeProperty ;
    rdfs:comment "The person's job title, only if the source states it." ;
    rdfs:label "Job title" ;
    owl:deprecated true ;
    schema:domainIncludes kv:Person ;
    schema:rangeIncludes xsd:string .

schema:url
    a owl:DatatypeProperty ;
    rdfs:comment "The organization's website address, only if the source states it explicitly." ;
    rdfs:label "Website" ;
    schema:domainIncludes kv:Organization ;
    schema:rangeIncludes xsd:anyURI .
"
`;
