{
  "$schema": "https://typedoc.org/schema.json",
  "extends": ["../../typedoc.base.json"],
  "tsconfig": "./tsconfig.json",
  "entryPoints": ["./src/index.ts", "./src/testing/index.ts", "./src/copilot/index.ts", "./src/local-embeddings/index.ts"],
  "entryPointStrategy": "resolve",
  "name": "@marinoscar/kvox-ai",
  "out": "./docs-api/html",
  "json": "./docs-api/api.json",
  // The anonymous properties TypeDoc expands out of the two exported Zod schemas
  // of `src/tasks/ai-task-keys.ts` (the enum members and the task keys of a
  // `z.partialRecord`), which no TSDoc comment can reach. Their meaning is on the
  // schemas' own TSDoc and on `AiTaskModel` / `AiTaskModels`. Everything else,
  // every interface property included, is documented (unlike kvox-contract, the
  // package keeps "Property" in `requiredToBeDocumented`).
  "intentionallyNotDocumented": [
    "index.aiTaskModelSchema.__type.reasoningEffort.__type.low",
    "index.aiTaskModelSchema.__type.reasoningEffort.__type.medium",
    "index.aiTaskModelSchema.__type.reasoningEffort.__type.high",
    "index.aiTaskModelsSchema.__type.graph.extract",
    "index.aiTaskModelsSchema.__type.graph.adjudicate",
    "index.aiTaskModelsSchema.__type.graph.digest",
    "index.aiTaskModelsSchema.__type.graph.agent",
    "index.aiTaskModelsSchema.__type.reasoningEffort.__type.low",
    "index.aiTaskModelsSchema.__type.reasoningEffort.__type.medium",
    "index.aiTaskModelsSchema.__type.reasoningEffort.__type.high"
  ]
}
