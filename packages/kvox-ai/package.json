{
  "name": "@marinoscar/kvox-ai",
  "version": "0.1.0-next.3",
  "description": "The host-neutral KVox model mechanics: strict structured output, chat and tool-call mapping, task-to-model choice, token estimates and the embedding catalog, over a host-supplied runtime (CommonJS).",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinoscar/kvox.git",
    "directory": "packages/kvox-ai"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./copilot": {
      "types": "./dist/copilot/index.d.ts",
      "default": "./dist/copilot/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/kvox-packages/copy-license.mjs",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc --options typedoc.json",
    "test": "jest -c test/jest.config.js",
    "test:run": "jest -c test/jest.config.js --ci"
  },
  "peerDependencies": {
    "@github/copilot-sdk": "^1.0.22",
    "@marinoscar/kvox-api": ">=0.0.0-0 || >=0.1.0-0",
    "@marinoscar/platform-ai-providers": "0.1.0-next.7",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@github/copilot-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marinoscar/kvox-api": "0.1.0-next.3",
    "@marinoscar/platform-ai-providers": "0.1.0-next.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.32",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
