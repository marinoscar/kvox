{
  "$comment": "Peer dependencies per slice of @marinoscar/kvox-* (Epic 5). Append-only: Epic 6 and Epic 7 add slices, never rename or remove one. A slice lists every package its own files import (besides Node built-ins and relative paths); it also needs what the slices it depends on (packages/kvox-slices.json) need. Enforced by scripts/kvox-packages/check-slice-peers.mjs; the rules are in docs/PACKAGES.md#peer-dependencies-per-slice.",
  "$universal": {
    "kvox-api": ["ports", "core"],
    "kvox-web": ["core"],
    "kvox-contract": "*",
    "kvox-db": ["bin"]
  },
  "$implies": {
    "@mui/icons-material": ["@mui/material"],
    "@mui/material": ["react", "react-dom"],
    "@nestjs/core": ["@nestjs/common", "reflect-metadata", "rxjs"],
    "@nestjs/event-emitter": ["@nestjs/common"],
    "@nestjs/schedule": ["@nestjs/common"],
    "@nestjs/swagger": ["@nestjs/common"],
    "nestjs-zod": ["@nestjs/common", "zod"],
    "react-dom": ["react"],
    "react-router-dom": ["react", "react-dom"],
    "@testing-library/react": ["react", "react-dom"]
  },
  "$reserved": {
    "kvox-api": [
      "@nestjs/event-emitter",
      "@nestjs/schedule",
      "@prisma/client-runtime-utils"
    ],
    "kvox-web": []
  },
  "$hostOnly": {
    "kvox-api": ["@marinoscar/platform-api"],
    "kvox-web": ["@marinoscar/platform-web"]
  },
  "kvox-api": {
    "ports": {
      "peers": ["@marinoscar/kvox-contract", "@nestjs/common", "rxjs", "zod"]
    },
    "core": {
      "peers": [
        "@marinoscar/kvox-contract",
        "@nestjs/common",
        "@nestjs/core",
        "reflect-metadata",
        "rxjs",
        "zod"
      ]
    },
    "testing": {
      "peers": ["@marinoscar/kvox-contract", "rxjs", "zod"]
    },
    "transcription": {
      "peers": [
        "@marinoscar/kvox-contract",
        "@nestjs/common",
        "@nestjs/core",
        "@nestjs/swagger",
        "nestjs-zod",
        "zod"
      ]
    },
    "search": {
      "peers": [
        "@marinoscar/kvox-contract",
        "@nestjs/common",
        "@nestjs/core",
        "@nestjs/swagger",
        "nestjs-zod",
        "zod"
      ]
    },
    "transcripts": {
      "peers": [
        "@marinoscar/kvox-contract",
        "@nestjs/common",
        "@nestjs/core",
        "@nestjs/schedule",
        "@nestjs/swagger",
        "fastify",
        "nestjs-zod",
        "pdfkit",
        "zod"
      ]
    },
    "notes": {
      "peers": [
        "@marinoscar/kvox-contract",
        "@nestjs/common",
        "@nestjs/core",
        "@nestjs/schedule",
        "@nestjs/swagger",
        "docx",
        "fastify",
        "nestjs-zod",
        "pdfkit",
        "rxjs",
        "unpdf",
        "zod"
      ]
    },
    "graph": {
      "peers": [
        "@marinoscar/kvox-contract",
        "@nestjs/common",
        "@nestjs/core",
        "@nestjs/schedule",
        "@nestjs/swagger",
        "graphology",
        "graphology-communities-louvain",
        "graphology-layout",
        "graphology-layout-forceatlas2",
        "nestjs-zod",
        "zod"
      ]
    },
    "graph-extraction": {
      "peers": [
        "@marinoscar/kvox-contract",
        "@nestjs/common",
        "@nestjs/core",
        "@nestjs/swagger",
        "nestjs-zod",
        "zod"
      ]
    },
    "graph-rdf": {
      "peers": [
        "@marinoscar/kvox-contract",
        "@nestjs/common",
        "@nestjs/core",
        "@nestjs/schedule",
        "@nestjs/swagger",
        "fastify",
        "jsonld",
        "n3",
        "nestjs-zod",
        "rdf-validate-shacl",
        "zod"
      ]
    },
    "ask": {
      "peers": [
        "@marinoscar/kvox-contract",
        "@nestjs/common",
        "@nestjs/core",
        "@nestjs/swagger",
        "nestjs-zod",
        "rxjs",
        "zod"
      ]
    }
  },
  "kvox-web": {
    "core": {
      "peers": ["@marinoscar/kvox-contract", "react", "react-dom"],
      "entries": {
        "ui": ["@mui/icons-material", "@mui/material", "react-router-dom"],
        "testing": ["@mui/material", "@testing-library/react", "react-router-dom"]
      }
    },
    "transcription": {
      "peers": ["@marinoscar/kvox-contract", "react", "react-dom"],
      "entries": {
        "ui": ["@mui/icons-material", "@mui/material", "react-router-dom"]
      }
    },
    "search": {
      "peers": ["@marinoscar/kvox-contract", "react", "react-dom"],
      "entries": {
        "ui": ["@mui/icons-material", "@mui/material", "react-router-dom"]
      }
    },
    "transcripts": {
      "peers": ["@marinoscar/kvox-contract", "react", "react-dom"],
      "entries": {
        "ui": [
          "@mui/icons-material",
          "@mui/material",
          "@tanstack/react-virtual",
          "react-router-dom"
        ]
      }
    },
    "notes": {
      "peers": ["@marinoscar/kvox-contract", "react", "react-dom"],
      "entries": {
        "ui": [
          "@mui/icons-material",
          "@mui/material",
          "@tiptap/core",
          "@tiptap/extension-table",
          "@tiptap/markdown",
          "@tiptap/pm",
          "@tiptap/react",
          "@tiptap/starter-kit",
          "react-markdown",
          "react-router-dom",
          "remark-gfm"
        ]
      }
    },
    "graph": {
      "peers": ["@marinoscar/kvox-contract", "react", "react-dom"],
      "entries": {
        "ui": [
          "@mui/icons-material",
          "@mui/material",
          "@react-sigma/core",
          "graphology",
          "graphology-layout-forceatlas2",
          "react-router-dom",
          "sigma"
        ]
      }
    }
  },
  "kvox-contract": {
    "errors": { "peers": ["zod"] },
    "ontology": { "peers": ["zod"] },
    "transcription": { "peers": ["zod"] },
    "transcripts": { "peers": ["zod"] },
    "search": { "peers": ["zod"] },
    "notes": { "peers": ["zod"] },
    "graph": { "peers": ["zod"] },
    "ask": { "peers": ["zod"] }
  },
  "kvox-db": {
    "bin": { "peers": ["prisma"] },
    "check": { "peers": [] },
    "lock": { "peers": [] },
    "manifest": { "peers": [] },
    "promote": { "peers": [] },
    "sql": { "peers": [] },
    "sync": { "peers": [] }
  }
}
