      "entries": {
        "ui": [
          "@mui/icons-material",
          "@mui/material",
          "@react-sigma/core",
          "graphology",
          "graphology-layout-forceatlas2",
          "react-router-dom",
          "sigma"
        ]
      }
    },
    "ask": {
      "peers": ["@marinoscar/kvox-contract", "react", "react-dom"],
      "entries": {
        "ui": ["@mui/icons-material", "@mui/material", "react-markdown", "react-router-dom"]
      }
    },
    "brand": { "peers": ["@marinoscar/platform-web", "@mui/material", "react"] },
    "copilot": {
      "peers": ["@marinoscar/kvox-contract", "react", "react-dom"],
      "entries": {
        "ui": ["@marinoscar/platform-web", "@mui/material"]
      }
    },
    "shell": {
      "peers": ["@marinoscar/platform-web", "@mui/icons-material", "@mui/material", "react", "react-router-dom"]
    },
    "home": {
      "peers": ["@marinoscar/kvox-contract", "react", "react-dom"],
      "entries": {
        "ui": ["@mui/icons-material", "@mui/material", "react-router-dom"]
      }
    }
  },
  "kvox-contract": {
    "errors": { "peers": ["zod"] },
    "ontology": { "peers": ["zod"] },
    "transcription": { "peers": ["zod"] },
    "transcripts": { "peers": ["zod"] },
    "search": { "peers": ["zod"] },
    "notes": { "peers": ["zod"] },
    "graph": { "peers": ["zod"] },
    "ask": { "peers": ["zod"] },
    "copilot": { "peers": ["zod"] }
  },
  "kvox-db": {
    "bin": { "peers": ["prisma"] },
    "check": { "peers": [] },
    "lock": { "peers": [] },
    "manifest": { "peers": [] },
    "promote": { "peers": [] },
    "sql": { "peers": [] },
    "sync": { "peers": [] }
  },
  "kvox-ai": {
