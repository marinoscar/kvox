    "features": { "peers": [] },
    "types": { "peers": [] },
    "tokens": { "peers": [] },
    "structured": { "peers": ["zod"] },
    "chat": { "peers": ["@marinoscar/platform-ai-providers", "zod"] },
    "embedding": { "peers": [] },
    "runtime": { "peers": ["@marinoscar/platform-ai-providers"] },
    "errors": { "peers": ["@marinoscar/kvox-api", "@marinoscar/platform-ai-providers", "zod"] },
    "testing": { "peers": ["@marinoscar/kvox-api", "@marinoscar/platform-ai-providers", "zod"] },
    "port": { "peers": ["@marinoscar/kvox-api", "@marinoscar/platform-ai-providers", "zod"] },
    "direct": { "peers": ["@marinoscar/kvox-api", "@marinoscar/platform-ai-providers"] },
    "routing": { "peers": [] },
