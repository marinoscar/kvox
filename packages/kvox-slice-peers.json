    "fixtures": { "peers": ["@marinoscar/kvox-contract", "zod"] },
    "real-data": { "peers": [] },
    "live": { "peers": ["@marinoscar/kvox-ai", "@marinoscar/kvox-api", "@marinoscar/platform-ai-providers", "openai"] },
    "kg": { "peers": ["@marinoscar/kvox-api", "@marinoscar/kvox-contract", "zod"] },
    "parity": {
      "peers": ["@marinoscar/kvox-ai", "@marinoscar/kvox-api", "@marinoscar/kvox-contract", "@marinoscar/platform-ai-providers"]
